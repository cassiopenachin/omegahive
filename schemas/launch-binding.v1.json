{
  "$id": "https://omegahive.invalid/schemas/launch-binding.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The signed decision, committed in the workspace.\n\nNote what is NOT here: any execution detail. The binding selects; the catalog\ndescribes; the adapter executes.",
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "order_ref": {
      "title": "Order Ref",
      "type": "string"
    },
    "predicted_total_tokens": {
      "minimum": 0,
      "title": "Predicted Total Tokens",
      "type": "integer"
    },
    "purpose": {
      "default": "work",
      "enum": [
        "work",
        "review"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "route": {
      "title": "Route",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "task": {
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task",
    "order_ref",
    "route",
    "predicted_total_tokens"
  ],
  "title": "LaunchBinding",
  "type": "object"
}
