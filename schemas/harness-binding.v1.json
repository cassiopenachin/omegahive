{
  "$defs": {
    "BindingVerification": {
      "additionalProperties": false,
      "description": "Evidence that the harness probes were actually run, and where to read it.",
      "properties": {
        "deployment": {
          "title": "Deployment",
          "type": "string"
        },
        "harness_version": {
          "title": "Harness Version",
          "type": "string"
        },
        "ran_at": {
          "title": "Ran At",
          "type": "string"
        },
        "probe_record": {
          "title": "Probe Record",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "config_digest": {
          "title": "Config Digest",
          "type": "string"
        }
      },
      "required": [
        "deployment",
        "harness_version",
        "ran_at",
        "probe_record",
        "outcome",
        "config_digest"
      ],
      "title": "BindingVerification",
      "type": "object"
    },
    "ClassBinding": {
      "additionalProperties": false,
      "description": "How one policy class binds on one harness.",
      "properties": {
        "policy_class": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "title": "Policy Class",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "mechanisms": {
          "items": {
            "$ref": "#/$defs/Mechanism"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/Probe"
          },
          "title": "Probes",
          "type": "array"
        },
        "residual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        }
      },
      "required": [
        "policy_class",
        "title"
      ],
      "title": "ClassBinding",
      "type": "object"
    },
    "Mechanism": {
      "additionalProperties": false,
      "description": "One native control, named by kind so its enforceability is a fact not a claim.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "Mechanism",
      "type": "object"
    },
    "Probe": {
      "additionalProperties": false,
      "description": "One focused check with a stated expectation.\n\nA probe that cannot fail proves nothing, so every probe names both what it does\nand what outcome counts as bound.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "sentinel_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentinel Name"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "expect_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expect Output"
        },
        "expect": {
          "enum": [
            "denied",
            "executed",
            "absent",
            "present"
          ],
          "title": "Expect",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "kind",
        "expect"
      ],
      "title": "Probe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The versioned, source-controlled descriptor for one launchable harness.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "binding_id": {
      "title": "Binding Id",
      "type": "string"
    },
    "harness": {
      "title": "Harness",
      "type": "string"
    },
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "config_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Config Path"
    },
    "config_format": {
      "enum": [
        "claude-code-settings",
        "codex-toml",
        "none"
      ],
      "title": "Config Format",
      "type": "string"
    },
    "required_flags": {
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Required Flags",
      "type": "array"
    },
    "command_mode_flag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Mode Flag"
    },
    "forbidden_argv_tokens": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Argv Tokens",
      "type": "array"
    },
    "known_command_modes": {
      "items": {
        "type": "string"
      },
      "title": "Known Command Modes",
      "type": "array"
    },
    "safe_command_modes": {
      "items": {
        "type": "string"
      },
      "title": "Safe Command Modes",
      "type": "array"
    },
    "classes": {
      "items": {
        "$ref": "#/$defs/ClassBinding"
      },
      "title": "Classes",
      "type": "array"
    },
    "status": {
      "enum": [
        "proven",
        "declared"
      ],
      "title": "Status",
      "type": "string"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/BindingVerification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "harness",
    "captured_at",
    "config_path",
    "config_format",
    "status"
  ],
  "title": "HarnessBinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegahive.invalid/schemas/harness-binding.v1.json"
}
