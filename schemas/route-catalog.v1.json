{
  "$defs": {
    "PriceBasis": {
      "additionalProperties": false,
      "description": "The route's list-price basis, copied from the catalog AT APPROVAL TIME.\n\nCarried on the facts, not looked up later, because the catalog is a mutable\ndeployment file: a reader deriving the cost of a 2026-08 execution from the 2027-02\ncatalog would silently compute a number that was never true. Cost is derived from\nthese numbers, never authored \u2014 no payload here holds a currency amount.\n\nAll four rates are optional: a subscription route has no per-token list price, and\nan absent rate must stay absent rather than become a zero that reads as free.",
      "properties": {
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "per_mtok_cache_read": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Mtok Cache Read"
        },
        "per_mtok_cache_write": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Mtok Cache Write"
        },
        "per_mtok_input": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Mtok Input"
        },
        "per_mtok_output": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Mtok Output"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "captured_at"
      ],
      "title": "PriceBasis",
      "type": "object"
    },
    "RouteEntry": {
      "additionalProperties": false,
      "description": "One thing this deployment can currently run.",
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "billing_market": {
          "enum": [
            "subscription",
            "api"
          ],
          "title": "Billing Market",
          "type": "string"
        },
        "credential_pool": {
          "title": "Credential Pool",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "harness": {
          "title": "Harness",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_vendor": {
          "title": "Model Vendor",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "price_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_vendor",
        "provider",
        "model",
        "harness",
        "billing_market",
        "credential_pool",
        "adapter"
      ],
      "title": "RouteEntry",
      "type": "object"
    }
  },
  "$id": "https://omegahive.invalid/schemas/route-catalog.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The deployment's route list.\n\n`routes` is a LIST, not a name-keyed object, on purpose: a JSON object with a\nrepeated key is collapsed silently by every parser we use, so a hand-edited catalog\nholding the same route name twice would resolve to whichever copy happened to win.\nA list makes the duplicate visible, and `resolve_route` refuses it as ambiguous.",
  "properties": {
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/RouteEntry"
      },
      "title": "Routes",
      "type": "array"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "captured_at"
  ],
  "title": "RouteCatalog",
  "type": "object"
}
