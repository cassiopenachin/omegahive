# Copy to .env before `docker compose up`. Secrets live only here (deployment spec §4).
# Hosts are the compose service name `postgres` (containers talk over the compose network).
OMEGAHIVE_DATABASE_URL=postgresql://omegahive:omegahive@postgres:5432/omegahive
# The test *base* DSN: server and credentials. Each
# test run creates and drops a database of its own on this server rather than sharing the
# one named here, so concurrent suites cannot collide (README "Tests", tests/scratch_db.py).
OMEGAHIVE_TEST_DATABASE_URL=postgresql://omegahive:omegahive@postgres:5432/omegahive_test
# The acceptance run id (seed, actors, and board-view must share it).
OMEGAHIVE_RUN_ID=accept

# The active view, shared by the CLI and the web UI so the two never disagree about what
# is on the board. OMEGAHIVE_ACTIVE_WINDOW_DAYS is how long closed work stays on screen,
# and how long a quiet run stays in the portfolio. OMEGAHIVE_PORTFOLIO_EXCLUDE is a
# comma-separated glob list of run ids that are never portfolio projects (the drill seeds
# real, freshly-active runs on this same spine every time it runs); set it to the empty
# string to exclude nothing. Both are display cuts — `board-view <run> --json` is always
# the run's full history, because the operator tooling looks tasks up in it.
OMEGAHIVE_ACTIVE_WINDOW_DAYS=7
OMEGAHIVE_PORTFOLIO_EXCLUDE=tooling-drill-*

# Secrets pointer (deployment spec §4). The per-service env-files (notifier.env, …) live
# in a per-host directory OUTSIDE the repo tree, mode 0700, files 0600 — never here, never
# in an image, never in a record. This variable is only the POINTER; no secret value ever
# goes in .env, which every compose service reads including `deploy-checks`, whose
# credential scan must stay key-free.
#
# Bootstrap the directory and seed the files from their committed examples:
#     scripts/hive-init-secrets            # then edit the seeded files
#
# Leave this unset and the compose file defaults to $HOME/.config/omegahive/secrets —
# the canonical location, and the same default hive-init-secrets uses, so the two cannot
# disagree. Set it only to move the directory, and note the quoting rule: compose expands
# $HOME (and ${HOME}) in this file but does NOT expand `~`, which stays a literal
# character and yields a path that does not exist. Use $HOME/... or an absolute path.
#OMEGAHIVE_SECRETS_DIR=$HOME/.config/omegahive/secrets

# Backups (deployment spec §5). OMEGAHIVE_BACKUP_DIR is the HOST directory the `backup`
# service bind-mounts at /backups — where pg_dumps AND workspace git bundles land so one
# directory restores both stores, and where the operator rsyncs from over the tailnet.
# In production the systemd timer sets it (Environment=), so it need not live in .env; set
# it here only for manual `compose --profile ops run --rm backup`. Absolute path, outside
# the repo tree. OMEGAHIVE_BACKUP_KEEP bounds how many dumps/bundles are retained.
#OMEGAHIVE_BACKUP_DIR=/home/<deployuser>/omegahive-backups
OMEGAHIVE_BACKUP_KEEP=14

# Provider API keys for the R1 LLM coordinator (ladder) do NOT go here. `.env` is shared by
# every compose service including `deploy-checks`, whose credential scan (stage2 §5.2) must
# stay key-free. Keep the key in the host shell and let the `ladder` service pass it through:
#   OPENROUTER_API_KEY=… docker compose run --rm ladder smoke --model openrouter/<model>
# (ANTHROPIC_API_KEY works the same for anthropic/<model>.)
