+    done
+    if [ -n "$PRED_OFFENDING" ]; then
+      echo "  The offending lines:"
+      printf '%s\n' "$PRED_OFFENDING" | sed 's/^/    /'
+    fi
+    echo "  Fix the labels to the literal forms above, or launch deliberately unpredicted with --anyway."
+  } >&2
+  exit 1
+fi
+if [ "$GATE_ASSESS" = "warn" ]; then
+  echo "hive-launch: WARNING order '$TASK' has a partial Predictions section ($PRED_FIELDS of 3 fields parsed${PRED_MISSING:+; missing: $PRED_MISSING}) — launching."
+fi
