+"""Minimal repro: forward-chain a single implication, then backward-query its conclusion."""
+from pettachainer import PeTTaChainer
+
+h = PeTTaChainer()
+h.add_atom("(: edge_ab (Edge A B) (STV 1.0 1.0))")
+h.add_atom(
+    "(: edge_to_path "
+    "(Implication (Premises (Edge $x $y)) (Conclusions (Path $x $y))) "
+    "(CTV (STV 1.0 1.0) (STV 0.0 1.0)))"
+)
+
+print("=== direct backward query for the fact ===")
+print("query (Edge A B):", h.query("(: $prf (Edge A B) $tv)", steps=10, timeout_sec=0))
+
+print("=== forward chain ===")
+seeds = h.select_facts(["(Edge A B)"])
+print("seeds:", seeds)
+changed = h.forward_chain(seeds, steps=10)
+print("changed:", changed)
+
+print("=== backward query for derived conclusion ===")
+print("query (Path A B):", h.query("(: $prf (Path A B) $tv)", steps=10, timeout_sec=0))
+
+print("=== what's in the KB ===")
+print("all_facts:", h.all_facts())
