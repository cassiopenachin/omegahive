 # unpushed state — the pin must resolve on the hub, since the worker's fresh
 # clone comes from the hub.
@@ -217,9 +313,19 @@ order_pin() {  # order_pin <workspace-relative-path>  -> prints sha
 # Scoped by pathspec to the project's metrics dir, so unrelated work in the
 # operator's clone is never swept into the commit. Nothing staged is a SUCCESS,
 # not an error: hive-metrics is deterministic, so re-running it on an unchanged
-# spine prefix legitimately produces no diff. Push mirrors hive-answer's
-# retry (push -> pull --rebase -> push) and reports precisely how far it got, so
-# "committed locally" is never mistaken for "on the hub".
+# spine prefix legitimately produces no diff.
+#
+# A FAILED PUSH REFUSES; IT DOES NOT REBASE. This used to inherit hive-answer's
+# `push -> pull --rebase -> push` retry, which was tolerable while it ran on an
+# operator's deliberate command. It is not tolerable now: hive-close runs the
+# score AND the metrics refresh automatically on every close, so the retry is
+# reached unattended, several times a wave, against a path two projects and two
+# instruments write. An unattended `pull --rebase` on a shared metrics path
+# replays local commits over whatever arrived — and the operator, who never
+# asked for it, learns nothing about the divergence. So: commit locally, print
+# the one manual resolution step, exit non-zero. Pre-decided on the Watch entry
+# this closes (retro 2026-07-29 ledger item 13); its trigger was "the first time
+# it bites", pre-empted here because hive-close raises the firing rate.
 commit_metrics() {  # commit_metrics <project> <commit-message>  -> 0 committed/nothing-to-do, non-zero otherwise
   local msg="$2" spec="projects/$1/metrics"
   git -C "$OPS_WS" add -- "$spec" || { echo "hive: git add failed for $spec in $OPS_WS" >&2; return 1; }
@@ -230,12 +336,17 @@ commit_metrics() {  # commit_metrics <project> <commit-message>  -> 0 committed/
   git -C "$OPS_WS" commit --quiet -m "$msg" -- "$spec" \
     || { echo "hive: git commit failed for $spec in $OPS_WS (git identity unset, a commit hook, or an index lock?)" >&2; return 1; }
   if ! git -C "$OPS_WS" push --quiet 2>/dev/null; then
-    if ! git -C "$OPS_WS" pull --rebase --quiet; then
-      echo "hive: push failed and rebase failed — committed locally in $OPS_WS, NOT on the hub; resolve by hand" >&2
-      return 1
-    fi
-    git -C "$OPS_WS" push --quiet \
-      || { echo "hive: push failed for $OPS_WS — committed locally, NOT on the hub" >&2; return 1; }
+    {
+      echo "hive: push REFUSED — '$spec' is committed locally in $OPS_WS, but is NOT on the hub."
+      echo "  The commit is safe and nothing was lost; only the hub is behind."
+      echo "  This step deliberately does NOT 'pull --rebase' for you: it now runs unattended on"
+      echo "  every close, and rebasing a shared metrics path with no one watching is not a retry,"
+      echo "  it is an unsupervised history rewrite. Look, then push:"
+      echo "      git -C '$OPS_WS' log --oneline -- '$spec'      # what you are about to send"
+      echo "      git -C '$OPS_WS' fetch origin && git -C '$OPS_WS' status -sb"
+      echo "      git -C '$OPS_WS' pull --rebase && git -C '$OPS_WS' push"
+    } >&2
+    return 1
   fi
   echo "  committed + pushed: $spec ($msg)"
 }
