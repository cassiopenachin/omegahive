+# --- the predictions gate ------------------------------------------------------
+# Until now this gate was a human reading a heading at the coordinator's cut,
+# while `hive-score` parsed bullet LABELS. The two disagreed, silently, and an
+# entire tenant project's first wave scored `unpredicted` with no error printed
+# anywhere (retro 2026-07-29 D1). The launcher already reads this file — it greps
+# `^# ` for the board title — so the gate moves here, to the one moment before
+# launch where a machine has the file open.
+#
+# It calls `parse_predictions` (hive-common.sh), the same function the scorer
+# calls. Not a copy of its regexes: a gate that can drift out of agreement with
+# the scorer would reproduce D1 rather than close it.
+#
+# What refuses and what does not:
+#   no `## Predictions` section        -> launches. The gap is already a recorded
+#                                         metric, and an order the operator
+#                                         deliberately launches unpredicted must
+#                                         never need an override to get out.
+#   section, "deliberately unpredicted"-> launches, announced. Same reasoning; the
+#                                         protocol's own disposition, honoured.
+#   section, 1-2 of 3 fields parse     -> launches, LOUDLY. Partial coverage is a
+#                                         metric the instrument already reports.
+#   section, 0 of 3 fields parse       -> REFUSES. This is the D1 shape exactly:
+#                                         an author who predicted, in a dialect
+#                                         nothing can read. `--anyway` overrides.
+#
+# The refusal is on UNPARSEABLE, never on ABSENT. And it happens here — before the
+# throttle, before the clones, before any emit — so a refused launch leaves the
+# spine, the disk and the operator's tmux server exactly as it found them. The
+# check reads the file and writes nothing back into it; amendments to an order are
+# the operator's act through hive-answer, never the tooling's.
+parse_predictions "$OPS_WS/$REL"
+if [ "$PRED_SECTION" -eq 1 ] && [ "$PRED_FIELDS" -eq 0 ] && [ "$PRED_DECLARED" -eq 0 ]; then
+  if [ -z "$ANYWAY" ]; then
+    {
+      echo "hive-launch: refusing to launch '$TASK' — $REL has a '## Predictions' section that this hive cannot parse."
+      echo "  Not one of the three scored fields was readable, so launching would score the task"
+      echo "  'unpredicted' at close and lose the prediction silently — which is exactly what happened"
+      echo "  to an entire project's first wave (retro 2026-07-29 D1). The labels are literal:"
+      echo
+      printf '%s\n' "$PREDICTION_LABELS"
+      echo
+      echo "  $PREDICTION_SCORED_NOTE"
+      echo
+      echo "  What the section actually says:"
+      # One awk, no pipeline: `… | head -20` would SIGPIPE its upstream on a long
+      # section and abort this refusal mid-print under `set -o pipefail`.
+      awk 'NF && n < 20 { print "    | " $0; n++ }' <<<"$PRED_BLOCK"
+      echo
+      echo "  Fix the labels in the order (commit + push — the pin must resolve on the hub), then re-run."
+      echo "  If the task is deliberately unpredicted, say so in the section in one line containing"
+      echo "  '$PREDICTION_UNPREDICTED_DECL' and why, per the authoring protocol — that launches cleanly."
+      echo "  To launch it as-is anyway, knowing it will score unpredicted: --anyway"
+    } >&2
+    exit 1
+  fi
+  echo "hive-launch: WARNING --anyway: '$REL' has an unparseable '## Predictions' section."
+  echo "  This task will score 'unpredicted (section present, 0 of 3 fields parsed)' at close."
+elif [ "$PRED_SECTION" -eq 1 ] && [ "$PRED_FIELDS" -gt 0 ] && [ "$PRED_FIELDS" -lt 3 ]; then
+  {
+    echo "hive-launch: WARNING '$REL' predicts only $PRED_FIELDS of 3 scored fields."
+    echo "  Not parsed: $PRED_MISSING. This launches — partial coverage is a metric, not an error —"
+    echo "  but the missing field(s) will read '*not predicted*' in calibration.md forever. The labels:"
+    printf '%s\n' "$PREDICTION_LABELS"
+  } >&2
+elif [ "$PRED_SECTION" -eq 1 ] && [ "$PRED_DECLARED" -eq 1 ] && [ "$PRED_FIELDS" -eq 0 ]; then
+  echo "hive-launch: '$REL' declares the task deliberately unpredicted — launching, and it will score as declared."
+fi
