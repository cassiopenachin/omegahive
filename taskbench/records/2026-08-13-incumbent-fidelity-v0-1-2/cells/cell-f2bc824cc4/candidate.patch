@@ -0,0 +1,100 @@
+; The April 2026 probe, re-run at the pinned shas.
+;
+; ProofWriter theory RelNoneg-OWA-D1-390 in translation format A (the
+; semantic-parser's PeTTaChainer-targeted output), exactly as recorded in
+; plnbench docs/april-findings.md: 7 facts, 3 rules, type definitions excluded
+; (PeTTaChainer's add_atom rejects them).
+;
+; Each query is the POSITIVE form of a findings-table question, with that table's
+; gold answer named in the label. OWA answer mapping (docs/conventions.md):
+; non-empty high-strength result -> True (or False when the question was negated);
+; empty -> Unknown. "Empty result != Unknown until proven" — that is what this
+; probe exists to check.
+;
+; Run from PeTTaChainer's pettachainer/metta directory:
+;
+;     petta <path>/proofwriter-format-a.metta
+
+!(import! &self petta_chainer)
+
+; --- facts (format A: (: name body (STV s c))) --------------------------------
+!(compileadd pwKb (: bear_likes_dog     (Like bear_1 dog_1)         (STV 1.0 0.9)))
+!(compileadd pwKb (: cow_is_round       (HasAttribute cow_1 round)  (STV 1.0 0.9)))
+!(compileadd pwKb (: cow_likes_bear     (Like cow_1 bear_1)         (STV 1.0 0.9)))
+!(compileadd pwKb (: cow_needs_bear     (Need cow_1 bear_1)         (STV 1.0 0.9)))
+!(compileadd pwKb (: dog_needs_squirrel (Need dog_1 squirrel_1)     (STV 1.0 0.9)))
+!(compileadd pwKb (: dog_sees_cow       (See dog_1 cow_1)           (STV 1.0 0.9)))
+!(compileadd pwKb (: squirrel_needs_dog (Need squirrel_1 dog_1)     (STV 1.0 0.9)))
+
+; --- rules --------------------------------------------------------------------
+; "If someone is round then they like the squirrel"
+!(compileadd pwKb
+   (: round_likes_squirrel
+      (Implication
+         (Premises (HasAttribute $x round))
+         (Conclusions (Like $x squirrel_1)))
+      (STV 1.0 0.9)))
+
+; "If the bear is round and the bear likes the squirrel then the squirrel needs the bear"
+!(compileadd pwKb
+   (: bear_round_squirrel_needs
+      (Implication
+         (Premises (HasAttribute bear_1 round) (Like bear_1 squirrel_1))
+         (Conclusions (Need squirrel_1 bear_1)))
+      (STV 1.0 0.9)))
+
+; "If the cow needs the dog then the cow is cold"
+!(compileadd pwKb
+   (: cow_needs_dog_cold
+      (Implication
+         (Premises (Need cow_1 dog_1))
+         (Conclusions (HasAttribute cow_1 cold)))
+      (STV 1.0 0.9)))
+
+; What compileadd actually stored — the control for every empty query below.
+!(println! (PW-kb-after-compileadd
+   (collapse (match &kb ($type (pwKb MAIN Nil) $prf $tv) ($type $prf $tv)))))
+
+; --- backward chaining --------------------------------------------------------
+; "The cow needs the bear." / "The cow does not need the bear." — gold True / False, depth 0
+!(println! (PW-BWD-need-cow-bear-gold-True-depth0
+   (collapse (query 100 pwKb (: $prf (Need cow_1 bear_1) $tv)))))
+
+; "The cow likes the squirrel." / "...does not..." — gold True / False, depth 1
+!(println! (PW-BWD-like-cow-squirrel-gold-True-depth1
+   (collapse (query 100 pwKb (: $prf (Like cow_1 squirrel_1) $tv)))))
+
+; "The bear does not like the squirrel." — gold Unknown, depth 1
+!(println! (PW-BWD-like-bear-squirrel-gold-Unknown-depth1
+   (collapse (query 100 pwKb (: $prf (Like bear_1 squirrel_1) $tv)))))
+
+; "The dog likes the bear." — gold Unknown, depth 0
+!(println! (PW-BWD-like-dog-bear-gold-Unknown-depth0
+   (collapse (query 100 pwKb (: $prf (Like dog_1 bear_1) $tv)))))
+
+; --- forward chaining ---------------------------------------------------------
+; Full-KB saturation (the caller-directed API's saturation special case).
+!(println! (PW-FWD-changed-facts
+   (collapse
+      (forward-chain 100 pwKb
+         (collapse (match &kb ($type (pwKb MAIN Nil) $prf $tv)
+                              ($type (pwKb MAIN Nil) $prf $tv)))))))
+
+!(println! (PW-FWD-has-derived-like-cow-squirrel
+   (forward-has-derived? pwKb (Like cow_1 squirrel_1))))
+
+!(println! (PW-kb-after-forward-chain
+   (collapse (match &kb ($type (pwKb MAIN Nil) $prf $tv) ($type $prf $tv)))))
+
+; --- backward chaining again, over the forward-saturated KB -------------------
+!(println! (PW-BWD-after-FWD-need-cow-bear-gold-True-depth0
+   (collapse (query 100 pwKb (: $prf (Need cow_1 bear_1) $tv)))))
+
+!(println! (PW-BWD-after-FWD-like-cow-squirrel-gold-True-depth1
+   (collapse (query 100 pwKb (: $prf (Like cow_1 squirrel_1) $tv)))))
+
+!(println! (PW-BWD-after-FWD-like-bear-squirrel-gold-Unknown-depth1
+   (collapse (query 100 pwKb (: $prf (Like bear_1 squirrel_1) $tv)))))
+
+!(println! (PW-BWD-after-FWD-like-dog-bear-gold-Unknown-depth0
+   (collapse (query 100 pwKb (: $prf (Like dog_1 bear_1) $tv)))))
