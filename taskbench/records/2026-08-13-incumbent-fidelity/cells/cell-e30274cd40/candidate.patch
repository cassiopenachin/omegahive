+  full) ;;
+  absent)
+    echo "hive-launch: note — $REL carries no \`## Predictions\` section; launching. hive-score records that gap as unpredicted, which is a metric, not an error." ;;
+  declared)
+    echo "hive-launch: note — $REL declares itself deliberately unpredicted; launching. hive-score records it as such." ;;
+  partial)
+    {
+      echo "hive-launch: WARNING $REL predicts only $PRED_FIELDS of 3 scored fields — not parsed: $PRED_MISSED."
+      echo "  Launching anyway: partial coverage is a number hive-score already reports, not a refusal."
+      echo "  If that is not what the order meant, the labels are literal:"
+      predictions_labels
+    } >&2 ;;
+  unparseable)
+    {
+      echo "hive-launch: $REL has a \`## Predictions\` section in which NONE of the three scored fields parses."
+      echo "  This is not a formatting nit. hive-score parses labels, not prose, so launching now"
+      echo "  would record this order as \`unpredicted\` — indistinguishable from an order that"
+      echo "  predicted nothing at all — and the prediction the author actually wrote is lost."
+      echo
+      echo "  The four labels are literal. Copy them exactly:"
+      predictions_labels
+      echo "  Three of the four are scored: effort, questions, review outcome."
+      echo "  \`- Named risks:\` is required by the authoring protocol and read by no instrument —"
+      echo "  it is not parsed, not counted, and its absence is not what refused this launch."
+      echo
+      echo "  What this order's section says now:"
+      # `|| true`: a section that is present but entirely blank parses as
+      # unparseable and has no non-blank lines to show, and a no-match grep under
+      # `set -o pipefail` would abort the refusal one line before it printed.
+      { printf '%s\n' "$PRED_BLOCK" | grep -v '^[[:space:]]*$' | sed 's/^/    | /'; } || true
+      echo
+      echo "  Fix the order (it is the design partner's to edit before launch — never after"
+      echo "  seeding), or launch as-is with --anyway if losing the prediction is deliberate."
+    } >&2
+    [ -n "$ANYWAY" ] || exit 1
+    echo "hive-launch: --anyway — launching an order whose predictions cannot be parsed; hive-score will record it as unpredicted." >&2 ;;
+esac
