@@ -0,0 +1,27 @@
+"""Second minimal repro: an (STV s c)-tagged rule compiles but never fires forward.
+
+PeTTaChainer documents rule truth values as (STV s c) in both LANGUAGE_SPEC.md and
+LLM_RULE_SPEC.md — the latter being the string get_language_spec() hands to an LLM,
+so it is exactly what the semantic-parser emits — and tests/test_stv_implication_
+derived_ctv.metta asserts the form is supported. Forward chaining nonetheless
+derives nothing from it, with no error from compileadd. The same rule tagged
+(CTV (STV s c) (STV 0.0 1.0)) fires.
+
+  cd <PeTTaChainer> && uv run python min_repro_stv_rule.py
+"""
+
+from pettachainer import PeTTaChainer
+
+RULE_BODY = "(Implication (Premises (A)) (Conclusions (B)))"
+
+
+def derive(rule_tv: str):
+    handler = PeTTaChainer()
+    handler.add_atom("(: a (A) (STV 1.0 1.0))")
+    handler.add_atom(f"(: a_to_b {RULE_BODY} {rule_tv})")
+    return handler.forward_chain(handler.all_facts(), steps=5)
+
+
+print("rule (STV 1.0 0.9)                    -> forward derived:", derive("(STV 1.0 0.9)"))
+print("rule (CTV (STV 1.0 0.9) (STV 0.0 1.0)) -> forward derived:",
+      derive("(CTV (STV 1.0 0.9) (STV 0.0 1.0))"))
