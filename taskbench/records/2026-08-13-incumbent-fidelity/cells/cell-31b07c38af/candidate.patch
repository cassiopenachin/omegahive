index 0000000..a1be78c
--- /dev/null
+++ b/tests/ptc-revalidate/probe/proofwriter_format_a.py
@@ -0,0 +1,134 @@
+"""The April probe, rerun: format-A ProofWriter theory through PeTTaChainer.
+
+Reproduces docs/april-findings.md "Translation A" — 7 facts, 3 rules, type
+definitions excluded — and asks the questions from the findings table, in both
+chaining modes:
+
+  backward : compileadd, then query() for the positive form of each question
+  forward  : compileadd, then forward_chain() to saturation, then check whether
+             the target became a KB fact (and re-query it backward)
+
+The questions are asked as positive forms because that is the April OWA answer
+mapping (april-findings.md, "Negation and answer mapping"): derivable -> True,
+or False when the question was phrased as a negation; not derivable -> Unknown.
+
+Two KB variants run, so a rule-truth-value format difference cannot be mistaken
+for a chaining verdict:
+  verbatim : rule TVs exactly as the findings doc and LLM_RULE_SPEC.md write them
+  ctv      : the same rules re-tagged (CTV (STV s c) (STV 0.0 1.0)), the form
+             PeTTaChainer's own current tests use
+
+Usage: uv run python proofwriter_format_a.py <kb-file>
+"""
+
+import re
+import sys
+
+from pettachainer import PeTTaChainer
+
+# (question, positive target, negated?, expected answer) — docs/april-findings.md
+# sample table, all six rows.
+QUESTIONS = [
+    ("The cow needs the bear.",              "(Need cow_1 bear_1)",      False, "True"),
+    ("The cow does not need the bear.",      "(Need cow_1 bear_1)",      True,  "False"),
+    ("The cow likes the squirrel.",          "(Like cow_1 squirrel_1)",  False, "True"),
+    ("The cow does not like the squirrel.",  "(Like cow_1 squirrel_1)",  True,  "False"),
+    ("The bear does not like the squirrel.", "(Like bear_1 squirrel_1)", True,  "Unknown"),
+    ("The dog likes the bear.",              "(Like dog_1 bear_1)",      False, "Unknown"),
+]
+
+KB_ID = re.compile(r"kb[0-9a-f]{32}")
+
+
+def norm(value) -> str:
+    """Strip the per-handler KB uuid so output is diffable across runs."""
+    return KB_ID.sub("kbNNN", str(value))
+
+
+def load(path: str) -> list[str]:
+    with open(path, encoding="utf-8") as fh:
+        return [ln.strip() for ln in fh if ln.strip() and not ln.lstrip().startswith(";")]
+
+
+def to_ctv(stmt: str) -> str:
+    """Re-tag an Implication's trailing (STV s c) as (CTV (STV s c) (STV 0.0 1.0))."""
+    if "(Implication" not in stmt:
+        return stmt
+    m = re.search(r"\(STV ([0-9.]+) ([0-9.]+)\)\s*\)\s*$", stmt)
+    if not m:
+        return stmt
+    return stmt[: m.start()] + f"(CTV (STV {m.group(1)} {m.group(2)}) (STV 0.0 1.0)))"
+
+
+def build(statements: list[str]) -> tuple[PeTTaChainer, list[str]]:
+    handler = PeTTaChainer()
+    rejected = []
+    for stmt in statements:
+        try:
+            handler.add_atom(stmt)
+        except Exception as exc:  # a compileadd refusal is itself a finding
+            rejected.append(f"{stmt}  ->  {type(exc).__name__}: {exc}")
+    return handler, rejected
+
+
+def owa_answer(derived: bool, negated: bool) -> str:
+    """April's OWA mapping: the positive holds -> True (False if the question was
+    a negation); nothing derivable either way -> Unknown."""
+    if not derived:
+        return "Unknown"
+    return "False" if negated else "True"
+
+
+def score(mode: str, derived_of) -> None:
+    hits = 0
+    for question, target, negated, expected in QUESTIONS:
+        derived, evidence = derived_of(target)
+        got = owa_answer(derived, negated)
+        hits += got == expected
+        mark = "ok " if got == expected else "MISS"
+        print(f"     {mark} expected={expected:<7} got={got:<7} {target:<26} {evidence}")
+    print(f"     {mode}: {hits}/{len(QUESTIONS)} answers match the findings table")
+
+
+def run(variant: str, statements: list[str]) -> None:
+    print(f"### variant={variant}  ({len(statements)} statements)")
+    handler, rejected = build(statements)
+    for line in rejected:
+        print(f"  compileadd REJECTED {norm(line)}")
+    print(f"  compileadd accepted {len(statements) - len(rejected)}/{len(statements)}")
+
+    def backward(target: str):
+        proofs = handler.query(f"(: $prf {target} $tv)", steps=50, timeout_sec=0)
+        return bool(proofs), norm(proofs)
+
+    print("  -- backward chaining (query after compileadd)")
+    score("backward", backward)
+
+    print("  -- forward chaining (saturate, then look for the target as a KB fact)")
+    before = set(handler.all_facts())
+    changed = handler.forward_chain(handler.all_facts(), steps=50)
+    facts = handler.all_facts()
+    print(f"     facts before={len(before)} newly-derived={len(changed)} after={len(facts)}")
+    for line in sorted(norm(f) for f in set(facts) - before):
+        print(f"     derived: {line}")
+
+    def forward(target: str):
+        # Canonical facts print as ((Pred args) (kb MAIN Nil) <proof> (STV s c)).
+        hit = next((f for f in facts if f.startswith(f"({target} ")), None)
+        return hit is not None, norm(hit) if hit else ""
+
+    score("forward", forward)
+
+    print("  -- backward chaining again, over the saturated KB")
+    score("backward-after-forward", backward)
+    print()
+
+
+def main() -> None:
+    statements = load(sys.argv[1])
+    run("verbatim", statements)
+    run("ctv", [to_ctv(s) for s in statements])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/ptc-revalidate/run.sh b/tests/ptc-revalidate/run.sh
new file mode 100755
index 0000000..5e88de3
--- /dev/null
+++ b/tests/ptc-revalidate/run.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+# ptc-revalidate — reproduce the PeTTaChainer chaining verdict at pinned shas.
+#
+# Builds PeTTaChainer's own isolated task environment (.myclaw/Dockerfile) at
+# PTC_SHA, pairs it with PeTTa at PETTA_SHA, and runs, in one container:
+#   1. PeTTaChainer's Python test suite         (upstream's own, verbatim)
+#   2. PeTTaChainer's MeTTa test suite          (upstream's own, per-file, verbatim)
+#   3. the minimal repro                        (2 statements, MeTTa + Python API)
+#   4. the April format-A ProofWriter probe     (docs/april-findings.md, both modes)
+#   5. PeTTa's own test suite                   (control: is the runtime healthy?)
+#
+# Everything lands under results/ptc-revalidate/out/ (gitignored). The stable
+# summary is diffed against tests/expected/ptc-revalidate/summary.txt, which is
+# runtime-captured ground truth, not hand-written (docs/conventions.md).
+#
+# Usage:   bash tests/ptc-revalidate/run.sh
+# Offline: PTC_SRC=/path/to/PeTTaChainer.bundle PETTA_SRC=/path/to/PeTTa.bundle \
+#          PTC_SRC_REF=pinned PETTA_SRC_REF=pinned bash tests/ptc-revalidate/run.sh
+#
+# Runtime: ~15 min on a warm image (the MeTTa suite is 50 files; PeTTa's is 157).
+set -uo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+HARNESS="$ROOT/tests/ptc-revalidate"
+# shellcheck disable=SC1091
+source "$ROOT/pins.env"
+
+# --- shas -------------------------------------------------------------------
+# PeTTaChainer is deliberately NOT in pins.env (see the comment there): this
+# order pins it itself, and the verdict is only about this pair.
+PTC_SHA="${PTC_SHA:-02a85c63be6a735f50f50e1084a717b3256b8406}"
+PETTA_SHA="${PETTA_SHA:?pins.env must define PETTA_SHA}"
+PTC_SRC="${PTC_SRC:-https://github.com/rTreutlein/PeTTaChainer.git}"
+PETTA_SRC="${PETTA_SRC:-$PETTA_URL}"
+PTC_SRC_REF="${PTC_SRC_REF:-}"      # branch to clone from a bundle; empty = default
+PETTA_SRC_REF="${PETTA_SRC_REF:-}"
+
+WORK="${PTC_WORK:-$ROOT/results/ptc-revalidate}"
+OUT="$WORK/out"
+ENGINE="${CONTAINER_ENGINE:-}"
+if [ -z "$ENGINE" ]; then
+  if command -v podman >/dev/null 2>&1; then ENGINE=podman
+  elif command -v docker >/dev/null 2>&1; then ENGINE=docker
+  else echo "ERROR: neither podman nor docker on PATH." >&2; exit 1; fi
+fi
+
+# Upstream's own dev layout, and not negotiable: .myclaw/petta hardcodes
+# /nexus/Dev/OpenCog/PeTTa/run.sh, and PeTTaChainer's pyproject resolves petta
+# at ../../PeTTa — so PeTTaChainer must sit two levels below /nexus/Dev/OpenCog.
+NEXUS="$WORK/nexus"
+PETTA_DIR="$NEXUS/Dev/OpenCog/PeTTa"
+PTC_DIR="$NEXUS/Dev/OpenCog/plnbench/PeTTaChainer"
+
+echo "ptc-revalidate"
+echo "  engine     : $ENGINE"
+echo "  PeTTaChainer @ $PTC_SHA  (from $PTC_SRC)"
+echo "  PeTTa        @ $PETTA_SHA  (from $PETTA_SRC)"
+echo "  work       : $WORK"
+
+# --- pinned checkouts -------------------------------------------------------
+fetch_pin () { # src sha dir ref
+  local src="$1" sha="$2" dir="$3" ref="$4"
+  if [ ! -d "$dir/.git" ]; then
+    mkdir -p "$(dirname "$dir")"
+    if [ -n "$ref" ]; then git clone --quiet -b "$ref" "$src" "$dir"
+    else git clone --quiet "$src" "$dir"; fi || return 1
+  fi
+  git -C "$dir" rev-parse --verify --quiet "$sha^{commit}" >/dev/null \
+    || git -C "$dir" fetch --quiet origin || true
+  git -C "$dir" checkout --quiet "$sha" || return 1
+  echo "  pinned: $dir @ $(git -C "$dir" rev-parse --short HEAD)"
+}
+mkdir -p "$OUT"
+fetch_pin "$PETTA_SRC" "$PETTA_SHA" "$PETTA_DIR"  "$PETTA_SRC_REF" || exit 1
+fetch_pin "$PTC_SRC"   "$PTC_SHA"   "$PTC_DIR"    "$PTC_SRC_REF"   || exit 1
+# A modified checkout would make the verdict cite a sha it did not run. Untracked
+# files are exempt on purpose: running the suites leaves .venv/, __pycache__/ and
+# PeTTa's git-import cache (repos/) behind, and those are artifacts, not edits.
+for d in "$PETTA_DIR" "$PTC_DIR"; do
+  [ -z "$(git -C "$d" status --porcelain --untracked-files=no)" ] \
+    || { echo "ERROR: $d has modified tracked files — subjects under test must be untouched" >&2; exit 1; }
+done
+
+# --- image ------------------------------------------------------------------
+IMAGE="plnbench-ptc-revalidate:${PTC_SHA:0:7}"
+echo "  building $IMAGE from PeTTaChainer's .myclaw/Dockerfile"
+"$ENGINE" build -q -t "$IMAGE" -f "$PTC_DIR/.myclaw/Dockerfile" "$PTC_DIR" >/dev/null || exit 1
+
+# --- run --------------------------------------------------------------------
+# $HOME and the uv cache are mounted so a rerun does not re-download CPython.
+mkdir -p "$WORK/home" "$WORK/uv-cache"
+"$ENGINE" run --rm \
+  -v "$NEXUS:/nexus:z" \
+  -v "$HARNESS:/harness:z" \
+  -v "$OUT:/out:z" \
+  -v "$WORK/home:/tmp/myclaw-home:z" \
+  -v "$WORK/uv-cache:/opt/myclaw/uv-cache:z" \
+  -w /nexus/Dev/OpenCog/plnbench/PeTTaChainer \
+  "$IMAGE" bash /harness/in-container.sh
+rc=$?
+[ $rc -eq 0 ] || { echo "ERROR: in-container harness exited $rc" >&2; exit $rc; }
+
+# --- ground-truth comparison ------------------------------------------------
+EXPECTED="$ROOT/tests/expected/ptc-revalidate/summary.txt"
+echo
+if [ ! -f "$EXPECTED" ]; then
+  echo "no expected/ capture yet — first run. Review $OUT/summary.txt, then:"
+  echo "  cp $OUT/summary.txt $EXPECTED"
+  exit 0
+fi
+if diff -u "$EXPECTED" "$OUT/summary.txt"; then
+  echo "ptc-revalidate: summary matches tests/expected/ptc-revalidate/summary.txt"
+else
+  echo "ptc-revalidate: SUMMARY DIVERGED from the captured ground truth."
+  echo "  A divergence is a finding, not a failure to paper over: if the shas are"
+  echo "  unchanged, something in the host toolchain moved; if a sha changed, the"
+  echo "  verdict in docs/ptc-verdict.md needs rerunning, not editing."
+  exit 1
+fi
diff --git a/tests/ptc-revalidate/summarize.py b/tests/ptc-revalidate/summarize.py
new file mode 100644
index 0000000..26bb76a
--- /dev/null
+++ b/tests/ptc-revalidate/summarize.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Reduce the harness's verbatim logs to a stable, diffable summary.
+
+Stable means: no timestamps, no paths, no per-run uuids, no float noise beyond
+what the runtime itself produces deterministically. That is what makes
+tests/expected/ptc-revalidate/summary.txt usable as captured ground truth.
+
+Runs inside the container as system python3. Reads /out, writes stdout.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import pathlib
+import re
+
+OUT = pathlib.Path(os.environ.get("PTC_OUT", "/out"))
+ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
+KB_ID = re.compile(r"kb[0-9a-f]{32}")
+ASSERT = re.compile(r"^is (.*), should (.*?)\.? (✅|❌)\s*$")
+
+
+def text(name: str) -> str:
+    p = OUT / name
+    if not p.exists():
+        return ""
+    raw = p.read_text(encoding="utf-8", errors="replace")
+    return KB_ID.sub("kbNNN", ANSI.sub("", raw))
+
+
+def lines(name: str) -> list[str]:
+    return [ln.rstrip() for ln in text(name).splitlines()]
+
+
+def classify(log_name: str, exit_code: str) -> str:
+    """First failing assertion in a MeTTa test log, reduced to a failure shape."""
+    marks = [ASSERT.match(ln.strip()) for ln in lines(f"metta-suite/{log_name}")]
+    marks = [m for m in marks if m]
+    failed = [m for m in marks if m.group(3) == "❌"]
+    if not marks:
+        return "no-assertion-ran" if exit_code != "0" else "ok-no-assertion"
+    if not failed:
+        return "ok" if exit_code == "0" else f"assertions-passed-but-exit-{exit_code}"
+    got, want = failed[0].group(1).strip(), failed[0].group(2).strip()
+    # The distinction that carries the verdict: an empty result is the chainer
+    # finding nothing; a mismatch is it finding something and disagreeing. The
+    # same emptiness shows up in three surface forms depending on whether the
+    # test wraps the query in collapse, length, or neither.
+    shape = "empty-result" if got in ("()", "(0 ())", "0") else "value-mismatch"
+    return (f"{shape} ({len(failed)}/{len(marks)} assertions failed) "
+            f"got={trunc(got)} want={trunc(want)}")
+
+
+def trunc(value: str, width: int = 48) -> str:
+    return value if len(value) <= width else value[: width - 3] + "..."
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    for flag in ("--ptc-sha", "--petta-sha", "--swipl", "--python"):
+        ap.add_argument(flag, default="")
+    a = ap.parse_args()
+
+    print("# ptc-revalidate summary — stable fields only; verbatim output is in the sibling logs")
+    print(f"ptc-sha={a.ptc_sha}")
+    print(f"petta-sha={a.petta_sha}")
+    print(f"swipl={a.swipl.strip()}")
+    print(f"python={a.python.strip()}")
+    print()
+
+    # --- control: is the runtime itself healthy? ---
+    petta = lines("petta-own-tests.txt")
+    ok = sum(1 for ln in petta if ln.startswith("OK: "))
+    bad = sum(1 for ln in petta if ln.startswith("FAILURE"))
+    print(f"[control] petta-own-suite: ok={ok} failures={bad}")
+    print()
+
+    # --- PeTTaChainer Python suite ---
+    py = lines("python-unittest.txt")
+    ran = next((ln for ln in py if ln.startswith("Ran ")), "")
+    ran = re.sub(r" in [0-9.]+s$", "", ran.strip())  # wall clock is not ground truth
+    verdict = next((ln for ln in py if ln.startswith(("OK", "FAILED"))), "")
+    print(f"[python] {ran} :: {verdict.strip()}")
+    for ln in py:
+        m = re.match(r"^(FAIL|ERROR): (\S+) \(([^)]+)\)", ln)
+        if m:
+            print(f"[python] {m.group(1)} {m.group(3).split('.')[0]}.{m.group(2)}")
+    print()
+
+    # --- PeTTaChainer MeTTa suite ---
+    rows = [ln.split(" ", 1) for ln in lines("metta-suite.txt") if ln]
+    passed = sum(1 for code, _ in rows if code == "0")
+    print(f"[metta] pettachainer suite: passed={passed} failed={len(rows) - passed} total={len(rows)}")
+    for code, path in rows:
+        log_name = path.replace("/", "_") + ".log"
+        state = "PASS" if code == "0" else "FAIL"
+        print(f"[metta] {state} {path} :: {classify(log_name, code)}")
+    print()
+
+    # --- the minimal repro ---
+    for ln in lines("min-repro-metta.txt"):
+        m = ASSERT.match(ln.strip())
+        if m:
+            print(f"[min-repro/metta] is {m.group(1)}, should {m.group(2)} {m.group(3)}")
+    for ln in lines("min-repro-python.txt"):
+        if ln.startswith(("backward", "forward")):
+            print(f"[min-repro/python] {ln.strip()}")
+    for ln in lines("min-repro-stv-rule.txt"):
+        if ln.startswith("rule "):
+            print(f"[min-repro/stv-rule] {ln.strip()}")
+    print()
+
+    # --- the April format-A probe ---
+    for ln in lines("proofwriter-format-a.txt"):
+        if ln.strip() and not re.match(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d", ln):
+            print(f"[proofwriter] {ln.rstrip()}")
+
+
+if __name__ == "__main__":
+    main()
