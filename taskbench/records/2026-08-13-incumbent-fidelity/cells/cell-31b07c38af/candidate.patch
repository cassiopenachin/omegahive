@@ -0,0 +1,14 @@
+; Minimal repro — the backward chainer cannot retrieve a fact it just compiled.
+;
+; These three lines are the first case of PeTTaChainer's OWN test file
+; pettachainer/metta/tests/test_query_adds.metta (lines 1-8, verbatim), so the
+; expected value below is upstream's expectation, not ours.
+;
+; Run from pettachainer/metta:  petta <this file>
+
+!(import! &self petta_chainer)
+
+!(compileadd k (: pa (A) (STV 1.0 1.0)))
+
+!(test (query 10 k (: $p (A) $tv))
+   (: pa (A) (STV 1.0 1.0)))
diff --git a/tests/ptc-revalidate/probe/min_repro.py b/tests/ptc-revalidate/probe/min_repro.py
new file mode 100644
index 0000000..682e0c0
--- /dev/null
+++ b/tests/ptc-revalidate/probe/min_repro.py
@@ -0,0 +1,24 @@
+"""Minimal repro at the Python API surface — the surface the semantic-parser uses.
+
+Same shape as min_repro.metta: one fact in, backward query for that exact fact
+returns nothing; forward chaining over the same KB works. Deliberately dependency
+free beyond pettachainer itself, so it can be pasted into an upstream issue.
+
+  cd <PeTTaChainer> && uv run python min_repro.py
+"""
+
+from pettachainer import PeTTaChainer
+
+handler = PeTTaChainer()
+handler.add_atom("(: pa (A) (STV 1.0 1.0))")
+handler.add_atom(
+    "(: a_to_b (Implication (Premises (A)) (Conclusions (B)))"
+    " (CTV (STV 1.0 1.0) (STV 0.0 1.0)))"
+)
+
+# timeout_sec=0 keeps the query in-process: no multiprocessing worker, so an
+# empty result cannot be blamed on the timeout path.
+print("backward query for the compiled fact (A) :", handler.query("(: $prf (A) $tv)", steps=10, timeout_sec=0))
+print("backward query for the derivable (B)     :", handler.query("(: $prf (B) $tv)", steps=10, timeout_sec=0))
+print("forward chain from (A)                   :", handler.forward_chain(handler.select_facts("(A)"), steps=5))
+print("backward query for (B) after forward     :", handler.query("(: $prf (B) $tv)", steps=10, timeout_sec=0))
