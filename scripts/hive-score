#!/usr/bin/env bash
# hive-score <task> [--project <name>] [--run <run-id>] [--review <verdict>]
#                   [--note <text>] [--again] [--no-commit]
#
# Scores a closed task's order-file predictions against what actually happened,
# recording ONE entry per task in projects/<project>/metrics/calibration.md.
#
# The product is calibration, not the number (coordinator PROTOCOL): a prediction
# that was wrong and recorded as wrong is worth more than one quietly dropped. So:
#
#   * a task whose order has no `## Predictions` section is recorded anyway, as
#     **unpredicted** — the gap is itself the metric;
#   * a section that predicts some fields and not others is recorded as
#     **partial**, with the missing fields marked *not predicted*;
#   * predictions are quoted verbatim next to the outcome, so a reader can
#     disagree with the verdict without re-deriving anything.
#
# One row per task (retro 3 D4): `--again` on an already-scored task REPLACES
# that task's entry in place — same position, older duplicates for the same task
# dropped — rather than appending a second row. `hive-score --again` with no
# explicit `--review` carries forward the newest human verdict already on record
# for that task; only a task that has never carried a human verdict stays
# `unscored`. An explicit `--review` always wins over the carried-forward one.
# Without `--again`, an already-scored task still refuses outright.
#
# `--review clean` is refused when the spine's `review.failed` count for the task
# is nonzero (retro 3 D2/R3's code twin): the verdict covers the task's whole
# post-result review cycle, not just whether the final artefact reads clean. The
# refusal fires whether the `clean` came from `--review` or was carried forward,
# and writes no row.
#
# REVISION (decisions.md 2026-08-01 / retro 3 Verdict 4). Effort is scored against
# accept -> the FIRST `task.result_posted`, net of blocked time up to that firing
# only — a revision fired later (a corrected ref after review) never moves it,
# because it prices producing the result, not the review cycle that follows. The
# full-cycle span (accept -> the LAST `result_posted`, gross) is reported beside
# it, for context, whenever the two differ; it is never scored as effort.
# `--effort-uninterpretable <scope-amendment|host-incident>` (requires --note) is
# the one narrow, explicit override for the effort verdict — never inferred from
# elapsed time — for the two decided cause classes that leave no trace on the
# spine. Questions and review-outcome scoring are unaffected by any of this.
#
# Intended call time is at or after close, and it works retroactively: every
# outcome comes from the spine, so scoring a task closed weeks ago gives the same
# answer it would have given on the day.
#
# READ-ONLY over the spine, like hive-metrics: one `report <run> --json` read and
# no emits ever. calibration.md is its only write — and scoring then commits and
# pushes that file, because a score is only real once it is committed: the
# improver seat reads committed instruments, so an uncommitted calibration.md is
# invisible to the only reader it has. `--no-commit` restores the old
# write-and-stop behaviour for a dry run or a hand-curated commit.

# Deliberate redundancy with hive-common.sh:26, which sets exactly the same three
# options during the `source` below. Five production scripts inherited -e, -u and
# pipefail from that ONE line and stated none of them; a refactor that guards it, moves
# it, or wraps the source in a conditional would have quietly stripped error-exit,
# nounset and pipefail from all five at once, and nothing would have failed loudly
# enough to notice. Setting them here is a no-op at runtime and makes each script's own
# contract readable without opening another file.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

usage() {
  echo "usage: hive-score <task> [--project <name>] [--run <run-id>] [--review <verdict>] [--note <text>] [--again] [--no-commit]" >&2
  echo "       hive-score <task> --effort-uninterpretable <scope-amendment|host-incident> --note <text> [--project <name>] [--run <run-id>] [--review <verdict>] [--again] [--no-commit]" >&2
  exit 2
}

TASK=""
PROJECT_OVERRIDE=""
RUN_OVERRIDE=""
REVIEW_VERDICT=""
NOTE=""
AGAIN=0
COMMIT=1
EFFORT_UNINTERP=""
while [ $# -gt 0 ]; do
  case "$1" in
    --project) shift; [ $# -gt 0 ] || usage; PROJECT_OVERRIDE="$1" ;;
    --run)     shift; [ $# -gt 0 ] || usage; RUN_OVERRIDE="$1" ;;
    --review)  shift; [ $# -gt 0 ] || usage; REVIEW_VERDICT="$1" ;;
    --note)    shift; [ $# -gt 0 ] || usage; NOTE="$1" ;;
    --effort-uninterpretable) shift; [ $# -gt 0 ] || usage; EFFORT_UNINTERP="$1" ;;
    --again)   AGAIN=1 ;;
    --no-commit) COMMIT=0 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [ -z "$TASK" ] || usage; TASK="$1" ;;
  esac
  shift
done
[ -n "$TASK" ] || usage

# --effort-uninterpretable is the one narrow, non-numeric effort override (order
# stop-line: no general one). It exists because the two decided cause classes —
# an operator scope amendment mid-flight, or a host incident — do not exist on
# the spine as events, so nothing here can ever detect them; the flag is the
# only way they reach calibration.md, and it is never inferred from elapsed time,
# however extreme. It accepts only the two decided classes and REQUIRES a
# non-empty --note carrying the one-line cause — a bare "trust me" is refused,
# same spirit as the false-clean refusal below. Validated before any spine read,
# same as --review, so a typo'd cause never gets partway through a scoring run.
case "$EFFORT_UNINTERP" in
  "") ;;
  scope-amendment|host-incident)
    [ -n "$NOTE" ] || die "--effort-uninterpretable $EFFORT_UNINTERP requires --note \"<one-line cause>\" — the cause does not exist on the spine, so the note is the only record of it" ;;
  *) die "--effort-uninterpretable must be one of: scope-amendment | host-incident, got '$EFFORT_UNINTERP'" ;;
esac

# --review validates against the scored vocabulary, case-insensitively, and
# stores lowercase. Wave 2 produced `Rework`, `rework`, `Clean`, `clean`, and
# `minor rework` into the same column (retro 1's instrument note, unenforced
# since) — `rework` and `minor rework` are two distinct severities, so an
# uncontrolled column is not just cosmetic. validate_review_verdict
# (hive-common.sh) is the SAME validator hive-close uses, so the two can never
# drift apart.
if [ -n "$REVIEW_VERDICT" ]; then
  REVIEW_VERDICT=$(validate_review_verdict "$REVIEW_VERDICT")
fi

command -v jq >/dev/null 2>&1 || die "jq is required"

# --- resolve the order, then the project, then the run -------------------------
# Order first, because the order's PATH is what names the project — the same
# inference hive-launch makes (projects/<name>/orders/<file>.md). find_order
# searches every project and refuses cross-project ambiguity.
#
# find_order refuses on two very different things, and they must not be conflated:
# "no order deriving task" is a legitimate outcome (the 2026-07-13 hand-seeded task
# ids do not invert to their filenames, and never will) and scores as unpredicted.
# Anything else — an ambiguous task across projects — is the shared guard doing its
# job, and swallowing it would append a permanent, committed calibration entry
# asserting the operator predicted nothing when they did.
# `2>&1` merges the streams: on success stdout carries the path and stderr is
# empty; on failure `die` has written only to stderr and stdout is empty.
ORDER_REL=""
if ! ORDER_REL=$(find_order "$TASK" 2>&1); then
  case "$ORDER_REL" in
    *"no order deriving task"*) ORDER_REL="" ;;
    *) die "cannot resolve the order for '$TASK': ${ORDER_REL#hive: }" ;;
  esac
fi

# --project wins; otherwise the order's path names the project. A task with no
# order file (the hand-seeded ids) cannot name one, so it must be given — guessing
# is exactly what project_from_order refuses to do.
if [ -n "$PROJECT_OVERRIDE" ]; then
  PROJECT="$PROJECT_OVERRIDE"
elif [ -n "$ORDER_REL" ]; then
  PROJECT=$(project_from_order "$ORDER_REL")
else
  die "no order file derives task '$TASK', so its project cannot be inferred; pass --project <name>"
fi
# PROJECT is interpolated into a path under $OPS_WS/projects/, so a traversal
# would write calibration.md outside the workspace, where git never sees it and
# the operator never commits it.
case "$PROJECT" in */*|.|..) die "project must be a bare directory name, got '$PROJECT'" ;; esac

# Run id from the project's committed identity; --run maps onto HIVE_RUN_ID so the
# precedence rule (env > conf) is the tooling's one rule, not a second one here.
if [ -n "$RUN_OVERRIDE" ]; then export HIVE_RUN_ID="$RUN_OVERRIDE"; fi
load_project_conf "$PROJECT"

# --- the spine read (identical path to hive-metrics) ---------------------------
if [ -n "${HIVE_SPINE_JSON:-}" ]; then
  [ -f "$HIVE_SPINE_JSON" ] || die "HIVE_SPINE_JSON is set but not a file: $HIVE_SPINE_JSON"
  EVENTS=$(cat "$HIVE_SPINE_JSON")
else
  # `</dev/null`: `hive` is `podman compose run`, which consumes stdin — without
  # it, scoring many tasks from a `while read` loop eats the loop's own input.
  EVENTS=$( hive report "$RUN" --json 2>/dev/null </dev/null ) || EVENTS=""
fi
printf '%s' "$EVENTS" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1 \
  || die "no events for run '$RUN' (wrong run id, or the stack is down?)"

# These definitions are the same predicates hive-metrics uses, and must stay that
# way: an entry in calibration.md whose "actual" disagrees with the row in
# tasks.md for the same task is worse than no entry at all.
read -r -d '' OUTCOME_JQ <<'JQ' || true
def first_ts($t): [ .[] | select(.event_type == $t) | .logical_ts ] | first;
def last_ts($t):  [ .[] | select(.event_type == $t) | .logical_ts ] | last;

# Blocked time strictly up to a cutoff — used for the FIRST-result production
# span (retro 3 Verdict 4): a block that OPENS after the cutoff never counts,
# whether or not it ever closes, because review-cycle blocking after the first
# result belongs to the review-outcome field's territory, not the effort figure.
# Identical to hive-metrics' own `blocked_upto` — keep the two byte-identical.
def blocked_upto($cutoff):
  if $cutoff == null then null
  else
    ( reduce .[] as $e ({open: null, total: 0};
        if $e.event_type == "task.blocked" and $e.logical_ts <= $cutoff then
          (if .open == null then .open = $e.logical_ts else . end)
        elif $e.event_type == "task.unblocked" and .open != null then
          (if $e.logical_ts <= $cutoff
             then {open: null, total: (.total + $e.logical_ts - .open)}
             else {open: null, total: (.total + $cutoff - .open)} end)
        else . end) ) as $r
    | $r.total + (if $r.open != null then $cutoff - $r.open else 0 end)
  end;

# Terminal events per the legality table: status_override(done), task.failed, and
# a run-scoped plan.revised(cancel). status_override(cancelled|failed) is
# gateway-refused and can never be logged; reopened un-terminates.
def terminal($created; $cancel_ts):
  ( reduce .[] as $e (null;
      if $e.event_type == "task.status_override" and $e.payload.status == "done"
        then {status: "done", ts: $e.logical_ts}
      elif $e.event_type == "task.status_override" and $e.payload.status == "reopened"
        then null
      elif $e.event_type == "task.failed"
        then {status: "failed", ts: $e.logical_ts}
      else . end) ) as $t
  | if $t != null then $t
    elif $cancel_ts != null and $created != null and $created <= $cancel_ts
      then {status: "cancelled", ts: $cancel_ts}
    else null end;

( [ .[] | select(.task_id == $task) ] ) as $slice
| ( map(.seq) | max ) as $head
| ( [ .[] | select(.event_type == "plan.revised")
      | select(.payload.action == "cancel") | .logical_ts ] | first ) as $cancel_ts
| ( [ $slice[] | select(.event_type == "task.created") ] | length > 0 ) as $exists
| ($slice | first_ts("task.created"))       as $created
| ($slice | terminal($created; $cancel_ts)) as $close
| ($slice | first_ts("task.accepted"))      as $accepted
| ($slice | first_ts("task.result_posted")) as $first_result
| ($slice | last_ts("task.result_posted"))  as $last_result
| ($slice | blocked_upto($first_result))    as $blk_first
| {
    head_seq: $head,
    exists: $exists,
    closed: ($close != null),
    closed_day: (if $close == null then null else ($close.ts | strftime("%Y-%m-%d")) end),
    final_status: ($close.status // null),
    # The WHOLE value is parenthesised, not just each operand — a portability requirement,
    # not style. A bare `//` chain at object-value position was MEASURED as:
    #   jq 1.8.1 (Fedora)       accepts it
    #   jq 1.7.1-apple (macOS)  REJECTS it, failing the ENTIRE program with
    #                           `syntax error, unexpected //, expecting '}'`
    # Both endpoints were observed directly; the exact release that changed is not pinned
    # down, and does not need to be for the parens to be right. One unwrapped chain took
    # out every scoring check on the mac while hive-metrics ran fine beside it, because its
    # equivalent value was already wrapped. Every object value in this file and in
    # hive-metrics is fully wrapped for that reason — keep it that way.
    worker: ( ( [ $slice[] | select(.event_type == "task.reassigned") | .payload.to ] | last )
              // ( [ $slice[] | select(.event_type == "task.accepted") | .actor.id ] | last )
              // "" ),
    # Effort scores accept -> FIRST result_posted, net of blocked time up to that
    # first firing only (retro 3 Verdict 4 / decisions.md 2026-08-01): a revision
    # fired later never moves this. gross_last_s is the full-cycle span (accept ->
    # LAST result_posted, gross) reported beside it for context, never scored.
    net_s: (if $accepted == null or $first_result == null then null
            else ($first_result - $accepted - $blk_first) end),
    gross_last_s: (if $accepted == null or $last_result == null then null
                    else ($last_result - $accepted) end),
    revised: ($first_result != null and $last_result != null and $first_result != $last_result),
    questions: ( [ $slice[] | select(.event_type == "task.reported")
                   | select(.payload.kind == "question") ] | length ),
    review_failed: ( [ $slice[] | select(.event_type == "review.failed") ] | length ),
    reassignments: ( [ $slice[] | select(.event_type == "task.reassigned") ] | length )
  }
JQ

OUT=$(printf '%s' "$EVENTS" | jq -c --arg task "$TASK" "$OUTCOME_JQ")
g() { printf '%s' "$OUT" | jq -r --arg k "$1" '.[$k] // empty'; }

[ "$(g exists)" = "true" ] || die "task '$TASK' is not on the board for run '$RUN' (wrong task or --run?)"
[ "$(g closed)" = "true" ] \
  || die "task '$TASK' is not closed on run '$RUN'; hive-score scores outcomes, so it runs at or after close"

HEAD_SEQ=$(g head_seq)
CLOSED_DAY=$(g closed_day)
FINAL_STATUS=$(g final_status)
ACT_QUESTIONS=$(g questions)
ACT_REVIEW_FAILED=$(g review_failed)
NET_S=$(g net_s)
GROSS_LAST_S=$(g gross_last_s)
REVISED=$(g revised)

if [ -n "$NET_S" ]; then
  ACT_EFFORT=$(awk -v s="$NET_S" 'BEGIN { printf "%.1fh", s / 3600 }')
  ACT_EFFORT_H=$(awk -v s="$NET_S" 'BEGIN { printf "%.4f", s / 3600 }')
  # A revision moves the full-cycle span but never the scored one — report the
  # full cycle beside it so a reader is not left wondering why the task's own
  # calendar time looks longer than the number in this row (decisions.md
  # 2026-08-01: both spans wanted, only the first is worker-performance signal).
  if [ "$REVISED" = "true" ] && [ -n "$GROSS_LAST_S" ]; then
    ACT_EFFORT="$ACT_EFFORT (full cycle, incl. revision: $(awk -v s="$GROSS_LAST_S" 'BEGIN { printf "%.1fh", s / 3600 }'))"
  fi
else
  ACT_EFFORT="no work cycle (never accepted, or no result posted)"
  ACT_EFFORT_H=""
fi

# --- one row per task: resolve the calibration file up front -------------------
# Needed here (not just at append time) because carrying forward a prior human
# verdict and refusing a false clean both have to happen BEFORE the verdict is
# computed below, not after.
OUT_DIR="$OPS_WS/projects/$PROJECT/metrics"
CAL="$OUT_DIR/calibration.md"
# One literal, awk-based occurrence count feeds every downstream decision
# (exists? refuse without --again? how many rows to collapse later?) — a task id
# carrying a BRE metacharacter (the id charset allows ".") must be seen the same
# way by every check, so there is exactly one occurrence-counting expression here,
# not a `grep` now and a separate `awk` at write time that could silently
# disagree on what "already scored" means for that same task id.
PRIOR_COUNT=0
if [ -f "$CAL" ]; then
  PRIOR_COUNT=$(awk -v t="### $TASK — " 'index($0, t) == 1 { c++ } END { print c + 0 }' "$CAL")
fi
PRIOR_ENTRIES=0
[ "$PRIOR_COUNT" -gt 0 ] && PRIOR_ENTRIES=1

if [ "$PRIOR_ENTRIES" -eq 1 ] && [ "$AGAIN" -eq 0 ]; then
  die "task '$TASK' is already scored in $CAL; pass --again to replace it in place"
fi

# find_prior_review_verdict <cal-file> <task> -> the newest human verdict (clean |
# minor rework | rework, case-insensitively matched — legacy rows carry `Clean`)
# recorded in ANY of the task's existing entries, in file order (append-only, so
# file order is chronological). Empty if the task has never carried a human
# verdict, only `unscored`/`unpredicted`.
find_prior_review_verdict() {
  local cal="$1" task="$2"
  [ -f "$cal" ] || return 0
  awk -v t="### $task — " '
    index($0, t) == 1 { inb = 1; next }
    /^### / { inb = 0 }
    inb && /^\| review outcome \|/ {
      # Each row is "| a | b | c | d |" — the trailing "|" makes the LAST field
      # from split() empty, so the verdict (the 4th visible column) sits at parts[n-1].
      n = split($0, parts, "|")
      v = parts[n - 1]
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      lv = tolower(v)
      if (lv == "clean" || lv == "minor rework" || lv == "rework") last = lv
    }
    END { if (last != "") print last }
  ' "$cal"
}

CARRIED_VERDICT=""
if [ -z "$REVIEW_VERDICT" ] && [ "$PRIOR_ENTRIES" -eq 1 ]; then
  CARRIED_VERDICT=$(find_prior_review_verdict "$CAL" "$TASK")
  [ -n "$CARRIED_VERDICT" ] && REVIEW_VERDICT="$CARRIED_VERDICT"
fi

# Retro 3 D2/R3's code twin: `clean` asserts the task's whole post-result review
# cycle went clean, and the spine's own review.failed count can contradict that
# regardless of whether the verdict was just typed or carried forward from an
# older row — so both paths are checked here, in one place, before any write.
if [ "$REVIEW_VERDICT" = "clean" ] && [ "$ACT_REVIEW_FAILED" -gt 0 ]; then
  die "task '$TASK' has review.failed x$ACT_REVIEW_FAILED on the spine; --review clean is refused — use 'minor rework' or 'rework' instead (the verdict covers the task's post-result review cycle, not merely the final artefact)"
fi

# --- the order's Predictions section -------------------------------------------
# The order was resolved up front (it names the project). A closed task with no
# order file at all is a real, and interesting, case: it scores as unpredicted.
# predictions_classify (hive-common.sh) is the SAME parser hive-launch's gate
# calls — a gate that can disagree with the scorer is the defect D1 already was
# — and it sets PRED_EFFORT_TXT/PRED_QUESTIONS_TXT/PRED_REVIEW_TXT/
# PRED_FIELDS_PARSED as a side effect.
PRED_VERDICT="absent"
PRED_EFFORT_TXT=""; PRED_QUESTIONS_TXT=""; PRED_REVIEW_TXT=""; PRED_FIELDS_PARSED=0
if [ -n "$ORDER_REL" ]; then
  predictions_classify "$OPS_WS/$ORDER_REL"
else
  ORDER_REL="(no order file found)"
fi

# parse_range <text> -> "lo hi"; accepts "2", "1-2", "1–2" (en dash), "1—2".
parse_range() {
  printf '%s' "$1" | sed -E 's/[–—]/-/g' | awk -F- '
    { lo = $1 + 0; hi = (NF > 1 ? $2 + 0 : lo); printf "%s %s", lo, hi }'
}

NOT_PREDICTED='*not predicted*'

# --- verdicts -----------------------------------------------------------------
# Effort tolerance is stated in the file header, not hidden here: a prediction
# counts as a hit within the wider of ±0.5h and ±25% of the predicted low bound.
# Anything tighter would manufacture precision the underlying elapsed-time proxy
# does not have.
if [ -n "$PRED_EFFORT_TXT" ]; then
  read -r EFF_LO EFF_HI <<<"$(parse_range "$(printf '%s' "$PRED_EFFORT_TXT" | grep -oE '^[0-9][0-9.–—-]*')")"
  PRED_EFFORT="$PRED_EFFORT_TXT"
  if [ -n "$ACT_EFFORT_H" ]; then
    V_EFFORT=$(awk -v a="$ACT_EFFORT_H" -v lo="$EFF_LO" -v hi="$EFF_HI" 'BEGIN {
      tol = 0.25 * lo; if (tol < 0.5) tol = 0.5;
      if (a < lo - tol)      print "under";
      else if (a > hi + tol) print "over";
      else                   print "hit";
    }')
  else
    V_EFFORT="unscorable (no work cycle)"
  fi
else
  PRED_EFFORT="$NOT_PREDICTED"; V_EFFORT="unpredicted"
fi

# The one narrow override (validated above, before any spine read): the derived
# hit/under/over/unpredicted/unscorable verdict above is replaced, never blended
# with. ACT_EFFORT is left exactly as measured — "retain the measured first-result
# span as context" — only the VERDICT changes, and only for effort; questions and
# review outcome are untouched by this flag.
if [ -n "$EFFORT_UNINTERP" ]; then
  V_EFFORT="uninterpretable ($EFFORT_UNINTERP)"
fi

if [ -n "$PRED_QUESTIONS_TXT" ]; then
  read -r Q_LO Q_HI <<<"$(parse_range "$PRED_QUESTIONS_TXT")"
  PRED_QUESTIONS="$PRED_QUESTIONS_TXT"
  if   [ "$ACT_QUESTIONS" -lt "${Q_LO%.*}" ]; then V_QUESTIONS="under"
  elif [ "$ACT_QUESTIONS" -gt "${Q_HI%.*}" ]; then V_QUESTIONS="over"
  else V_QUESTIONS="hit"; fi
else
  PRED_QUESTIONS="$NOT_PREDICTED"; V_QUESTIONS="unpredicted"
fi

# The spine records review.failed; it does not record "the PR needed two rounds of
# comments". So the review-outcome verdict is a human's to give (--review), and is
# left explicitly unscored otherwise rather than inferred from silence.
ACT_REVIEW="review.failed x$ACT_REVIEW_FAILED on the spine (PR-level rework is not an event)"
if [ -n "$PRED_REVIEW_TXT" ]; then
  PRED_REVIEW="$PRED_REVIEW_TXT"
  V_REVIEW="${REVIEW_VERDICT:-unscored (needs a human verdict: --review)}"
else
  PRED_REVIEW="$NOT_PREDICTED"
  V_REVIEW="${REVIEW_VERDICT:-unpredicted}"
fi

# Coverage: how much of the section was there at all — the calibration-gap
# metric. Absent and unparsed are DIFFERENT strings (D1's whole cost was that
# they read the same to the launch-gate): "nobody predicted" is not "the author
# predicted and we lost it". The declared-unpredicted disposition scores the
# same as unparsed here — the coverage line just counts fields, honestly; a
# reader who wants to know whether it was deliberate reads the order body.
FIELDS=$PRED_FIELDS_PARSED
case "$PRED_VERDICT" in
  absent)   COVERAGE="unpredicted (no \`## Predictions\` section)" ;;
  full)     COVERAGE="full" ;;
  partial*) COVERAGE="partial ($FIELDS of 3 fields predicted; missing: $(predictions_missing_fields))" ;;
  *)        COVERAGE="unpredicted (section present, 0 of 3 fields parsed)" ;;
esac

# --- write ---------------------------------------------------------------------
# CAL/OUT_DIR/PRIOR_ENTRIES were already resolved above (needed for the carry-
# forward and false-clean checks before the verdict was computed).
mkdir -p "$OUT_DIR"

if [ ! -f "$CAL" ]; then
  cat > "$CAL" <<EOF
# Prediction calibration — $PROJECT

One row per task (see below), positioned where that task's row already sits, so this
is not a strictly append-only or chronological file — a rescored task's row does not
move to the bottom. Predictions are quoted verbatim from the task's order file;
outcomes are read from the spine, so an entry says the same thing whether it was
written on the day of the close or months later.

Predictions are honest guesses, never commitments — the product here is the
calibration trend, not any single verdict. Reading that trend is the improver
seat's act; this file only records.

**Verdict rules.** *effort* — \`hit\` when the actual elapsed worker span (net of
answer wait) falls within the predicted range widened by the greater of 0.5h and
25% of its low bound; otherwise \`under\`/\`over\`. *questions* — \`hit\` when the
count falls inside the predicted range, exactly. *review outcome* — never inferred:
the spine records \`review.failed\`, not whether a PR needed another round, so the
verdict stays \`unscored\` until a human supplies one with \`--review\`.

**Revision (decisions.md 2026-08-01).** \`task.result_posted\` marks the CURRENT
REVISION of a task's result — fired at the first complete result, re-fired with a
corrected ref whenever a review revision changes what the report says. Actual
effort is scored against accept -> the FIRST \`result_posted\` only, net of blocked
time up to that first firing (retro 3 Verdict 4) — a later revision never moves
it, because it prices producing the result, not the review cycle that follows.
When a task's result WAS revised, the full-cycle span (accept -> the LAST
\`result_posted\`, gross, portfolio reality) is reported beside the scored figure
in parentheses, for context only — it is never itself scored as effort. A
calibration trend line spanning the date this distinction shipped is comparing
the same single-result number on both sides for every row that predates it: see
hive-metrics' own Method section for the fuller calibration-boundary note.

**\`uninterpretable\`.** One narrow, explicit override for the effort verdict only
(\`--effort-uninterpretable <scope-amendment|host-incident>\`, requiring
\`--note\`): the measured first-result span is retained as context but the verdict
reads \`uninterpretable (<cause>)\` instead of hit/under/over, because the two
decided cause classes leave no trace on the spine for anything here to detect —
this is never inferred from elapsed time, however extreme, only ever set by an
explicit human call. Excluded from any over-prediction factor computed from this
file. Questions and review outcome are untouched by it.

A session that idles looks like a session that works; the scored span is a proxy,
and predictions should be read against it as one.

**One row per task.** \`--again\` replaces a task's entry in place (dropping any
older duplicate rows for the same task) rather than appending a second one. With
no explicit \`--review\`, a replacement carries forward the newest human verdict
already on record for that task; an explicit \`--review\` always overrides it.

EOF
fi

ENTRY_TMP=$(mktemp)
CAL_TMP=""
# Installed the moment the first temp file exists, because every path out of here between
# now and the `mv` below is a `die` — and a die that leaks `calibration.md.XXXXXX` beside
# the real file leaves the operator staring at a directory that looks half-rewritten.
# `${CAL_TMP:+...}` rather than a bare "$CAL_TMP": it is unset until the replace branch
# creates it, and this script runs under `set -u`. The trap can never clobber an intended
# file — CAL_TMP is cleared immediately after a successful `mv`, so the only paths it ever
# names are temp files this script created and does not intend to keep.
trap 'rm -f "$ENTRY_TMP" ${CAL_TMP:+"$CAL_TMP"}' EXIT
{
  echo "### $TASK — closed $CLOSED_DAY"
  echo
  echo "| field | predicted | actual | verdict |"
  echo "|---|---|---|---|"
  echo "| effort | $PRED_EFFORT | $ACT_EFFORT | $V_EFFORT |"
  echo "| questions | $PRED_QUESTIONS | $ACT_QUESTIONS | $V_QUESTIONS |"
  echo "| review outcome | $PRED_REVIEW | $ACT_REVIEW | $V_REVIEW |"
  echo
  echo "- coverage: $COVERAGE"
  echo "- order: \`$ORDER_REL\`"
  echo "- outcome source: run \`$RUN\` at seq $HEAD_SEQ · final status \`$FINAL_STATUS\`"
  if [ -n "$NOTE" ]; then echo "- note: $NOTE"; fi
  echo "- scored: $(date +%F)"
  echo
} > "$ENTRY_TMP"

if [ "$PRIOR_ENTRIES" -eq 1 ]; then
  # In-place replace: the new entry takes the position of the task's LAST existing
  # occurrence (stable relative to every other task's row); any earlier occurrences
  # of the same task are dropped rather than left as stale duplicates. One awk pass:
  # on the Nth (last, per PRIOR_COUNT above) header line, emit the new entry instead
  # of the old one and suppress the old header+body the same way every earlier
  # occurrence's header+body is suppressed. A unique CAL_TMP (not a fixed name) so
  # two hive-score invocations racing on the same project's calibration.md cannot
  # corrupt each other's temp file before either `mv` lands.
  CAL_TMP=$(mktemp "${CAL}.XXXXXX")
  # `if ! awk ...` rather than `awk ... && mv ...`. A command that is not FINAL in an `&&`
  # list is exempt from `set -e`, so a failed awk merely short-circuited the `mv`: the
  # calibration file stayed as it was, the temp file was left behind, and the script fell
  # straight through to the success print below and exited 0. hive-close then reported the
  # task `scored` when nothing had been written. A rewrite that does not happen has to say
  # so, and has to be non-zero.
  if ! awk -v t="### $TASK — " -v total="$PRIOR_COUNT" -v newfile="$ENTRY_TMP" '
    BEGIN { while ((getline l < newfile) > 0) nl[n++] = l }
    /^### / {
      if (index($0, t) == 1) {
        seen++
        intgt = 1
        if (seen == total) { for (i = 0; i < n; i++) print nl[i] }
        next
      } else { intgt = 0 }
    }
    { if (!intgt) print }
  ' "$CAL" > "$CAL_TMP"; then
    die "could not rewrite $CAL (awk failed). The calibration file is UNCHANGED — this
  score was not recorded. Nothing was lost; re-run once the cause is understood."
  fi
  mv "$CAL_TMP" "$CAL" || die "could not move the rewritten calibration into place ($CAL_TMP -> $CAL). The calibration file is UNCHANGED."
  CAL_TMP=""   # moved, not leaked — leave the EXIT trap nothing to remove
  WRITE_VERB="replaced in place (older duplicates dropped)"
else
  cat "$ENTRY_TMP" >> "$CAL"
  WRITE_VERB="appended"
fi
rm -f "$ENTRY_TMP"

echo "hive-score: $TASK — coverage: $COVERAGE"
echo "  effort     predicted $PRED_EFFORT · actual $ACT_EFFORT · $V_EFFORT"
echo "  questions  predicted $PRED_QUESTIONS · actual $ACT_QUESTIONS · $V_QUESTIONS"
echo "  review     predicted $PRED_REVIEW · $V_REVIEW"
if [ -n "$CARRIED_VERDICT" ]; then
  echo "  review verdict carried forward from the newest prior entry: $CARRIED_VERDICT"
fi
echo "  $WRITE_VERB in $CAL"

# Recording the score is part of scoring. The append above is worth nothing to the
# improver until it is committed, so this is one act, not two — and the pathspec
# keeps it to this project's metrics dir.
if [ "$COMMIT" -eq 0 ]; then
  echo "  --no-commit: left uncommitted in $OPS_WS — commit it yourself, or the improver will never see it"
else
  commit_metrics "$PROJECT" "score: $TASK on run $RUN" \
    || die "scored and appended to $CAL, but recording it failed (see above) — the entry is on disk in $OPS_WS; commit and push it by hand"
fi
