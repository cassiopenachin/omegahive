#!/usr/bin/env bash
# hive-routes [--json]                       — the catalog and command check
# hive-routes migrate [--default <name>]     — bring a catalog to the shape this build
#                                              reads, backing it up first
#
# THE CATALOG CHECK — one command, one answer: what this deployment can run right now,
# which route is the worker default, whether each named executable is actually installed,
# and for the ones that cannot resolve, exactly why.
#
# It is the operator's counterpart to `hive-launch --check`. `--check` answers "would
# THIS launch work"; this answers "what is runnable at all", without an order or a task.
# Three things it deliberately does not do:
#
#   * no network call and no model call — safe on a laptop, in a cron, or into a paste;
#   * no change of any kind, and in particular it never enables a route — a report that
#     could fix what it reports would eventually be run for the fixing. `migrate` is the
#     one writing subcommand, it is named, and it backs up before it writes;
#   * no environment value, settings value, or credential is printed. It never receives
#     them, so this is a property of the data path rather than of a redaction pass. The
#     runner's `inherit_env` is printed as NAMES, which is all it ever holds.
#
# What it no longer is: a qualification report. There is no boundary status to show, no
# policy class to tally and no probe verdict to print, because catalog presence plus
# `enabled: true` is the authorization (runner-trust doctrine, 2026-08-20).
#
# Exit 0 whether or not routes are refused: a refused route is the correct answer to a
# question, not an error. Exit 2 only when the catalog cannot be read.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

command -v jq >/dev/null 2>&1 || die "jq is required"

usage() { sed -n '2,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# ---------------------------------------------------------------------------------
# migrate — the production path onto the shape this build reads. TWO migrations, and
# both run: v1 -> v2, and the `worker-turns` cutover WITHIN v2 (dropping
# `runner.worker_io` and the retired hive-worker Codex permission arguments).
#
# Backup first, translate, validate, write atomically, and skip the write entirely when
# nothing changed. Nothing here enables or disables a route, edits an identity, invents a
# price, drops a note, or touches an operator-authored runner argument: the catalog comes
# out saying the same things about the same routes, in the shape this build reads. The one
# thing it may have to ask for is the worker default, and only from a v1 catalog, because
# only v1 lacked the field.
#
# Re-running it is safe and prints so, which is the property that lets an operator who is
# unsure simply run it again.
# ---------------------------------------------------------------------------------
migrate() {
  local default_name="" target="$HIVE_ROUTE_CATALOG"
  while [ $# -gt 0 ]; do
    case "$1" in
      --default) shift; [ $# -gt 0 ] || usage; default_name="$1" ;;
      --catalog) shift; [ $# -gt 0 ] || usage; target="$1" ;;
      *) echo "hive-routes migrate: unknown argument '$1'" >&2; exit 2 ;;
    esac
    shift
  done

  [ -f "$target" ] || die "no route catalog at $target"

  # There is deliberately no "already v2, nothing to do" short-circuit here any more.
  # It was wrong from the moment the `worker-turns` cutover added a WITHIN-v2 migration:
  # a v2 catalog still carrying `runner.worker_io` or the retired hive-worker Codex
  # permission arguments exited zero with "nothing to do" and was then refused by the
  # loader on the very next launch — so the one command an operator is told to run was
  # the one command that could not fix it. The translator decides what needs doing; this
  # script's job is the backup, the validation and the atomic replacement.
  SRC_VERSION="$(jq -r '.schema_version // empty' "$target")"

  # The prompt, and why it is here rather than in the pure translator: v2 requires
  # exactly one `defaults.worker` and v1 recorded no such fact, so with several enabled
  # routes there is a real question only the operator can answer. With exactly one
  # enabled route the translator answers it itself and says so.
  if [ -z "$default_name" ] && [ "$SRC_VERSION" != "2" ]; then
    # Only a v1 catalog can be missing a worker default; a v2 one already has the field,
    # and prompting for it would invite an operator to change a decision they did not come
    # here to change.
    local enabled n
    enabled=$(jq -r '[.routes[] | select(.enabled != false) | .name] | join(" ")' "$target")
    n=$(printf '%s' "$enabled" | wc -w | tr -d ' ')
    if [ "$n" -gt 1 ]; then
      if [ ! -t 0 ]; then
        die "this catalog has $n enabled routes and v2 needs exactly one worker default.
  Re-run with:  hive-routes migrate --default <name>
  Enabled routes: $enabled"
      fi
      echo "hive-routes migrate: $n enabled routes — which one carries an ordinary worker launch?"
      # shellcheck disable=SC2086  # deliberate word splitting: one route name per line
      printf '  %s\n' $enabled
      printf 'default worker route: '
      read -r default_name
      [ -n "$default_name" ] || die "no default chosen; nothing was written"
    fi
  fi

  # Backup BEFORE anything is written, beside the source, timestamped. The operator's
  # rollback is one `cp` and it is named in the output rather than assumed.
  local backup stamp tmp
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  backup="$target.v${SRC_VERSION:-unknown}-$stamp.bak"
  cp -p "$target" "$backup" || die "could not back up $target to $backup"

  tmp="$target.$stamp.tmp"
  if ! hive harness-migrate ${default_name:+--default "$default_name"} < "$target" > "$tmp"; then
    rm -f "$tmp"
    die "migration refused; $target is UNCHANGED (backup at $backup)"
  fi
  # A last read-back, so a file the launcher would refuse never replaces one it accepts.
  if ! jq -e '.schema_version == 2 and (.defaults.worker | type == "string")' "$tmp" >/dev/null; then
    rm -f "$tmp"
    die "the migrated catalog does not look like v2; $target is UNCHANGED (backup at $backup)"
  fi
  # Unchanged means unchanged: a catalog with nothing left to migrate is not rewritten,
  # so its mtime, its formatting and its digest all stay put. An operator who runs this
  # command twice must not see the second run "change" their catalog.
  if cmp -s "$tmp" "$target"; then
    rm -f "$tmp" "$backup"
    echo "hive-routes migrate: $target is already current — nothing to migrate, nothing written."
    return 0
  fi
  mv "$tmp" "$target"
  echo "hive-routes migrate: $target migrated (was schema_version ${SRC_VERSION:-unknown})."
  echo "  backup:   $backup"
  echo "  rollback: cp '$backup' '$target'"
  echo "  check it: hive-routes"
}

case "${1:-}" in
  migrate) shift; migrate "$@"; exit 0 ;;
  -h|--help) usage ;;
esac

AS_JSON=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) AS_JSON="--json" ;;
    *) echo "hive-routes: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

if [ ! -f "$HIVE_ROUTE_CATALOG" ]; then
  # An absent catalog is a real deployment state and gets a real answer, not a stack
  # trace: nothing is launchable, and the operator is told where the file goes.
  echo "hive-routes: no route catalog at $HIVE_ROUTE_CATALOG" >&2
  echo "  Nothing is launchable. The catalog is a DEPLOYMENT fact and is never committed;" >&2
  echo "  create it from schemas/route-catalog.example.json or point HIVE_ROUTE_CATALOG at it." >&2
  exit 2
fi

if [ "$(jq -r '.schema_version // empty' "$HIVE_ROUTE_CATALOG")" = "1" ]; then
  echo "hive-routes: $HIVE_ROUTE_CATALOG is a schema_version 1 catalog." >&2
  echo "  This build reads v2. Migrate it — the original is backed up first:" >&2
  echo "    hive-routes migrate" >&2
  exit 2
fi

# The one question a pure resolver cannot answer: which of the executables the routes
# name are actually installed on THIS host. Answered here and passed in.
PRESENT=$(present_executables_json "$HIVE_ROUTE_CATALOG")

REQ=$(jq -n \
  --arg c "$(b64 "$HIVE_ROUTE_CATALOG")" \
  --argjson present "$PRESENT" \
  '{catalog_b64:$c, present_executables:$present}')

if [ -z "$AS_JSON" ]; then
  echo "hive-routes: catalog $HIVE_ROUTE_CATALOG"
  echo
fi

printf '%s' "$REQ" | hive harness-routes ${AS_JSON:+--json}
