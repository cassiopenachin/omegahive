#!/usr/bin/env bash
# hive-launch <order-file> [--worker <id>]
#
# The launch bookend of the Phase 1 loop (OPERATIONS.md): one judgment — the
# order is ready — collapsed to one command. It seeds the board (task.created +
# worker.registered + task.assigned), issues the worker a per-seat emit wrapper,
# provisions its isolated working trees, and opens a named tmux pane running the
# session with the kickoff pre-filled.
#
# <order-file> may be a bare filename, a path relative to the workspace root, or
# a path under the orders dir. The task id is derived from the filename; the
# worker id defaults to sess-<task>-<MMDD>.
#
# It also refuses an order whose `## Predictions` section is present but does
# not parse (0 of 3 scored fields) — the same parser hive-score uses, so the
# gate can never disagree with the scorer (retro 2026-07-29 D1). An order with
# no section at all, or the one-line declared-unpredicted disposition, launches
# clean; a partial section (1-2 of 3) warns and launches. `--anyway` overrides
# the refusal (same spelling as the review-WIP throttle override below).

# Deliberate redundancy with hive-common.sh:26, which sets exactly the same three
# options during the `source` below. Five production scripts inherited -e, -u and
# pipefail from that ONE line and stated none of them; a refactor that guards it, moves
# it, or wraps the source in a conditional would have quietly stripped error-exit,
# nounset and pipefail from all five at once, and nothing would have failed loudly
# enough to notice. Setting them here is a no-op at runtime and makes each script's own
# contract readable without opening another file.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

usage() {
  cat >&2 <<'USAGE'
usage: hive-launch <order-file> [--worker <id>] [--anyway]
                                [--binding <path>] [--check]
       hive-launch --check-migration

  --binding <path>   the committed launch binding (workspace-relative, or a bare name
                     resolved to projects/<project>/bindings/<task>.json). It carries the
                     operator-signed route; the launcher executes it and never signs one.
  --check            no-model preflight: resolve the binding, adapter, harness version,
                     model pin and redacted environment, print them, and STOP. No clone,
                     no spine write, no token spent.
  --check-migration  enumerate which orders would refuse once HIVE_ENFORCE_BINDINGS=1.
USAGE
  exit 2
}

ORDER_ARG=""
WORKER=""
ANYWAY=""
BINDING_ARG=""
CHECK_ONLY=""
CHECK_MIGRATION=""
while [ $# -gt 0 ]; do
  case "$1" in
    --worker) shift; [ $# -gt 0 ] || usage; WORKER="$1" ;;
    --binding) shift; [ $# -gt 0 ] || usage; BINDING_ARG="$1" ;;
    --check) CHECK_ONLY=1 ;;
    --check-migration) CHECK_MIGRATION=1 ;;
    --anyway) ANYWAY=1 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [ -z "$ORDER_ARG" ] || usage; ORDER_ARG="$1" ;;
  esac
  shift
done

# --- --check-migration: what would refuse if enforcement were on ---------------------
# Record before enforce, applied to the migration itself. This reads the workspace and
# emits nothing, so the operator can see the whole blast radius before flipping the
# switch rather than discovering it one refused launch at a time.
if [ -n "$CHECK_MIGRATION" ]; then
  [ -z "$ORDER_ARG" ] || usage
  missing=0; present=0
  echo "hive-launch --check-migration: HIVE_ENFORCE_BINDINGS is currently '$HIVE_ENFORCE_BINDINGS'"
  echo "  catalog: $HIVE_ROUTE_CATALOG$([ -f "$HIVE_ROUTE_CATALOG" ] && echo '' || echo '   (ABSENT — every binding launch would refuse)')"
  while IFS= read -r f; do
    rel="${f#"$OPS_WS"/}"
    case "$rel" in projects/*/orders/*.md) ;; *) continue ;; esac
    proj=$(project_from_order "$rel")
    tsk=$(task_from_order "$rel")
    b="projects/$proj/$HIVE_BINDINGS_DIR/$tsk.json"
    if [ -f "$OPS_WS/$b" ]; then
      present=$((present + 1))
      echo "  ok      $tsk  ($b)"
    else
      missing=$((missing + 1))
      echo "  REFUSE  $tsk  (no $b)"
    fi
  done < <(find "$OPS_WS/projects" -mindepth 3 -maxdepth 3 -type f -path '*/orders/*' -name '*.md' | sort)
  echo "hive-launch: $present order(s) have a binding, $missing would refuse under enforcement."
  exit 0
fi

[ -n "$ORDER_ARG" ] || usage

# --- resolve the order file to a workspace-relative path -----------------------
# A full workspace-relative path (or a bare filename) is accepted; a bare filename
# is resolved by searching EVERY project's orders dir, refusing cross-project
# collisions. The path must be projects/<name>/orders/<file>.md — that is where the
# project name is read from.
if [ -f "$OPS_WS/$ORDER_ARG" ] && [ "$ORDER_ARG" != "$(basename "$ORDER_ARG")" ]; then
  REL="$ORDER_ARG"
else
  base=$(basename "$ORDER_ARG")
  hits=()
  while IFS= read -r f; do hits+=("${f#"$OPS_WS"/}"); done \
    < <(find "$OPS_WS/projects" -mindepth 3 -maxdepth 3 -type f -path '*/orders/*' -name "$base" 2>/dev/null | sort)
  [ "${#hits[@]}" -ne 0 ] || die "order file not found under any projects/*/orders in $OPS_WS: $ORDER_ARG"
  [ "${#hits[@]}" -eq 1 ] || die "order file '$base' is ambiguous across projects: ${hits[*]}. Name the full path projects/<name>/orders/$base."
  REL="${hits[0]}"
fi

# Infer the project from the path and load its committed identity (RUN_ID,
# CODE_REPO -> RUN, CANON_CODE). Everything downstream — throttle, board reads,
# wrapper, kickoff, clones — acts on THIS project's run, never a global default.
PROJECT=$(project_from_order "$REL")
load_project_conf "$PROJECT"

TASK=$(task_from_order "$REL")
[ -n "$WORKER" ] || WORKER="sess-${TASK}-$(date +%m%d)"

# Both ids flow into a generated shell wrapper (baked identity), tmux window
# names, and filesystem paths. Constrain them to a safe charset so a stray
# metacharacter can neither break nor hijack the worker's write path.
SAFE='^[A-Za-z0-9._-]+$'
[[ "$TASK" =~ $SAFE ]]   || die "unsafe task id derived from order name: '$TASK' (allowed: A-Za-z0-9._-)"
[[ "$WORKER" =~ $SAFE ]] || die "unsafe --worker id: '$WORKER' (allowed: A-Za-z0-9._-)"
# The session name is the third value that flows into a tmux target, and it is
# guarded here — with the ids, before anything is written — so an unsafe name
# refuses a launch outright rather than seeding the board and then seating the
# worker in whatever session tmux resolved instead.
require_safe_tmux_session

WS_ROOT="$WORK_ROOT/$WORKER/hive"
CODE_ROOT="$WORK_ROOT/$WORKER/$PROJECT"   # code clone named after the project (omegahive keeps its historical dir)
WRAPPER="$WRAPPER_DIR/$WORKER.sh"
EXEC_DIR="$WORK_ROOT/$WORKER/execution"   # one run-dir per execution; the supervisor's state
SUP_WRAPPER="$EXEC_DIR/emit.sh"           # the supervisor's instrument write path

# --- the order pin, the kickoff, and the route ---------------------------------------
# All three are resolved HERE, before any decision that mutates something, because
# `--check` must be able to answer "what would this launch do" using the very same code
# the launch uses. A preflight computed from a second, simpler path would eventually
# disagree with the real one, and a gate that can disagree with what it gates is the
# defect retro 2026-07-29 D1 already charged this tooling once.
SHA=$(order_pin "$REL")
resolve_compose

# The kickoff is built before the route so the preflight can show the ACTUAL argv the
# harness would receive, kickoff included (elided in the display, counted in the shape).
read -r -d '' KICKOFF <<KICK || true
You are hive worker $WORKER on task $TASK (run: $RUN).
Your clones: workspace $WS_ROOT · code $CODE_ROOT.
First: git -C $WS_ROOT pull
Your order: $REL in your workspace clone.
Protocol: read projects/omegahive/WORKER.md there first and follow it exactly.
Your emit command is your wrapper: $WRAPPER
It bakes in --run-id/--role worker/--actor $WORKER. Everywhere WORKER.md writes
'hive emit --run-id \$RUN --role worker --actor \$WORKER ...', run '$WRAPPER ...'
with only the remaining flags (--type/--task/--payload). Never use raw hive emit.
Container tooling on this host is '$HIVE_COMPOSE' (resolved at launch; WORKER.md's
setup block writes it as 'podman compose' because deployment #0 runs podman —
use the command named here). Begin by reading both files, then emit
task.accepted and start.
KICK

# --- resolve the signed binding ------------------------------------------------------
# A binding is a committed decision, so it is pinned exactly like an order is: dirty,
# uncommitted, or unpushed all refuse here, BEFORE a clone exists or the spine moves.
# `order_pin` is the shared implementation of "is this really landed" and is reused
# verbatim rather than reimplemented, so the two can never drift apart.
PLAN_JSON=""
BINDING_REL=""
BINDING_SHA=""
if [ -n "$BINDING_ARG" ]; then
  case "$BINDING_ARG" in
    */*) BINDING_REL="$BINDING_ARG" ;;
    *)   BINDING_REL="projects/$PROJECT/$HIVE_BINDINGS_DIR/${BINDING_ARG%.json}.json" ;;
  esac
elif [ -f "$OPS_WS/projects/$PROJECT/$HIVE_BINDINGS_DIR/$TASK.json" ]; then
  BINDING_REL="projects/$PROJECT/$HIVE_BINDINGS_DIR/$TASK.json"
fi

if [ -z "$BINDING_REL" ]; then
  if [ "$HIVE_ENFORCE_BINDINGS" = "1" ]; then
    die "no launch binding for task '$TASK' (looked for projects/$PROJECT/$HIVE_BINDINGS_DIR/$TASK.json) and HIVE_ENFORCE_BINDINGS=1.
  Write and push the binding, or pass --binding <path>. See schemas/launch-binding.example.json.
  'hive-launch --check-migration' lists every order in this state."
  fi
  # The compatibility path, and it is deliberately LOUD. A route is never manufactured
  # from HIVE_WORKER_CMD: that string names an executable, not a model, a vendor, a
  # billing market or a credential pool, and inventing those from it is exactly the
  # collapse this order exists to undo. So a legacy launch records NO execution facts
  # rather than fabricated ones.
  {
    echo "hive-launch: LEGACY LAUNCH — no binding for '$TASK'."
    echo "  Running the deployment string HIVE_WORKER_CMD='$HIVE_WORKER_CMD' with NO supervisor."
    echo "  Consequence: this execution records no route, no model identity, and no token"
    echo "  consumption on the spine. It is invisible to the capacity query by construction."
    echo "  Migrate it: write projects/$PROJECT/$HIVE_BINDINGS_DIR/$TASK.json (schemas/launch-binding.example.json)."
  } >&2
else
  [ -f "$OPS_WS/$BINDING_REL" ] || die "launch binding not found in $OPS_WS: $BINDING_REL"
  BINDING_SHA=$(order_pin "$BINDING_REL")
  [ -f "$HIVE_ROUTE_CATALOG" ] || die "route catalog not found: $HIVE_ROUTE_CATALOG
  This is a DEPLOYMENT fact and is never committed to a project. Create it from
  schemas/route-catalog.example.json, or point HIVE_ROUTE_CATALOG at this host's copy."

  # A pinned session id, derived from the pinned binding, so the supervisor knows where
  # the harness will write its own transcript. Derived rather than random: re-checking
  # the same approved launch must describe the same execution, not a new one.
  SESSION_UUID=$(printf '%s' "$BINDING_REL@$BINDING_SHA" | sha256_hex \
    | sed -E 's/^(.{8})(.{4})(.{3})(.{3})(.{12}).*/\1-\2-4\3-a\4-\5/')

  # The two records travel base64-encoded so their exact bytes reach the digest.
  REQ=$(jq -n \
    --arg b "$(b64 "$OPS_WS/$BINDING_REL")" \
    --arg c "$(b64 "$HIVE_ROUTE_CATALOG")" \
    --arg ref "$BINDING_REL@$BINDING_SHA" \
    --arg task "$TASK" --arg order "$REL@$SHA" \
    --arg kick "$KICKOFF" --arg cwd "$WS_ROOT" --arg sid "$SESSION_UUID" \
    --argjson env "$(jq -n 'env')" \
    '{binding_b64:$b, catalog_b64:$c, binding_ref:$ref, expected_task:$task,
      expected_order_ref:$order, kickoff:$kick, cwd:$cwd, session_id:$sid, env:$env}')

  if [ -n "$CHECK_ONLY" ]; then
    echo "hive-launch --check: task=$TASK worker=$WORKER project=$PROJECT (no side effects)"
    echo "  order:   $REL@$SHA"
    printf '%s' "$REQ" | hive harness-resolve --check | sed 's/^/  /' || exit 1
    # The version probe is the one thing the resolver cannot answer: it must ask the
    # installed harness. Doing it here keeps `--check` a complete preflight — an
    # operator learns that a harness is missing from the check, not from a dead pane.
    VARGV=$(printf '%s' "$REQ" | hive harness-resolve | jq -r '.version_argv | join(" ")')
    printf '  harness: '
    if VOUT=$(sh -c "$VARGV" 2>&1); then
      printf '%s\n' "$(printf '%s\n' "$VOUT" | awk 'NF {print $1; exit}')  (probe: $VARGV)"
    else
      printf 'NOT INSTALLED — `%s` failed:\n' "$VARGV"
      printf '%s\n' "$VOUT" | sed 's/^/    /'
    fi
    exit 0
  fi

  PLAN_JSON=$(printf '%s' "$REQ" | hive harness-resolve) || die "the launch binding was refused; nothing was created or emitted (see the code above)"
  LAUNCHABLE=$(printf '%s' "$PLAN_JSON" | jq -r '.launchable')
  if [ "$LAUNCHABLE" != "true" ]; then
    die "$(printf '%s' "$PLAN_JSON" | jq -r '.unlaunchable_reason')"
  fi
  EXEC_ID=$(printf '%s' "$PLAN_JSON" | jq -r '.execution_id')
fi

if [ -n "$CHECK_ONLY" ]; then
  die "--check needs a binding: there is nothing to preflight on the legacy HIVE_WORKER_CMD path"
fi

# --- review WIP throttle: pace launches to the operator's review debt ---------
# Review is the quality gate; launching faster than results are reviewed just
# grows an unreviewed backlog that no one is reading. Refuse once HIVE_WIP_REVIEW_MAX
# tasks sit in_review, listing them so the operator knows what to drain. `blocked`
# tasks are deliberately NOT counted — that is answer debt (a question awaiting a
# decision), not review debt. `--anyway` overrides for the deliberate exception.
if [ -z "$ANYWAY" ]; then
  # Global across every project with a conf: the limit is the operator's review
  # bandwidth, not any single project's, so an in_review backlog anywhere throttles
  # launches everywhere (OPERATIONS.md; decisions.md 2026-07-21).
  IN_REVIEW=""; IN_REVIEW=$(global_in_review) || IN_REVIEW=""
  N_REVIEW=0
  if [ -n "$IN_REVIEW" ]; then N_REVIEW=$(printf '%s\n' "$IN_REVIEW" | grep -c .); fi
  if [ "$N_REVIEW" -ge "$HIVE_WIP_REVIEW_MAX" ]; then
    {
      echo "hive-launch: refusing to launch '$TASK' — $N_REVIEW task(s) awaiting review across all projects (limit HIVE_WIP_REVIEW_MAX=$HIVE_WIP_REVIEW_MAX):"
      printf '%s\n' "$IN_REVIEW" | sed 's/^/    - /'
      echo "  review is the quality gate; launches must not outrun it."
      echo "  close reviewed work (hive-close) to drain, or override with --anyway."
    } >&2
    exit 1
  fi
fi

# --- decide before we change anything: create, adopt, or refuse ---------------
# hive-launch normally creates a NEW task. Re-emitting task.created for one that
# already exists would be applied wholesale by the reducer — silently regressing
# an owned/in_review/done task to fresh. So an existing task is handled by state:
#
#   absent                        -> create  (seed task.created + register + assign)
#   ready, unowned                -> ADOPT   (register + assign only; NO task.created)
#   assigned|blocked|in_progress  -> refuse; owned/in-flight, recover via task.reassigned (RUNBOOK)
#   in_review|done                -> refuse; already awaiting close / closed — not launchable
#   any other existing state      -> refuse; not launchable
#
# Adopt exists because the entire pre-tooling backlog was seeded (2026-07-10) as
# unowned `ready` tasks via raw task.created — without it, hive-launch could only
# ever launch tasks it created itself. Adopt is the ONE existing-state that
# proceeds, and only from exactly (ready, unowned): it reuses the seeded
# task.created instead of re-emitting one. Recovery of an owned/dead task stays
# the manual task.reassigned path (RUNBOOK) — never a relaunch.
#
# The read below is STRICT (board_json_strict): an unreadable board dies here rather
# than collapsing to the empty string and taking the "absent -> create" branch. That
# collapse was real — `hive-launch` never checked for `jq`, and a missing one turned an
# in_review task into a fresh `task.created` with every guard below bypassed.
ADOPT=""
BOARD_NOW=$(board_json_strict "$RUN")
EXISTING=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .status')
if [ -n "$EXISTING" ]; then
  case "$EXISTING" in
    ready)
      OWNER=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .owner // empty')
      [ -z "$OWNER" ] || die "task '$TASK' is 'ready' but owned by '$OWNER' on run '$RUN' — not adoptable; recover via task.reassigned (RUNBOOK)"
      ADOPT=1 ;;
    assigned|blocked|in_progress)
      die "task '$TASK' is already owned/in-flight on run '$RUN' (status: $EXISTING); relaunch is not recovery — use task.reassigned (RUNBOOK)" ;;
    in_review)
      die "task '$TASK' is already awaiting close on run '$RUN' (status: in_review) — not launchable" ;;
    done)
      die "task '$TASK' is already closed on run '$RUN' (status: done) — not launchable" ;;
    *)
      die "task '$TASK' already exists on run '$RUN' (status: $EXISTING) — not launchable" ;;
  esac
fi

# --- tmux targeting: name the SESSION exactly, never let tmux guess -------------
# Every tmux target below goes through SESSION_T. The `=` prefix forces an EXACT
# session-name match. Without it, tmux falls back to prefix matching when no
# session is named exactly `$HIVE_TMUX_SESSION` — so with the real session gone or
# renamed, a bare `hive` silently matches a session called `hive-scratch` and
# seats the worker there. An exact match, or nothing.
SESSION_T="=$HIVE_TMUX_SESSION"

# Clobber guards: never overwrite an existing clone or a same-named live pane.
# tmux is checked here, BEFORE any board write — a missing tmux is a knowable
# failure, and knowable failures belong on this side of the spine seeding.
command -v tmux >/dev/null 2>&1 \
  || die "tmux not found on PATH — the pane is the task registry, so a launch without tmux cannot complete"
[ ! -e "$WS_ROOT" ]   || die "$WS_ROOT already exists; pick a fresh --worker id or clear it"
[ ! -e "$CODE_ROOT" ] || die "$CODE_ROOT already exists; pick a fresh --worker id or clear it"
# The one collision that still means something: a window already NAMED for this
# task. The pane name is the registry (no registry file), so a second window for
# one task would corrupt the registry — refuse, and name the recovery path.
if tmux has-session -t "$SESSION_T" 2>/dev/null \
   && tmux list-windows -t "$SESSION_T" -F '#{window_name}' 2>/dev/null | grep -qxF "$TASK"; then
  die "a tmux window named '$TASK' already exists in session '$HIVE_TMUX_SESSION' — the pane IS the registry, so this task already has a session.
  Look first: tmux attach -t '$HIVE_TMUX_SESSION', then select the '$TASK' window.
  If that worker is dead, recover per RUNBOOK 'Dead worker recovery' — kill the pane, register a fresh worker id, emit task.reassigned.
  Never a second window for one task."
fi

# --- build the seed payloads ----------------------------------------------------
# SHA was pinned above, before the route was resolved, because the binding is verified
# AGAINST it: a binding signed for an older pin must refuse rather than launch against
# an order that has since changed. The pin is required in BOTH modes — the worker's
# fresh clone comes from the hub, so the order must be committed+pushed there for it to
# be readable. In adopt mode SHA is the order at HEAD, not the acceptance ref: the
# adopted task keeps its original (seeded) task.created acceptance pin.
ACCEPTANCE="per $REL@$SHA"
# A heading-less order file is a titling problem, not a launch failure. Without
# the `|| true` the no-match `grep` fails the whole pipeline under `set -o
# pipefail`, aborting the script one line ABOVE its own fallback — which made
# that fallback dead code. The title is an advisory board label; the order file
# at its pin is what the worker actually reads.
TITLE=$( { grep -m1 -E '^# ' "$OPS_WS/$REL" | sed -E 's/^# +//; s/^Order: *//'; } || true )
[ -n "$TITLE" ] || TITLE="$TASK"
TASK_TYPE="task"   # advisory label only; not gated (events/types.py). Edit freely.

# --- predictions launch-gate: refuse an unparseable, never an absent, section --
# retro 2026-07-29 D1: the gate used to be a human reading a `## Predictions`
# HEADING while hive-score parsed bullet LABELS underneath it, so a mislabeled
# section (or a re-worded one) scored `unpredicted` with no error anywhere — the
# whole tenant project's first wave was lost exactly this way. predictions_classify
# (hive-common.sh) is the SAME parser hive-score uses; a gate that can disagree
# with the scorer is the defect this order exists to retire.
predictions_classify "$OPS_WS/$REL"
case "$PRED_VERDICT" in
  unparsed)
    if [ -z "$ANYWAY" ]; then
      {
        echo "hive-launch: refusing to launch '$TASK' — its '## Predictions' section does not parse (0 of 3 scored fields)."
        echo "  hive-score parses these bullet labels verbatim, case-insensitively, and nothing else"
        echo "  (design-partner PROTOCOL.md order-authoring rules — copy exactly):"
        echo "    - Expected effort: <range> — <median x multiplier, justified>"
        echo "    - Expected questions: <count or range> — <named seams, or a designed round-trip>"
        echo "    - Expected review outcome: <clean | minor rework | rework> — <why>"
        echo "    - Named risks: <what could turn the shape of the work>   (required by protocol; not scored)"
        echo "  The section as written in $REL:"
        predictions_block "$OPS_WS/$REL" | sed 's/^/    /'
        echo "  This order would score PERMANENTLY unpredicted with no error anywhere (retro 2026-07-29 D1)."
        echo "  Fix the labels, or launch it deliberately unpredicted this way: --anyway"
      } >&2
      exit 1
    fi
    echo "hive-launch: --anyway — launching '$TASK' despite an unparseable predictions section."
    ;;
  partial*)
    N="${PRED_VERDICT#partial }"
    echo "hive-launch: WARNING '$TASK' predicts only $N of 3 scored fields (missing: $(predictions_missing_fields))." >&2
    echo "  Launching anyway — partial coverage is a metric hive-score already reports." >&2
    ;;
  absent|declared-unpredicted|full) : ;;   # nothing to say — a clean launch
esac

echo "hive-launch: task=$TASK worker=$WORKER  project=$PROJECT${ADOPT:+  (adopting existing ready task)}"
echo "  order:  $REL@$SHA"
echo "  run:    $RUN"

# --- provision first, emit second ---------------------------------------------
# The failure-prone work (clones) runs BEFORE any board write, so a clone failure
# leaves NO orphaned board state: clear the partial clone and re-run cleanly.
# hive clone: from the local hub. code clone: from the project's local canonical
# checkout CANON_CODE (hardlinked objects, no network, any size), then re-point
# origin at the project's CODE_REPO (the committed conf fact) so PR pushes land
# there; `git pull` inside still fetches main correctly.
[ -d "$CANON_CODE" ] || die "canonical code checkout for '$PROJECT' not found on this host: $CANON_CODE (set CANON_CODE or CANON_ROOT)"
mkdir -p "$WORK_ROOT/$WORKER"
git clone --quiet "$WS_HUB" "$WS_ROOT"       || die "failed to clone workspace from $WS_HUB"
git clone --quiet "$CANON_CODE" "$CODE_ROOT" || die "failed to clone code from $CANON_CODE"
git -C "$CODE_ROOT" remote set-url origin "$CODE_REPO"
echo "  clones: $WS_ROOT  +  $CODE_ROOT (origin -> $CODE_REPO)"

# Issue the per-seat emit wrapper (proto-credential): one file per identity,
# issued at launch, revocable by deletion; role and actor baked in, not
# parameters — swapping this for a real per-seat key later changes nothing
# worker-facing (OPERATIONS.md Phase 2 gate). WORKER/RUN are charset-validated.
mkdir -p "$WRAPPER_DIR"
# The compose command is resolved HERE, at issuance, and baked in like the
# identity is — the wrapper is a standalone file that must not have to source
# anything. OMEGAHIVE_COMPOSE still overrides at run time, so a host that
# changes runtime after a launch does not strand its live wrappers.
resolve_compose
cat > "$WRAPPER" <<WRAP
#!/usr/bin/env bash
# Emit wrapper for worker $WORKER on run $RUN (proto-credential — issued by
# hive-launch, revoke by deleting this file). --run-id/--role/--actor are baked
# in; pass only --type/--task/--payload. Never emit as another actor.
set -euo pipefail
COMPOSE="\${OMEGAHIVE_COMPOSE:-$HIVE_COMPOSE}"
# \`cd\` rather than \`env -C\`: -C is GNU coreutils >= 8.28 and does not exist on
# macOS or the BSDs, so every wrapper issued to a non-GNU host failed at first use.
# A subshell-free cd is exactly equivalent and portable everywhere.
cd "${OMEGA_DIR}" || { echo "wrapper: cannot enter ${OMEGA_DIR}" >&2; exit 1; }
# shellcheck disable=SC2086  # COMPOSE is legitimately two words ("podman compose")
exec \$COMPOSE run --rm -T cli \\
  emit --run-id "$RUN" --role worker --actor "$WORKER" "\$@"
WRAP
chmod +x "$WRAPPER"
echo "  wrapper: $WRAPPER"

# The supervisor's OWN write path, issued the same way and deliberately NOT the
# worker's. It is baked with `--role instrument`, so the process that watches a session
# is structurally incapable of speaking for it: the gateway authorizes `instrument` for
# `execution.*` and for no `task.*` event at all. A worker cannot author its own
# consumption facts, and the supervisor cannot author the worker's results.
if [ -n "$PLAN_JSON" ]; then
  mkdir -p "$EXEC_DIR"
  cat > "$SUP_WRAPPER" <<SUPWRAP
#!/usr/bin/env bash
# Instrument emit wrapper for the supervisor of worker $WORKER on run $RUN.
# --run-id/--role/--actor are baked in; pass only --type/--task/--payload.
# role=instrument: this identity may emit execution.* and NOTHING task-shaped.
set -euo pipefail
COMPOSE="\${OMEGAHIVE_COMPOSE:-$HIVE_COMPOSE}"
cd "${OMEGA_DIR}" || { echo "supervisor wrapper: cannot enter ${OMEGA_DIR}" >&2; exit 1; }
# shellcheck disable=SC2086  # COMPOSE is legitimately two words ("podman compose")
exec \$COMPOSE run --rm -T cli \\
  emit --run-id "$RUN" --role instrument --actor "supervisor-$WORKER" "\$@"
SUPWRAP
  chmod +x "$SUP_WRAPPER"
  printf '%s\n' "$PLAN_JSON" | jq --arg cwd "$WS_ROOT" '. + {cwd: $cwd}' > "$EXEC_DIR/plan.json"
  echo "  execution: $EXEC_ID  (run-dir $EXEC_DIR)"
fi

assigned_payload=$(jq -cn --arg w "$WORKER" '{worker:$w}')
registered_payload=$(jq -cn --arg w "$WORKER" '{worker_id:$w}')

# --- the route fact, BEFORE task.assigned -------------------------------------
# Ordering is the point, not a detail. `execution.route_approved` is the operator's
# signature on a spend decision, and it must be on the spine before the task is handed
# to anyone — so that a task can never be found to have been worked without a recorded,
# attributable decision about what would work it. It is emitted as `human`, by the
# operator actor, because the launcher executes a signed intent and never signs one.
if [ -n "$PLAN_JSON" ]; then
  route_payload=$(printf '%s' "$PLAN_JSON" | jq -c \
    '{execution_id, purpose, attempt, binding_ref, catalog_digest, identity,
      predicted_total_tokens, price_basis}')
  emit human "$OPERATOR_ACTOR" execution.route_approved --task "$TASK" \
    --payload "$route_payload" >/dev/null
  echo "  route:  $(printf '%s' "$PLAN_JSON" | jq -r '.identity.model + " @ " + .identity.harness + " (" + .identity.billing_market + ", pool " + .identity.credential_pool + ")"')"
fi

# Two seeding modes. Create: task.created -> ready, then register + assign.
# Adopt: the task is ALREADY `ready` (unowned) from its seeded task.created —
# re-emitting one would regress it, so we emit ONLY register + assign. Order
# matters in both: registered -> roster (assign's target must be registered),
# assigned -> owned.
if [ -n "$ADOPT" ]; then
  emit human "$OPERATOR_ACTOR" worker.registered              --payload "$registered_payload" >/dev/null
  emit coordinator "$OPERATOR_ACTOR" task.assigned --task "$TASK" --payload "$assigned_payload" >/dev/null
  echo "  adopted: existing ready task -> worker.registered + task.assigned (no task.created)"
  echo "  caveat: acceptance stays the seeded task.created pin, which may be STALE against $REL@$SHA at HEAD;"
  echo "          the worker reads the order at HEAD (WORKER.md), so this is protocol-consistent — just be aware."
else
  created_payload=$(jq -cn --arg t "$TITLE" --arg ty "$TASK_TYPE" --arg a "$ACCEPTANCE" \
    '{title:$t, task_type:$ty, acceptance:$a}')
  emit human "$OPERATOR_ACTOR" task.created     --task "$TASK" --payload "$created_payload"    >/dev/null
  emit human "$OPERATOR_ACTOR" worker.registered              --payload "$registered_payload" >/dev/null
  emit coordinator "$OPERATOR_ACTOR" task.assigned --task "$TASK" --payload "$assigned_payload" >/dev/null
  echo "  seeded: task.created + worker.registered + task.assigned"
fi


# The spine is seeded above and the pane is opened below, and that order is
# deliberate: the worker's very first act is `task.accepted`, which the board
# rejects unless the task already exists and is assigned to it. Creating the
# window first would race a live session against its own ownership. So the window
# stays last — and a failure there is made SAFE rather than reordered away: it
# strands a half-launch (task owned on the board, clones and wrapper on disk, no
# session, kickoff never delivered), which on 2026-07-27 took WORKER.md plus the
# launch output to reconstruct by hand. The launcher prints that reconstruction
# itself, and externalizes the kickoff so it does not live only in a terminal.
half_launch_recovery() {  # half_launch_recovery <what-failed>
  local kf="$WORK_ROOT/$WORKER/kickoff.txt"
  printf '%s' "$KICKOFF" > "$kf" 2>/dev/null || kf=""
  {
    echo
    echo "hive-launch: HALF-LAUNCHED — $1 failed AFTER the board was seeded."
    echo
    echo "  Already done:  board seeded on run '$RUN' (task '$TASK' is owned by '$WORKER')"
    echo "                 clones   $WS_ROOT  +  $CODE_ROOT"
    echo "                 wrapper  $WRAPPER"
    echo "  Still missing: the tmux window, and delivery of the kickoff below."
    echo
    echo "  Do NOT re-run hive-launch: the task is owned now, so it will refuse."
    echo "  Finish it by hand (WORKER.md section Launch) — either is complete:"
    echo
    if [ -n "$kf" ]; then
      echo "  (a) retry just the pane:"
      echo "        tmux new-window -a -t '$SESSION_T:{end}' -n '$TASK' -c '$WS_ROOT' \\"
      echo "          -e HIVE_KICKOFF=\"\$(cat '$kf')\" '$HIVE_WORKER_CMD \"\$HIVE_KICKOFF\"'"
      echo "      If the session itself is gone ('can't find session'), create it instead:"
      echo "        tmux new-session -d -s '$HIVE_TMUX_SESSION' -n '$TASK' -c '$WS_ROOT' \\"
      echo "          -e HIVE_KICKOFF=\"\$(cat '$kf')\" '$HIVE_WORKER_CMD \"\$HIVE_KICKOFF\"'"
    fi
    echo "  (b) fallback if tmux itself is the problem — run the session in any terminal and"
    echo "      paste the kickoff below as its first message:"
    echo "        cd '$WS_ROOT' && $HIVE_WORKER_CMD"
    if [ -n "$kf" ]; then
      echo "      Prefer (a): the pane name is the task registry, and (b) leaves no pane."
    fi
    echo
    echo "  If you would rather abandon this seat, recover per RUNBOOK 'Dead worker recovery'"
    echo "  (register a fresh worker id, then task.reassigned — never a relaunch)."
    echo
    if [ -n "$kf" ]; then echo "  Kickoff (also written to $kf):"; else echo "  Kickoff:"; fi
    echo "  --------------------------------------------------------------------"
    printf '%s\n' "$KICKOFF" | sed 's/^/  /'
    echo "  --------------------------------------------------------------------"
  } >&2
  exit 1
}

# Open the pane. The kickoff travels as an env var (HIVE_KICKOFF) so no multi-line
# text is ever quoted onto a command line; the window runs the worker command with
# it as the initial prompt. The pane NAME is the registry — no registry file.
#
# Allocation is name-only: we supply the session and the window NAME, never an
# index. `-t <name>` alone cannot express that — it is a target-WINDOW, so tmux
# first hunts for a window matching <name> in whatever session happens to be
# "current" (exact name, then name-prefix, then fnmatch) and only then falls back
# to <name> as a session. Worker windows are named after task ids, so a task id
# that starts with the session name — `hive-metrics` in the `hive` session,
# 2026-07-27 — makes `-t hive` resolve to THAT window and its concrete index, and
# the launch dies with `create window failed: index N in use`. The trap is not the
# index we chose (we never chose one); it is having let tmux choose a target.
# It reads as intermittent because it needs EXACTLY ONE match: with two `hive-*`
# windows open the prefix match is ambiguous, tmux abandons it and falls back to
# the session, and the very same command succeeds. Do not trust a passing launch
# as evidence that a bare `-t <session>` is safe.
#   * `$SESSION_T:` — exact session, and the colon makes the target a session, so
#     no window name can shadow it.
#   * `-a -t ...:{end}` — insert AFTER the highest-numbered window, i.e. append.
#     The next slot past the last window is free by construction, so an occupied
#     index is unreachable; and appending past {end} (rather than after the
#     current window) never renumbers an existing window. Verified on tmux 3.5a
#     under the operator config (base-index 1, renumber-windows on) and under
#     stock defaults (base-index 0, renumber off) — the result holds either way.
# The pane runs the SUPERVISOR, not the harness directly — that is what makes the
# execution facts instrument observations rather than self-report. The supervisor reads
# the run-dir, execs the adapter's argv VECTOR, and emits started/finished around it.
# Note what is no longer on this command line in the bound case: no kickoff env var and
# no interpolated worker command. The kickoff is one argv element inside plan.json, so
# no prompt, path, or model id is ever quoted onto a line a shell will parse.
#
# The legacy branch keeps the old string form verbatim. It stays reachable, and it stays
# LOUD: a launch with no binding announced itself as LEGACY above and records no
# execution facts rather than facts invented from HIVE_WORKER_CMD.
if [ -n "$PLAN_JSON" ]; then
  launch_cmd="$SCRIPT_DIR/hive-supervise '$EXEC_DIR'"
else
  launch_cmd="$HIVE_WORKER_CMD \"\$HIVE_KICKOFF\""
fi
if tmux has-session -t "$SESSION_T" 2>/dev/null; then
  PANE=$(tmux new-window -a -t "$SESSION_T:{end}" -n "$TASK" -c "$WS_ROOT" \
    -e HIVE_KICKOFF="$KICKOFF" -P -F '#{session_name}:#{window_index}' "$launch_cmd") \
    || half_launch_recovery "tmux new-window"
else
  PANE=$(tmux new-session -d -s "$HIVE_TMUX_SESSION" -n "$TASK" -c "$WS_ROOT" \
    -e HIVE_KICKOFF="$KICKOFF" -P -F '#{session_name}:#{window_index}' "$launch_cmd") \
    || half_launch_recovery "tmux new-session"
fi
# Report where it actually landed (-P), not where we assumed: the index is tmux's
# to choose, so the launcher reads it back rather than predicting it.
echo "  pane:   $PANE  window '$TASK'  (attach: tmux attach -t $HIVE_TMUX_SESSION)"
echo "hive-launch: done."
