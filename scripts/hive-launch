#!/usr/bin/env bash
# hive-launch <order-file> [--route <name>] [--model <id>] [--worker <id>] [--check]
#
# The launch bookend of the Phase 1 loop (OPERATIONS.md): one judgment — the
# order is ready — collapsed to one command. It resolves a route from the
# operator-owned deployment catalog, provisions the worker ONE task root, issues the
# worker its run-local interface (an emit wrapper, an instrument wrapper and a
# workspace-sync/publication wrapper), seeds the board (task.created +
# worker.registered + task.assigned), and opens a named tmux window running an
# INTERACTIVE harness session with the kickoff delivered as its first message.
#
# The window is the point. A worker sits in a session the operator can type into; it
# invokes its own cross-harness review, repairs its own CI and posts its own result from
# inside that one session, and `hive-answer` nudges it with `send-keys`. Batch turns and
# native resume left the production path on 2026-08-23 (`2026-08-23-direction.md` §3)
# after they cost a wave: the machinery could describe a launch it could not perform.
#
# A route is a SHAPE — harness, sandbox, credential pool — and `runner.args` is the
# argv template that shape needs, with `{{model}}`, `{{sandbox}}`, `{{task_root}}`,
# `{{ws_root}}`, `{{code_root}}`, `{{ws_hub}}` and `{{canon}}` substituted here. That is
# what lets one row describe `claude` on the host, `codex` under its own landlock
# profile, and `sbx run` against a microVM, without this script knowing what any of them
# are. The one thing it does know is `sbx`, and only to CREATE the sandbox a route names
# before re-attaching to it — see the sandbox section below for why that cannot be argv.
#
# THE CATALOG IS THE AUTHORIZATION (runner-trust doctrine, 2026-08-20). With no
# `--route`, the catalog's one `defaults.worker` route carries the launch; `--route`
# is an operator override for THIS launch and writes nothing. There is no per-order
# binding file, no descriptor digest, no probe, no promotion state and no migration
# mode. What still refuses is the cheap deterministic set: malformed configuration, an
# absent or ambiguous default or route, an unknown adapter name, a missing executable.
#
# <order-file> may be a bare filename, a path relative to the workspace root, or
# a path under the orders dir. The task id is derived from the filename; the
# worker id defaults to sess-<task>-<MMDD>.
#
# It also refuses an order whose `## Predictions` section is present but does
# not parse (0 of 3 scored fields) — the same parser hive-score uses, so the
# gate can never disagree with the scorer (retro 2026-07-29 D1). An order with
# no section at all, or the one-line declared-unpredicted disposition, launches
# clean; a partial section (1-2 of 3) warns and launches. `--anyway` overrides
# the refusal (same spelling as the review-WIP throttle override below).

# Deliberate redundancy with hive-common.sh:26, which sets exactly the same three
# options during the `source` below. Five production scripts inherited -e, -u and
# pipefail from that ONE line and stated none of them; a refactor that guards it, moves
# it, or wraps the source in a conditional would have quietly stripped error-exit,
# nounset and pipefail from all five at once, and nothing would have failed loudly
# enough to notice. Setting them here is a no-op at runtime and makes each script's own
# contract readable without opening another file.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Where this script REALLY lives, symlinks resolved. SCRIPT_DIR above is deliberately not
# resolved — it is how the sibling library is sourced, and on this deployment `~/bin` holds a
# symlink per script, so both names work there. Repository ASSETS are different: they are not
# symlinked one by one, so `$SCRIPT_DIR/../kits` becomes `~/kits` when the launcher is invoked
# by its PATH name, which is how OPS.md tells an operator to invoke it. Measured 2026-09-08,
# on the first reassign: the kit refusal fired naming `/home/cassio/bin/../kits/agy`. Every
# test until then had run `./scripts/hive-launch` directly, where the two agree.
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

usage() {
  cat >&2 <<'USAGE'
usage: hive-launch <order-file> [--route <name>] [--model <id>] [--worker <id>]
                                [--check] [--anyway]
       hive-launch <order-file> --reassign [--reason "<why>"] [--route <name>] ...

  --route <name>     run this launch on the named catalog route instead of the
                     catalog's defaults.worker. An operator override for ONE launch:
                     it creates and amends nothing.
  --model <id>       run this launch on a model other than the route's default. The
                     route is the SHAPE (harness, sandbox, credential pool); the model
                     is a value inside it, and the one that is recorded is the one that
                     actually ran. For an OpenRouter route the provider pin travels
                     inside this string: <model>@preset/<slug>.
  --check            no-model preflight: resolve the route, print the identity, the
                     argv, the inherited environment NAMES and the installed harness
                     version, and STOP. No clone, no spine write, no token spent.
  --anyway           override the review-WIP throttle and the predictions gate.
  --reassign         recover a task stranded at assigned|blocked|in_progress onto a
                     fresh worker: provision a new task root, clones, wrappers, sandbox
                     and window, then emit worker.registered + task.reassigned. It is
                     NOT a relaunch — no task.created, no task.assigned — and the dead
                     window must already be gone. Takes the same order file as a launch,
                     because everything downstream (project, run, pin, kickoff, code
                     repo) is resolved from it; a bare task id would need a second
                     lookup that could disagree with the first.
  --reason "<why>"   recorded on task.reassigned.

hive-launch --turn <turn-dir> still runs one prepared batch turn, and nothing on this
path writes one any more: the production lifecycle is an interactive window
(2026-08-23-direction.md §3). It is retained, unused, for a turn directory an earlier
build left behind; its deletion is a later cleanup, not this script's business.
USAGE
  exit 2
}

# --- the turn mode ------------------------------------------------------------------
# Handled here, before anything else parses, because a turn takes a directory and no
# order: everything it needs was already resolved and written by whoever prepared it.
if [ "${1:-}" = "--turn" ]; then
  [ $# -eq 2 ] || usage
  run_turn "$2"
  exit $?
fi

ORDER_ARG=""
WORKER=""
ANYWAY=""
ROUTE_ARG=""
MODEL_ARG=""
CHECK_ONLY=""
REASSIGN=""
REASSIGN_REASON=""
while [ $# -gt 0 ]; do
  case "$1" in
    --worker) shift; [ $# -gt 0 ] || usage; WORKER="$1" ;;
    --route) shift; [ $# -gt 0 ] || usage; ROUTE_ARG="$1" ;;
    --model) shift; [ $# -gt 0 ] || usage; MODEL_ARG="$1" ;;
    --check) CHECK_ONLY=1 ;;
    --anyway) ANYWAY=1 ;;
    --reassign) REASSIGN=1 ;;
    --reason) shift; [ $# -gt 0 ] || usage; REASSIGN_REASON="$1" ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [ -z "$ORDER_ARG" ] || usage; ORDER_ARG="$1" ;;
  esac
  shift
done

[ -n "$ORDER_ARG" ] || usage

# --- resolve the order file to a workspace-relative path -----------------------
# A full workspace-relative path (or a bare filename) is accepted; a bare filename
# is resolved by searching EVERY project's orders dir, refusing cross-project
# collisions. The path must be projects/<name>/orders/<file>.md — that is where the
# project name is read from.
if [ -f "$OPS_WS/$ORDER_ARG" ] && [ "$ORDER_ARG" != "$(basename "$ORDER_ARG")" ]; then
  REL="$ORDER_ARG"
else
  base=$(basename "$ORDER_ARG")
  hits=()
  while IFS= read -r f; do hits+=("${f#"$OPS_WS"/}"); done \
    < <(find "$OPS_WS/projects" -mindepth 3 -maxdepth 3 -type f -path '*/orders/*' -name "$base" 2>/dev/null | sort)
  [ "${#hits[@]}" -ne 0 ] || die "order file not found under any projects/*/orders in $OPS_WS: $ORDER_ARG"
  [ "${#hits[@]}" -eq 1 ] || die "order file '$base' is ambiguous across projects: ${hits[*]}. Name the full path projects/<name>/orders/$base."
  REL="${hits[0]}"
fi

# Infer the project from the path and load its committed identity (RUN_ID,
# CODE_REPO -> RUN, CANON_CODE). Everything downstream — throttle, board reads,
# wrapper, kickoff, clones — acts on THIS project's run, never a global default.
PROJECT=$(project_from_order "$REL")
load_project_conf "$PROJECT"

TASK=$(task_from_order "$REL")
# A reassign needs an id the stranded worker cannot already own. Same-day recovery is the
# common case — the seat died hours ago, not weeks — so the date alone would regenerate the
# stranded worker's own id, collide with its task root at the clobber guard below, and (if it
# somehow got past that) be refused by the board, which does not re-register a known worker.
if [ -n "$WORKER" ]; then :
elif [ -n "$REASSIGN" ]; then WORKER="sess-${TASK}-$(date +%m%d)-r$(date +%H%M%S)"
else                          WORKER="sess-${TASK}-$(date +%m%d)"
fi

# Both ids flow into a generated shell wrapper (baked identity), tmux window
# names, and filesystem paths. Constrain them to a safe charset so a stray
# metacharacter can neither break nor hijack the worker's write path.
SAFE='^[A-Za-z0-9._-]+$'
[[ "$TASK" =~ $SAFE ]]   || die "unsafe task id derived from order name: '$TASK' (allowed: A-Za-z0-9._-)"
[[ "$WORKER" =~ $SAFE ]] || die "unsafe --worker id: '$WORKER' (allowed: A-Za-z0-9._-)"
# The session name is the third value that flows into a tmux target, and it is
# guarded here — with the ids, before anything is written — so an unsafe name
# refuses a launch outright rather than seeding the board and then seating the
# worker in whatever session tmux resolved instead.
require_safe_tmux_session

# --- the task root, and the one thing that must never be inside it -------------------
# ONE root per worker, holding both clones and the run-local interface files. A route's
# native sandbox or external wrapper can scope the worker to exactly this directory; Hive
# records the resolved configuration and does not claim that a direct same-user route is
# isolated by it.
#
# Everything a worker and its turns need lives inside this ONE root, including the
# run-local turn state. That state is RECOVERY AND PROVENANCE EVIDENCE — the retained
# structured stream, the cursor, the classification — and it is described as such rather
# than as a boundary: the worker can write to it, and what actually stops a worker from
# authoring its own execution facts is the gateway's role policy, on the far side of the
# CLI, where a worker-role emit of `execution.*` is refused whatever the wrapper says.
TASK_ROOT="$WORK_ROOT/$WORKER"
WS_ROOT="$TASK_ROOT/hive"
CODE_ROOT="$TASK_ROOT/$PROJECT"           # code clone named after the project (omegahive keeps its historical dir)
RUN_DIR="$TASK_ROOT/run"                  # run-local interface: wrappers + one dir per turn
WRAPPER="$RUN_DIR/emit"                   # the worker's own emit command, inside its root
BRIDGE="$RUN_DIR/hive"                    # the worker's sync/publish command
CLI_SRC="$TASK_ROOT/cli"                  # sandboxed routes only: tracked-files-only clone the in-VM CLI is built from
CODE_BRANCH="worker/$TASK"                # the publication branch, fixed by the plan

# --- how an opencode worker is tuned, for the routes that run one ----------------------
# Two numbers and a model id, here rather than in the catalog, because neither is a fact
# about any one route. The limit was derived from a measurement ACROSS routes and orders,
# and a per-route knob would invite exactly the drift that makes those routes
# incomparable; the compaction model is infrastructure, not the thing under test. Both are
# overridable for a drill or a deliberate experiment, and both are printed at launch, so
# "configured in code" does not mean "invisible".
#
# 250,000 rather than something larger. Without an explicit limit opencode never compacts
# at all — every default-config run in the 2026-09-10 canary grew monotonically, one of
# them to 403,200 tokens — so this single number is the difference between the harness
# that was measured and the harness that is deployed. A HIGH threshold would make
# degradation unfalsifiable: only complex orders reach 800K, so a failure there cannot be
# told apart from the order simply being hard. A lower one is crossed by simple orders
# too, which breaks that correlation and makes the question answerable. Field reports put
# mild DeepSeek degradation near 250K, and across 37 real worker orders measured on this
# host peak context ran median 440K, p75 573K, p90 742K, max 962K — so this WILL compact
# a typical order once or twice. That is intended, and it is why the plugin exists.
: "${HIVE_OPENCODE_CONTEXT_LIMIT:=250000}"
# Compaction is the one artifact that must survive the rewrite, so it is not written by
# the cheap model under test. Summarising a transcript is far easier than the work that
# produced it, and this fires once or twice per order, so the cost is noise. Addressed
# through the route's OWN provider block, so it costs one credential and no second route.
: "${HIVE_OPENCODE_COMPACTION_MODEL:=anthropic/claude-sonnet-5}"

# --- what the WORKER is told to type, as against where the files live -----------------
# The paths above are task-specific and absolute; the commands below are neither. A
# worker's turn starts in a CLONE ROOT — `hive/` on the initial turn, and a native resume
# preserves that cwd — and both clones are siblings of `run/` inside the one task root:
#
#   <task-root>/hive        workspace clone   <- turn cwd
#   <task-root>/<project>   code clone
#   <task-root>/run         emit, emit-instrument, hive
#
# so `../run/emit` and `../run/hive` resolve from EITHER clone root and are the same two
# tokens for every task. That is what lets one operator-approved runner rule cover every
# launch: a prompt naming a task-specific absolute path forces a rule per task root, and
# the next task necessarily falls out of it (capacity-view could not publish, 2026-08-21).
# The relative contract therefore depends on the turn cwd being a clone root — anything
# that moves it must change these tokens with it. They are separate variables from
# WRAPPER/BRIDGE on purpose: operator output and half-launch recovery still name the real
# files, because those are instructions for a human standing on this host.
WORKER_EMIT="../run/emit"                 # what the worker types, from either clone root
WORKER_BRIDGE="../run/hive"
WORKER_REVIEW="../run/review"             # issued only for a reviewer that runs in the VM

# --- the order pin, the kickoff, and the route ---------------------------------------
# All three are resolved HERE, before any decision that mutates something, because
# `--check` must be able to answer "what would this launch do" using the very same code
# the launch uses. A preflight computed from a second, simpler path would eventually
# disagree with the real one, and a gate that can disagree with what it gates is the
# defect retro 2026-07-29 D1 already charged this tooling once.
SHA=$(order_pin "$REL")
resolve_compose

# The kickoff is built before the route so the preflight can show the ACTUAL argv the
# harness would receive, kickoff included (elided in the display, counted in the shape).
#
# It names the worker's THREE commands and nothing else about transport, because there is
# only one: every operation runs in the worker's own process, with the governed CLI and
# the runner's own git and forge commands. If a configured runner cannot reach one of
# them, the command fails loudly and the worker blocks and says so — which is a deployment
# fact the operator can act on, and better than a bridge that hides it.
#
# The commands are the STABLE relative tokens, never the absolute files behind them (see
# WORKER_EMIT above): the header still names the task root and both clones, because those
# are facts a worker needs, but nothing it is asked to EXECUTE is task-specific.
read -r -d '' KICKOFF <<KICK || true
You are hive worker $WORKER on task $TASK (run: $RUN).
Your task root is $TASK_ROOT — everything you may write is inside it.
Your clones: workspace $WS_ROOT · code $CODE_ROOT.
Every command below is written relative to a clone root, and both clones sit beside the
interface directory, so all of them resolve from the workspace clone and from the code
clone alike. Your turn starts in the workspace clone; run them from a clone root.
Your emit command:            $WORKER_EMIT --type <t> --task <task> --payload <json>
Your workspace sync command:  $WORKER_BRIDGE sync workspace
Your publication commands:    $WORKER_BRIDGE publish workspace   (your report/question commits)
                              $WORKER_BRIDGE publish code        (branch $CODE_BRANCH, opens/updates its PR)
First: $WORKER_BRIDGE sync workspace
Your order: $REL in your workspace clone.
Protocol: read projects/omegahive/WORKER.md there first and follow it exactly.
The emit wrapper bakes in --run-id/--role worker/--actor $WORKER. Everywhere WORKER.md
writes 'hive emit --run-id \$RUN --role worker --actor \$WORKER ...', run '$WORKER_EMIT ...'
with only the remaining flags (--type/--task/--payload). Never use raw hive emit.
Commit your code work on branch $CODE_BRANCH; the publication commands take the branch,
the destination and the credentials from the launch and accept none from you.
You run as ONE interactive session and you carry the task to its end inside it: follow
WORKER.md's Finishing sequence in order — invoke your order's independent review against
the complete local diff before opening the PR, then wait out the first CI run, repair
within your order's budget, integrate main once, and only then post the result. Do not
stop at the PR. The operator is watching this window and may type into it; an answer to a
question you asked arrives that way, and re-reads your order at HEAD after a sync.
@@REVIEW@@
Externalize your state to committed files as you go, so that a session lost to a crash
loses no decision.
Container tooling on this host is '$HIVE_COMPOSE' (resolved at launch; WORKER.md's
setup block writes it as 'podman compose' because deployment #0 runs podman —
use the command named here). Begin by reading both files, then emit
task.accepted and start.
KICK

# --- resolve the route, in this shell ------------------------------------------------
# The catalog is read HERE, with jq, and not through `hive harness-resolve`. That resolver
# builds a BATCH argv through the adapter layer, and the production path is an interactive
# window again (2026-08-23-direction.md §3) — so a launch that went through it would resolve
# a command nobody runs. What a window actually needs is the "few fields" form: which
# harness, which model, which executable, which static arguments, which environment names.
# The catalog already carries every one of them, so reading it is a handful of jq calls
# rather than a second resolver that could disagree with the first.
#
# What still refuses is the cheap deterministic set the runner-trust doctrine leaves in
# place: an absent or malformed catalog, an unknown, ambiguous or disabled route, an absent
# default, a missing executable. Nothing here probes, qualifies or asks a model anything.
command -v jq >/dev/null 2>&1 \
  || die "jq is required to read the route catalog"
[ -f "$HIVE_ROUTE_CATALOG" ] || die "route catalog not found: $HIVE_ROUTE_CATALOG
  This is a DEPLOYMENT fact and is never committed to a project. Create it from
  schemas/route-catalog.example.json, or point HIVE_ROUTE_CATALOG at this host's copy.
  A v1 catalog is migrated in place by 'hive-routes migrate', which backs it up first."

CATALOG_VERSION=$(jq -r '.schema_version // empty' "$HIVE_ROUTE_CATALOG" 2>/dev/null) \
  || die "route catalog is not readable JSON: $HIVE_ROUTE_CATALOG"
[ "$CATALOG_VERSION" = "2" ] \
  || die "route catalog $HIVE_ROUTE_CATALOG is schema_version '${CATALOG_VERSION:-unknown}'; this build reads v2.
  Migrate it — the original is backed up first:  hive-routes migrate"

# A recovery keeps the route the task was already approved on, unless the operator names
# another. Without this, `--reassign` with no `--route` falls through to the catalog default
# and silently reseats the task on a different harness, model, provider AND billing market —
# an API-billed sandboxed task would come back as a subscription Claude worker, the sandbox
# guard below would never fire because EXECUTABLE is no longer `sbx`, and the stranded VM
# would be left behind. Recovering a seat is not the moment to change what pays for it; the
# operator can still say so explicitly with --route.
if [ -n "$REASSIGN" ] && [ -z "$ROUTE_ARG" ]; then
  # Best effort, never fatal. A run with no events does not answer JSON here, and this is a
  # convenience over the authoritative board read further down — which refuses with a message
  # about the TASK rather than a jq parse error. Failing here would replace that message with
  # this one and tell the operator nothing useful.
  PRIOR_ROUTE=$(hive report "$RUN" --json 2>/dev/null \
    | jq -r --arg t "$TASK" 'last(.[] | select(.event_type == "execution.route_approved"
                                               and .task_id == $t) | .payload.identity.route) // ""' \
      2>/dev/null) || PRIOR_ROUTE=""
  if [ -n "$PRIOR_ROUTE" ]; then
    ROUTE_ARG="$PRIOR_ROUTE"
    echo "  route:  carrying forward '$PRIOR_ROUTE' from this task's last approval (--route overrides)"
  else
    # Not a refusal: the board gate below decides whether this task is recoverable at all,
    # and says so far more precisely. This only warns that if it IS, the route will not be
    # the one it ran on, because nothing on the spine records one.
    echo "hive-launch: WARNING no recorded route approval for '$TASK' on run '$RUN'; a" >&2
    echo "  recovery would use the catalog default. Name the route with --route." >&2
  fi
fi

# The route NAME: the operator's --route for this one launch, or the catalog's single
# worker default. An override writes nothing and amends nothing.
if [ -n "$ROUTE_ARG" ]; then
  ROUTE_NAME="$ROUTE_ARG"
  ROUTE_SOURCE="override"
else
  ROUTE_NAME=$(jq -r '.defaults.worker // empty' "$HIVE_ROUTE_CATALOG")
  ROUTE_SOURCE="default"
  [ -n "$ROUTE_NAME" ] || die "the catalog names no 'defaults.worker' route, so an ordinary
  launch has nothing to run on. Name one in $HIVE_ROUTE_CATALOG, or pass --route <name>."
fi

N_MATCH=$(jq --arg n "$ROUTE_NAME" '[.routes[]? | select(.name == $n)] | length' "$HIVE_ROUTE_CATALOG")
case "$N_MATCH" in
  0) die "no route named '$ROUTE_NAME' in $HIVE_ROUTE_CATALOG.
  Enabled routes: $(jq -r '[.routes[]? | select(.enabled != false) | .name] | join(", ")' "$HIVE_ROUTE_CATALOG")
  See them all with:  hive-routes" ;;
  1) : ;;
  *) die "route name '$ROUTE_NAME' appears $N_MATCH times in $HIVE_ROUTE_CATALOG.
  A duplicate name makes 'which runner' unanswerable; fix the catalog." ;;
esac
ROUTE=$(jq -c --arg n "$ROUTE_NAME" 'first(.routes[] | select(.name == $n))' "$HIVE_ROUTE_CATALOG")
[ "$(printf '%s' "$ROUTE" | jq -r '.enabled != false')" = "true" ] \
  || die "route '$ROUTE_NAME' is present but disabled (enabled: false).
  Disabling a route IS revocation under the runner-trust doctrine; re-enable it in
  $HIVE_ROUTE_CATALOG, or launch on another route with --route <name>."

route_field() { printf '%s' "$ROUTE" | jq -r --arg k "$1" '.[$k] // ""'; }
R_HARNESS=$(route_field harness)
R_MODEL=$(route_field model)
R_ADAPTER=$(route_field adapter)
R_VENDOR=$(route_field model_vendor)
R_PROVIDER=$(route_field provider)
R_MARKET=$(route_field billing_market)
R_POOL=$(route_field credential_pool)
# Optional, unlike everything above it: a catalog predating the field still loads, and
# absence reads as unstated rather than as "no reviewer". It is not an execution-identity
# field and so is not in the required loop below.
R_REVIEWER=$(route_field reviewer)
EXECUTABLE=$(printf '%s' "$ROUTE" | jq -r '.runner.executable // ""')
# Every field the spine's execution identity requires, checked before anything is created.
# The identity block may not be synthesized or defaulted (events/types.py), so a route
# missing one of them cannot carry a launch at all.
for f in harness:"$R_HARNESS" model:"$R_MODEL" adapter:"$R_ADAPTER" model_vendor:"$R_VENDOR" \
         provider:"$R_PROVIDER" billing_market:"$R_MARKET" credential_pool:"$R_POOL" \
         runner.executable:"$EXECUTABLE"; do
  [ -n "${f#*:}" ] || die "route '$ROUTE_NAME' has no '${f%%:*}'. Every execution-identity field is
  required and none may be defaulted — fix the route in $HIVE_ROUTE_CATALOG."
done


# --- what a route may NOT ask the worker's window to inherit ----------------------------
# `inherit_env` names variables the harness needs from the launching environment, and the
# launcher forwards them into the window. Hive's OWN authority credentials are not among the
# things an operator may hand a worker: the database and gateway DSNs are capability over the
# durable record, and a worker holding one does not need to defeat the gateway's role policy
# because it can write underneath it.
#
# `harness/records.py` refuses these at catalog load, and that used to be the only place a
# catalog was ever read. It is not any more — this script parses the catalog itself — so the
# rule is enforced here as well, in the same shape (the named set plus the DSN pattern that
# catches the next one someone adds to the deployment).
while IFS= read -r n; do
  [ -n "$n" ] || continue
  case "$n" in
    OMEGAHIVE_*DATABASE_URL|POSTGRES_USER|POSTGRES_PASSWORD|POSTGRES_DB|TELEGRAM_BOT_TOKEN)
      die "route '$ROUTE_NAME' asks to inherit '$n', which is one of Hive's own authority
  credentials. A provider credential is deployment posture an operator may hand a worker;
  Hive's authority over its own record is not inheritable under any configuration.
  Remove it from runner.inherit_env in $HIVE_ROUTE_CATALOG." ;;
  esac
done < <(printf '%s' "$ROUTE" | jq -r '.runner.inherit_env[]?, (.runner.inherit_env_as // {} | to_entries[] | .key, .value), (.runner.env // {} | keys[])')

# --- the route's own environment facts --------------------------------------------------
# `runner.env` holds the provider ENDPOINT as a literal, and `runner.inherit_env_as` maps a
# name the harness reads to the name the host actually holds it under. Both exist because
# 2026-08-28 proved the alternative: an endpoint that lived only in the operator's shell went
# missing, the launcher skipped the unset name without a word, the sandbox never opened egress
# to the provider, and the worker answered from api.anthropic.com — which rejects every
# deepseek id. The endpoint is a fact about the ROUTE, so it is carried by the route.
#
# The catalog model restricts runner.env VALUES to http(s) URLs — and this script never reads
# the catalog through that model. It parses the file with jq, deliberately (see above), so a
# rule enforced only in `harness/records.py` is a rule that does not hold on the path a launch
# actually takes. The same shape is therefore checked here, against the same field, before any
# of it is printed by --check or forwarded into a window: a value that is not an endpoint is
# a value nobody has cleared for either.
ENV_PAIRS=$(printf '%s' "$ROUTE" | jq -r '(.runner.env // {}) | to_entries[] | "\(.key)=\(.value)"')
while IFS= read -r pair; do
  [ -n "$pair" ] || continue
  case "${pair%%=*}" in
    ''|*[!A-Za-z0-9_]*|[0-9]*)
      die "route '$ROUTE_NAME' has a runner.env key that is not an environment variable NAME:
  '${pair%%=*}'. Fix the route in $HIVE_ROUTE_CATALOG." ;;
  esac
  case "${pair#*=}" in
    http://*|https://*) : ;;
    *)  die "route '$ROUTE_NAME' has runner.env['${pair%%=*}'] set to something that is not an
  http(s) endpoint. This is the one field in the runner block that holds a VALUE, and it holds
  endpoints only — precisely so that a credential cannot be placed in a field this launcher
  prints in its preflight and forwards into the worker's environment.
  Fix the route in $HIVE_ROUTE_CATALOG." ;;
  esac
done < <(printf '%s\n' "$ENV_PAIRS")

# Every name the ROUTE puts into the worker's environment: the endpoint literals, the
# inherited names, and the targets of the renames. Computed here, beside the field that
# validates them, because two things downstream need exactly this set and neither may
# maintain its own copy of it — the reviewer's wrapper strips these names to get off the
# worker's routing, and the refusal below asks whether the route routes a model at all.
ROUTE_ENV_NAMES=$(printf '%s' "$ROUTE" | jq -r '
  ((.runner.env // {}) | keys[]),
  (.runner.inherit_env[]?),
  ((.runner.inherit_env_as // {}) | keys[])' | sort -u | tr '\n' ' ')
ROUTE_ENV_NAMES="${ROUTE_ENV_NAMES% }"

# A narrower set, and a different question. ROUTE_ENV_NAMES is everything to STRIP from a
# review, and being generous there costs nothing. This is what makes a route one that ROUTES
# A MODEL: an endpoint literal, or a rename, which exists for no other purpose than handing
# a harness a provider credential under the name it reads. A plainly inherited name is
# neither — it is whatever the operator's harness needs — so a route that only inherits must
# not be treated as carrying provider routing.
ROUTE_ROUTING_NAMES=$(printf '%s' "$ROUTE" | jq -r '
  ((.runner.env // {}) | keys[]),
  ((.runner.inherit_env_as // {}) | keys[])' | sort -u | tr '\n' ' ')
ROUTE_ROUTING_NAMES="${ROUTE_ROUTING_NAMES% }"

# --- naming the reviewer to the worker -------------------------------------------------
# The kickoff above is built before the route is resolved, so this paragraph is substituted
# in here, where R_REVIEWER and ROUTE_ENV_NAMES both exist and nothing has yet consumed
# KICKOFF (the argv display at --check and the window's HIVE_KICKOFF both come later).
#
# It is appended at all because `reviewer` was, until now, a field nothing read. The
# catalog recorded which harness reviews a route and the worker was never told: WORKER.md
# names two reviewers by harness ("Claude Code: the Codex review plugin"), which is right
# on a host and impossible inside a microVM, where there is no plugin cache and no codex
# binary. A sandboxed worker therefore had to invent something, and what it invented on
# 2026-08-28 was a bare `claude`, inheriting its own provider routing.
#
# Absence stays absence: a route with no reviewer says so rather than defaulting to one.
# A sandboxed route that routes a model MUST name the in-VM reviewer. This is not style:
# the review is a second model invoked from inside a VM whose environment points Claude
# Code at the worker's provider, so a reviewer that is absent, or that names a host harness
# the VM cannot reach, leaves the worker with the same nothing the 2026-08-28 worker had —
# and what it improvised then was a bare `claude`, which reviewed the account under test on
# the account under test. A fourth `or-*` route copied from a third with the field dropped
# is the exact shape this catches, and the copy would otherwise launch clean.
#
# Narrow on purpose. A sandboxed route with no provider routing (claude-*-sbx) has nothing
# to strip and no wrong account to fall onto, and a non-sandboxed route reaches its host
# reviewer, so neither is refused here.
# `claude-cli` means a review invoked as a subprocess on the HOST, with the operator's own
# login and a read-only posture. Inside a microVM "the host" is the VM, and the two things
# that make the value work are both absent there: the login is not in the VM unless the
# reviewer asks for it (CRED_FOR_REVIEWER keys on `opus-in-sandbox` and on nothing else),
# and the read-only posture is the wrong one where the VM is already the boundary. Such a
# route preflights clean, builds, works, and refuses at review time with the task done —
# so it is refused here instead. The provider-routing test below does not catch it: a
# sandboxed route that routes no model has no routing names at all.
if [ "$EXECUTABLE" = "sbx" ] && [ "$R_REVIEWER" = "claude-cli" ]; then
  die "route '$ROUTE_NAME' runs in a sandbox and names the reviewer 'claude-cli', which is a
  review invoked on the host. Inside a VM that is not a reviewer: no Claude login is copied
  in for it, so the review would refuse at the end of the task rather than at this launch.
  Set \"reviewer\": \"opus-in-sandbox\" on the route in $HIVE_ROUTE_CATALOG.
  Nothing was created, cloned or emitted."
fi

if [ "$EXECUTABLE" = "sbx" ] && [ -n "$ROUTE_ROUTING_NAMES" ] \
   && [ "$R_REVIEWER" != "opus-in-sandbox" ]; then
  die "route '$ROUTE_NAME' runs in a sandbox and puts its own provider routing into it
  ($ROUTE_ROUTING_NAMES), but its reviewer is '${R_REVIEWER:-unstated}'. A review invoked inside
  that VM inherits the worker's routing unless it is stripped, and only the 'opus-in-sandbox'
  reviewer strips it — so this route would bill its review to the account under test and
  call it independent. Set \"reviewer\": \"opus-in-sandbox\" on the route in
  $HIVE_ROUTE_CATALOG. Nothing was created, cloned or emitted."
fi

case "$R_REVIEWER" in
  codex-plugin)
    REVIEW_LINE="Your independent review: Codex, via the codex-review skill, from inside this session." ;;
  claude-skill)
    REVIEW_LINE="Your independent review: Claude, via the claude-review skill, from inside this session." ;;
  opus-in-sandbox)
    REVIEW_LINE="Your independent review command:  $WORKER_REVIEW \"<prompt>\"   (or pipe the prompt in)
That is Opus on the operator's subscription, invoked with this route's provider routing
stripped. Do NOT invoke 'claude' or any other model directly for the review: that command
is the issued one, and a bare invocation inherits whatever routing this VM carries — which
on a provider route reviews the account under test, on the account under test, and says
nothing about either." ;;
  claude-cli)
    REVIEW_LINE="Your independent review command:  $WORKER_REVIEW \"<prompt>\"   (or pipe the prompt in)
That is Opus on the operator's subscription, read-only, running as a subprocess of your
session. Your harness has no review plugin or skill of its own, so this command is the
review: there is no other one to find, and inventing one is not in your scope." ;;
  "")
    REVIEW_LINE="Your route names no reviewer. Follow WORKER.md, and state in your report which
harness reviewed you and exactly how you invoked it." ;;
  *)
    REVIEW_LINE="Your route names the reviewer '$R_REVIEWER', which this launcher does not know how to
invoke. Follow WORKER.md, and state in your report which harness reviewed you and how." ;;
esac
# Substituted rather than appended: the sentence belongs beside the Finishing sequence that
# demands a review, not tacked on after "begin".
KICKOFF="${KICKOFF/@@REVIEW@@/$REVIEW_LINE}"

# Every name a route DECLARES must be set. Skipping an unset one silently is the defect
# itself: on a sandboxed route the value is written into the VM's 0600 env file and, when it
# is an endpoint, opened in the VM's egress allowlist, so a skipped name builds a worker that
# cannot reach its provider and discovers it only after four board writes and a microVM.
# Every missing name is reported at once — one refusal per launch, not one per re-run.
# The Antigravity harness needs the operator's Google session, and the kit that defines the
# `agy` agent cannot supply it: sbx's credential-proxy binding is PER SANDBOX (measured
# 2026-09-08 — a freshly created second VM reports "no binding authorizes antigravity" and
# its agy is signed out), while this launcher builds one VM per task. So the host's token is
# copied in, exactly as the Claude subscription credential is. The trade is identical and
# accepted for the identical reason: an OAuth session the proxy will not carry travels as a
# file or not at all.
#
# Checked HERE, with the other preflights, and not beside the copy. A credential check that
# runs inside the sandbox block runs after the clones, so its "nothing was created" would be
# false and the retry after logging in would die on its own leftover task root — the trap
# the credential comment further down already documents once. Here it also reaches `--check`,
# which exits long before any of that.
AGY_TOKEN="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"
# A sandboxed route cannot build its VM while the host's secret store is resident AND
# locked. sbx reads its Docker Hub credential from a keychain when it detects one and from
# its own file when it does not; a locked keychain is detected, preferred, and then answers
# with a prompt no unattended process can dismiss. Measured 2026-09-10, twice: the launch
# dies at `sbx create` with
#   encode registry auth: ... get Docker Hub access token: failed to prompt: prompt dismissed
# after the clones are made, and `--check` said nothing because it never touched sbx.
#
# `sbx ls` does NOT detect this — it answers from local state and exits 0 with the keyring
# locked, which is why deploy check 9 alone was not enough. The collection's own `Locked`
# property is the reliable probe: instant, no credential, and it cannot hang.
#
# RESIDENCY IS TESTED FIRST, and that order is the whole correctness of this function.
# Reading the property over D-Bus ACTIVATES the daemon, so a check written the other way
# round CREATES the fault it is looking for — which is exactly what happened while this was
# being investigated. With no daemon resident there is nothing to check: sbx finds no
# keychain and uses its file credential, which is the working case.
require_sandbox_keyring() {
  [ "$EXECUTABLE" = "sbx" ] || return 0
  command -v pgrep  >/dev/null 2>&1 || return 0
  command -v busctl >/dev/null 2>&1 || return 0
  pgrep -u "$(id -un)" -f gnome-keyring-daemon >/dev/null 2>&1 || return 0

  local locked
  # A store that cannot be queried is not a store that is locked; say nothing and let the
  # launch proceed, on the same reasoning as every other unreachable probe here.
  locked=$(timeout "${HIVE_KEYRING_PROBE_TIMEOUT:-10}" busctl --user get-property \
    org.freedesktop.secrets /org/freedesktop/secrets/collection/login \
    org.freedesktop.Secret.Collection Locked 2>/dev/null) || return 0
  [ "$locked" = "b true" ] || return 0

  die "route '$ROUTE_NAME' builds a sandbox, and this host's login keyring is resident and LOCKED.
  sbx prefers a keychain when it detects one, so it will ask that keyring for a Docker Hub
  token, and a locked keyring answers with a prompt nothing here can dismiss. The launch
  would die at 'sbx create', after the clones were made.

  Either unlock it (it stays unlocked until the next reboot):
    gnome-keyring-daemon --unlock --daemonize --components=secrets
  or stop it, so sbx falls back to its own file credential:
    pkill -f gnome-keyring-daemon

  Set HIVE_SKIP_KEYRING_CHECK=1 to launch anyway. Nothing was created, cloned or emitted."
}

require_agy_login() {
  [ "$R_HARNESS" = "antigravity" ] || return 0
  [ -f "$AGY_TOKEN" ] || die "route '$ROUTE_NAME' runs the Antigravity harness, and there is no
  $AGY_TOKEN on this host. Log in first — run 'agy' in a terminal and complete the sign-in.
  Without it the worker would build, read its order, and find it cannot reach a model.
  Nothing was created, cloned or emitted."
}

require_declared_env() {
  local missing=() n src
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    [ -n "${!n+set}" ] || missing+=("$n")
  done < <(printf '%s' "$ROUTE" | jq -r '.runner.inherit_env[]?')
  while IFS=$'\t' read -r n src; do
    [ -n "${src:-}" ] || continue
    [ -n "${!src+set}" ] || missing+=("$src (read by the runner as $n)")
  done < <(printf '%s' "$ROUTE" | jq -r '(.runner.inherit_env_as // {}) | to_entries[] | "\(.key)\t\(.value)"')
  [ "${#missing[@]}" -eq 0 ] || die "route '$ROUTE_NAME' declares environment names that are UNSET here:
    ${missing[*]}
  A declared name is a requirement, not a hint. Export them, or amend the route in
  $HIVE_ROUTE_CATALOG. Nothing was created, cloned or emitted."
}

# One unauthenticated GET against the endpoint the harness will ACTUALLY use. It closes the
# gap the no-allowlist rationale below leaves open on a sandboxed route, where the harness's
# own refusal lands only after the board has been written to. It carries no credential, so it
# can neither spend nor leak.
#
# Unreachable is NOT nonexistent. Only a successful response that does not list the id
# refuses; a timeout warns and proceeds, because a launcher that turns a DNS hiccup into a
# refused order is less reliable than the failure it is guarding against.
#
# And LISTED is not ROUTABLE. This call carries no credential — which is what makes it safe
# to run on every launch — and the price of that is that it cannot know whether THIS account
# may reach the model, only that the provider publishes it. OpenRouter lists
# `meta/muse-spark-1.3-contributor`, which is not routable through OpenRouter at all
# (operator, 2026-09-10). So this is a typo-catcher, which is the job it was added for after
# a `-latest` id that did not exist, and nothing more: a launch it passes can still fail at
# the first token. Do not "strengthen" it by trusting it further without giving it a
# credential, and giving it one means it can spend.
require_model_served() {   # require_model_served <base-url> <model-id>
  local base="${1%/}" model="$2" body ids near
  # A provider pin travels inside the model string as an operator-owned preset; the part
  # before it is the id the provider actually lists.
  model="${model%%@preset/*}"
  [ -z "${HIVE_SKIP_MODEL_PROBE:-}" ] || return 0
  command -v curl >/dev/null 2>&1 || {
    echo "  model:  WARNING no curl on PATH; '$model' NOT verified against $base" >&2; return 0; }
  # A conventional base URL may or may not already carry the API version: OpenRouter's is
  # `https://openrouter.ai/api`, while most OpenAI-compatible providers publish
  # `https://host/v1`. Appending unconditionally produced `/v1/v1/models`, which 404s — and a
  # 404 is indistinguishable here from an outage, so the probe warned and passed EVERY id on
  # exactly the routes an operator is most likely to write. Normalize, then append once.
  base="${base%/v1}"
  body=$(curl -fsS --max-time "${HIVE_MODEL_PROBE_TIMEOUT:-10}" "$base/v1/models" 2>/dev/null) || {
    echo "  model:  WARNING could not reach $base/v1/models; '$model' is UNVERIFIED for this launch" >&2
    return 0; }
  ids=$(printf '%s' "$body" | jq -r '.data[]?.id // empty' 2>/dev/null) || {
    echo "  model:  WARNING $base/v1/models did not answer JSON; '$model' UNVERIFIED" >&2; return 0; }
  [ -n "$ids" ] || {
    echo "  model:  WARNING $base/v1/models listed no ids; '$model' UNVERIFIED" >&2; return 0; }
  printf '%s\n' "$ids" | grep -qxF "$model" && return 0
  case "$model" in
    */*) near="${model%%/*}" ;;      # the vendor: what a mistyped id usually gets right
    *)   near="${model%%-*}" ;;      # or the leading token of a bare slug
  esac
  die "model '$model' is not served by $base.
$(printf '%s\n' "$ids" | grep -iF -- "$near" | head -5 | sed 's/^/    near match: /')
  A route's model is a value inside a shape: fix it with --model <id>, or amend the route in
  $HIVE_ROUTE_CATALOG. Nothing was created, cloned or emitted."
}


# --- the model: the route's default, or this launch's -----------------------------------
# A route is a SHAPE — harness, sandbox, credential pool — and the model is a value inside
# it. `--model` overrides the route's default for one launch and is what lands in the
# execution identity, because recording the catalog's default while having run something
# else is the one thing that would make that identity a lie.
#
# There is still no allowlist of model ids in the catalog, deliberately: providers name their
# models, Hive does not, and a hand-maintained list would be stale within a week. What was
# wrong with the older form of this note is the reason it gave — that a wrong id "is refused
# by the harness on startup, before a token is spent". On a sandboxed route that is false.
# The harness starts inside a microVM that this script has already built, after four board
# writes, and its refusal is the most expensive way left to learn the id was wrong; on
# 2026-08-28 it also arrived disguised as a provider outage. So the id is checked against the
# provider that will serve it, above, by one unauthenticated GET — and the catalog still
# holds no list.
#
# For a provider-pinned OpenRouter route the pin travels INSIDE the model string as an
# operator-owned preset (`<model>@preset/<slug>`), so this one value carries both which model
# and which silicon serves it (taskbench/openrouter.py); the preflight strips the preset and
# checks the id.
MODEL="${MODEL_ARG:-$R_MODEL}"

# The name a sandboxed route re-attaches by, derived from the task so that a recovery
# re-attaches the worker's own VM instead of creating a second one. Underscores are legal in
# a task id and illegal in a sandbox name, so they map to hyphens.
SANDBOX="hive-${TASK//_/-}"

# --- preflight: prove what is knowable BEFORE anything is built -------------------------
# Placement is the mechanism. Both checks sit above every side effect this script has —
# 200-odd lines above `mkdir "$TASK_ROOT"`, 400 above `sbx create`, and further still above
# the first board write — so a route whose environment is incomplete, or whose model the
# provider does not serve, costs nothing but the refusal. That is cheaper and more honest
# than an unwind, which would have to invent board events for a task that should never have
# been seeded.
#
# --check reaches them by falling through to the same two calls, so the preflight an
# operator reads can never disagree with the one a launch runs.
require_declared_env
require_agy_login
[ -n "${HIVE_SKIP_KEYRING_CHECK:-}" ] || require_sandbox_keyring
ENDPOINT_URL=$(printf '%s\n' "$ENV_PAIRS" | sed -n 's/^[^=]*=\(https\{0,1\}:.*\)$/\1/p' | head -1)
if [ -n "$ENDPOINT_URL" ] && [ -z "$ANYWAY" ]; then
  require_model_served "$ENDPOINT_URL" "$MODEL"
fi

# --- the argv, with this launch's own values substituted --------------------------------
# `runner.args` is a template: the route says WHERE the model, the task root, the clones, the
# hub and the sandbox name go, and this substitutes them. Substitution happens on the ARRAY,
# element by element, so a value carrying a space or a quote stays exactly one argument and
# there is no string a shell re-parses.
subst() {  # subst <template>  -> prints the expanded value
  local s="$1"
  s="${s//\{\{model\}\}/$MODEL}"
  s="${s//\{\{sandbox\}\}/$SANDBOX}"
  s="${s//\{\{task_root\}\}/$TASK_ROOT}"
  s="${s//\{\{ws_root\}\}/$WS_ROOT}"
  s="${s//\{\{code_root\}\}/$CODE_ROOT}"
  s="${s//\{\{ws_hub\}\}/$WS_HUB}"
  s="${s//\{\{canon\}\}/$OMEGA_DIR}"
  printf '%s' "$s"
}
ARGV=("$EXECUTABLE")
while IFS= read -r -d '' a; do ARGV+=("$(subst "$a")"); done \
  < <(printf '%s' "$ROUTE" | jq -j '.runner.args[]? | . + "\u0000"')
# The kickoff is NOT in this vector. The pane command appends it as one argument expanded
# from HIVE_KICKOFF, so no prompt is ever quoted onto a line a shell parses.

if [ -n "$CHECK_ONLY" ]; then
  echo "hive-launch --check: task=$TASK worker=$WORKER project=$PROJECT (no side effects)"
  echo "  order:      $REL@$SHA"
  echo "  route:      $ROUTE_NAME  ($ROUTE_SOURCE)"
  echo "  identity:   $MODEL @ $R_HARNESS ($R_VENDOR/$R_PROVIDER, $R_MARKET, pool $R_POOL, adapter $R_ADAPTER)"
  [ -z "$MODEL_ARG" ] || echo "              model overridden for this launch (route default: $R_MODEL)"
  echo "  task root:  $TASK_ROOT"
  printf '  argv:       '
  # The kickoff is shown as its SHAPE, never its text: a preflight that printed the prompt
  # would put the order's contents into every scrollback and paste that ever ran one.
  printf '%q ' "${ARGV[@]}"
  printf '<kickoff: %d chars>\n' "${#KICKOFF}"
  ENV_NAMES=$(printf '%s' "$ROUTE" | jq -r '[.runner.inherit_env[]?] | join(" ")')
  echo "  env names:  ${ENV_NAMES:-<none>}   (NAMES only; no value is read or printed here)"
  # The renames and the endpoint, in the same names-and-URLs-only spirit. The rename line
  # answers the question that cost a launch on 2026-08-28 — which HOST variable actually
  # feeds the name the harness reads — without reading either one's value.
  AS_NAMES=$(printf '%s' "$ROUTE" \
    | jq -r '[(.runner.inherit_env_as // {}) | to_entries[] | "\(.key)<-\(.value)"] | join(" ")')
  [ -z "$AS_NAMES" ] || echo "  env renames: $AS_NAMES   (NAMES only)"
  [ -z "$ENV_PAIRS" ] || echo "  endpoint:   $(printf '%s' "$ENV_PAIRS" | tr '\n' ' ')  (a route fact, not the shell's)"
  # `require_declared_env` already ran above, so reaching this line means every declared name
  # is set. Saying so is the point: a preflight that stays silent about the thing that broke
  # the last launch has not preflighted it.
  echo "  env state:  every declared name is set"
  [ "$EXECUTABLE" != "sbx" ] || echo "  sandbox:    $SANDBOX  (created at launch if absent, re-attached if present)"
  # The same host-side check the real launch makes, on the same helper, BEFORE the version
  # probe. A preflight that printed "NOT INSTALLED" and then exited 0 would tell a human the
  # truth and an automation the opposite.
  require_executable "$EXECUTABLE" "$ROUTE_NAME"
  printf '  harness:    '
  # Two spellings, because they are both real: `claude --version` and `codex --version`
  # answer a flag, `sbx version` answers a SUBCOMMAND and rejects the flag outright. A
  # preflight that knew only one would call a healthy deployment incomplete — which it did,
  # for every sandboxed route, the first time this was run.
  VPROBE=""
  if VOUT=$("$EXECUTABLE" --version 2>&1); then
    VPROBE="$EXECUTABLE --version"
  elif VOUT=$("$EXECUTABLE" version 2>&1); then
    VPROBE="$EXECUTABLE version"
  fi
  if [ -n "$VPROBE" ]; then
    printf '%s\n' "$(printf '%s\n' "$VOUT" | harness_version_from)  (probe: $VPROBE)"
  else
    # The executable exists and could not answer `--version`. Not a refusal to launch — the
    # doctrine's deterministic set is presence, not behaviour — but not a clean preflight
    # either, so it exits non-zero and says which of the two happened.
    # shellcheck disable=SC2016  # the backticks are prose, not a command substitution
    printf 'PRESENT BUT ANSWERED NEITHER `%s --version` NOR `%s version`:\n' "$EXECUTABLE" "$EXECUTABLE"
    printf '%s\n' "$VOUT" | sed 's/^/    /'
    printf '  the route resolves and the executable exists; its version probe failed, so\n'
    printf '  this preflight is INCOMPLETE. Launching is still possible.\n'
    exit 1
  fi
  exit 0
fi

# The same host-side check the preflight makes, on the real path. Cheap, deterministic,
# and before anything is created or emitted.
require_executable "$EXECUTABLE" "$ROUTE_NAME"

# --- review WIP throttle: pace launches to the operator's review debt ---------
# Review is the quality gate; launching faster than results are reviewed just
# grows an unreviewed backlog that no one is reading. Refuse once HIVE_WIP_REVIEW_MAX
# tasks sit in_review, listing them so the operator knows what to drain. `blocked`
# tasks are deliberately NOT counted — that is answer debt (a question awaiting a
# decision), not review debt. `--anyway` overrides for the deliberate exception.
# `--reassign` is exempt. The throttle paces NEW work against review debt, and a recovery
# introduces none: the task is already in flight and already inside the operator's WIP, and
# the count reads `in_review` only — which an assigned|blocked|in_progress task is not. A
# throttle that blocked recoveries would be blocking its own drain.
if [ -z "$ANYWAY" ] && [ -z "$REASSIGN" ]; then
  # Global across every project with a conf: the limit is the operator's review
  # bandwidth, not any single project's, so an in_review backlog anywhere throttles
  # launches everywhere (OPERATIONS.md; decisions.md 2026-07-21).
  IN_REVIEW=""; IN_REVIEW=$(global_in_review) || IN_REVIEW=""
  N_REVIEW=0
  if [ -n "$IN_REVIEW" ]; then N_REVIEW=$(printf '%s\n' "$IN_REVIEW" | grep -c .); fi
  if [ "$N_REVIEW" -ge "$HIVE_WIP_REVIEW_MAX" ]; then
    {
      echo "hive-launch: refusing to launch '$TASK' — $N_REVIEW task(s) awaiting review across all projects (limit HIVE_WIP_REVIEW_MAX=$HIVE_WIP_REVIEW_MAX):"
      printf '%s\n' "$IN_REVIEW" | sed 's/^/    - /'
      echo "  review is the quality gate; launches must not outrun it."
      echo "  close reviewed work (hive-close) to drain, or override with --anyway."
    } >&2
    exit 1
  fi
fi

# --- decide before we change anything: create, adopt, or refuse ---------------
# hive-launch normally creates a NEW task. Re-emitting task.created for one that
# already exists would be applied wholesale by the reducer — silently regressing
# an owned/in_review/done task to fresh. So an existing task is handled by state:
#
#   absent                        -> create  (seed task.created + register + assign)
#   ready, unowned                -> ADOPT   (register + assign only; NO task.created)
#   assigned|blocked|in_progress  -> refuse; owned/in-flight, recover via task.reassigned (RUNBOOK)
#   in_review|done                -> refuse; already awaiting close / closed — not launchable
#   any other existing state      -> refuse; not launchable
#
# Adopt exists because the entire pre-tooling backlog was seeded (2026-07-10) as
# unowned `ready` tasks via raw task.created — without it, hive-launch could only
# ever launch tasks it created itself. Adopt is the ONE existing-state that
# proceeds, and only from exactly (ready, unowned): it reuses the seeded
# task.created instead of re-emitting one. Recovery of an owned/dead task stays
# the manual task.reassigned path (RUNBOOK) — never a relaunch.
#
# The read below is STRICT (board_json_strict): an unreadable board dies here rather
# than collapsing to the empty string and taking the "absent -> create" branch. That
# collapse was real — `hive-launch` never checked for `jq`, and a missing one turned an
# in_review task into a fresh `task.created` with every guard below bypassed.
#
# `--reassign` is the third mode, and it inverts the polarity of the same table: the three
# owned states it refuses are exactly the three a reassign is legal FROM
# (board/legality.py `_g_reassigned`), and everything else refuses. It exists because the
# recovery it replaces was two hand-typed emits that re-pointed the board at a worker id with
# no task root, no clones, no wrappers and no window behind it.
ADOPT=""
REASSIGN_FROM=""
BOARD_NOW=$(board_json_strict "$RUN")
EXISTING=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .status')
if [ -n "$REASSIGN" ]; then
  [ -n "$EXISTING" ] || die "--reassign names task '$TASK', which does not exist on run '$RUN'.
  Reassign recovers a task the board already owns; there is nothing here to recover. Launch it."
  case "$EXISTING" in
    assigned|blocked|in_progress) : ;;
    ready)
      die "task '$TASK' is 'ready' and unowned on run '$RUN' — that is a launch, not a recovery.
  Drop --reassign." ;;
    *)
      die "--reassign is legal only from assigned|blocked|in_progress; task '$TASK' is
  '$EXISTING' on run '$RUN' (board/legality.py). Nothing was created or emitted." ;;
  esac
  REASSIGN_FROM=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .owner // empty')
  [ -n "$REASSIGN_FROM" ] || die "task '$TASK' is '$EXISTING' on run '$RUN' with no owner, so
  task.reassigned has no 'from' to record. This is a board that needs repairing by hand, not a
  seat that needs recovering."
  [ "$REASSIGN_FROM" != "$WORKER" ] || die "the new worker id '$WORKER' is the one already on
  task '$TASK'. Pick another with --worker."
  # The board's roster never forgets a worker id, and `worker.registered` is refused for one
  # it already holds — a rejection that would land AFTER execution.route_approved, leaving an
  # orphan spend fact on the spine and no way forward. Checked against the ROSTER and not
  # against current owners: a worker that was itself reassigned away owns nothing and is still
  # registered, so an owner scan would wave through exactly the id most likely to be reused.
  # The roster is what `worker.registered` built, so that is what is read.
  ROSTER=$(hive report "$RUN" --json 2>/dev/null \
    | jq -r '.[] | select(.event_type == "worker.registered") | .payload.worker_id') \
    || die "could not read run '$RUN' to check the worker roster. Refusing rather than
  registering blind: a rejected worker.registered lands after the route is approved."
  printf '%s\n' "$ROSTER" | grep -qxF "$WORKER" \
    && die "worker id '$WORKER' is already on run '$RUN' roster, and the board never
  re-registers a known id — the refusal would land after this launch had already approved
  (and recorded) its spend. Pick another with --worker."
elif [ -n "$EXISTING" ]; then
  case "$EXISTING" in
    ready)
      OWNER=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .owner // empty')
      [ -z "$OWNER" ] || die "task '$TASK' is 'ready' but owned by '$OWNER' on run '$RUN' — not adoptable; recover via task.reassigned (RUNBOOK)"
      ADOPT=1 ;;
    assigned|blocked|in_progress)
      die "task '$TASK' is already owned/in-flight on run '$RUN' (status: $EXISTING); relaunch is
  not recovery. If that seat is dead, kill its window and recover it onto a fresh worker:
    hive-launch $REL --reassign --reason '<why>'" ;;
    in_review)
      die "task '$TASK' is already awaiting close on run '$RUN' (status: in_review) — not launchable" ;;
    done)
      die "task '$TASK' is already closed on run '$RUN' (status: done) — not launchable" ;;
    *)
      die "task '$TASK' already exists on run '$RUN' (status: $EXISTING) — not launchable" ;;
  esac
fi

# --- tmux targeting: name the SESSION exactly, never let tmux guess -------------
# Every tmux target below goes through SESSION_T. The `=` prefix forces an EXACT
# session-name match. Without it, tmux falls back to prefix matching when no
# session is named exactly `$HIVE_TMUX_SESSION` — so with the real session gone or
# renamed, a bare `hive` silently matches a session called `hive-scratch` and
# seats the worker there. An exact match, or nothing.
SESSION_T="=$HIVE_TMUX_SESSION"

# Clobber guards: never overwrite an existing clone or a same-named live pane.
# tmux is checked here, BEFORE any board write — a missing tmux is a knowable
# failure, and knowable failures belong on this side of the spine seeding.
command -v tmux >/dev/null 2>&1 \
  || die "tmux not found on PATH — the pane is the task registry, so a launch without tmux cannot complete"
[ ! -e "$WS_ROOT" ]   || die "$WS_ROOT already exists; pick a fresh --worker id or clear it"
[ ! -e "$CODE_ROOT" ] || die "$CODE_ROOT already exists; pick a fresh --worker id or clear it"
# A sandbox is named after the TASK, not the worker, so a reassign of a sandboxed route meets
# the stranded worker's VM. Re-attaching to it is wrong, and quietly so: its mount set is an
# argument to `sbx create` and still names the OLD task root, so the new worker's wrappers,
# clones and kickoff are not visible inside it at all; its 0600 env file carries the dead
# worker's git identity; and the credential posture below cannot be re-applied after create.
# The operator removes it, which also keeps the destruction of evidence an explicit act.
if [ -n "$REASSIGN" ] && [ "$EXECUTABLE" = "sbx" ] \
   && sbx ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qxF "$SANDBOX"; then
  die "sandbox '$SANDBOX' still exists, and a reassign needs a fresh one: its mounts, its
  environment file and its credential posture are all fixed at create time, so re-attaching
  would seat '$WORKER' in a VM that cannot see its own task root. Remove it and re-run —
  the stranded task root on disk is untouched by this and stays as evidence:
    sbx rm $SANDBOX"
fi
# The one collision that still means something: a window already NAMED for this
# task. The pane name is the registry (no registry file), so a second window for
# one task would corrupt the registry — refuse, and name the recovery path.
if tmux has-session -t "$SESSION_T" 2>/dev/null \
   && tmux list-windows -t "$SESSION_T" -F '#{window_name}' 2>/dev/null | grep -qxF "$TASK"; then
  die "a tmux window named '$TASK' already exists in session '$HIVE_TMUX_SESSION' — the pane IS the registry, so this task already has a session.
  Look first: tmux attach -t '$HIVE_TMUX_SESSION', then select the '$TASK' window.
  If that worker is dead, kill the window and recover the task onto a fresh worker:
    tmux kill-window -t '$HIVE_TMUX_SESSION:$TASK'
    hive-launch $REL --reassign --reason '<why>'
  Never a second window for one task."
fi

# --- build the seed payloads ----------------------------------------------------
# SHA was pinned above, before the route was resolved, because the pinned order is what
# the execution id is derived from: two launches of the same order, purpose and attempt
# must name one execution rather than two. The pin is required — the worker's fresh clone
# comes from the hub, so the order must be committed+pushed there for it to be readable.
# In adopt mode SHA is the order at HEAD, not the acceptance ref: the adopted task keeps
# its original (seeded) task.created acceptance pin.
ACCEPTANCE="per $REL@$SHA"
# A heading-less order file is a titling problem, not a launch failure. Without
# the `|| true` the no-match `grep` fails the whole pipeline under `set -o
# pipefail`, aborting the script one line ABOVE its own fallback — which made
# that fallback dead code. The title is an advisory board label; the order file
# at its pin is what the worker actually reads.
TITLE=$( { grep -m1 -E '^# ' "$OPS_WS/$REL" | sed -E 's/^# +//; s/^Order: *//'; } || true )
[ -n "$TITLE" ] || TITLE="$TASK"
TASK_TYPE="task"   # advisory label only; not gated (events/types.py). Edit freely.

# --- predictions launch-gate: refuse an unparseable, never an absent, section --
# retro 2026-07-29 D1: the gate used to be a human reading a `## Predictions`
# HEADING while hive-score parsed bullet LABELS underneath it, so a mislabeled
# section (or a re-worded one) scored `unpredicted` with no error anywhere — the
# whole tenant project's first wave was lost exactly this way. predictions_classify
# (hive-common.sh) is the SAME parser hive-score uses; a gate that can disagree
# with the scorer is the defect this order exists to retire.
predictions_classify "$OPS_WS/$REL"
# Also exempt under --reassign, and for a sharper reason than convenience: the acceptance
# pinned on the seeded task.created is fixed, so editing the order to satisfy this gate would
# move $SHA and recover the task against a different pin than the board already carries. A
# stranded task with an unparseable predictions section would otherwise be permanently
# unrecoverable by tooling.
case "$PRED_VERDICT" in
  unparsed)
    if [ -n "$REASSIGN" ]; then
      echo "hive-launch: --reassign — recovering '$TASK' despite an unparseable '## Predictions'" >&2
      echo "  section. The gate applies at LAUNCH; this task is already on the board." >&2
    elif [ -z "$ANYWAY" ]; then
      {
        echo "hive-launch: refusing to launch '$TASK' — its '## Predictions' section does not parse (0 of 3 scored fields)."
        echo "  hive-score parses these bullet labels verbatim, case-insensitively, and nothing else"
        echo "  (design-partner PROTOCOL.md order-authoring rules — copy exactly):"
        echo "    - Expected effort: <range> — <median x multiplier, justified>"
        echo "    - Expected questions: <count or range> — <named seams, or a designed round-trip>"
        echo "    - Expected review outcome: <clean | minor rework | rework> — <why>"
        echo "    - Named risks: <what could turn the shape of the work>   (required by protocol; not scored)"
        echo "  The section as written in $REL:"
        predictions_block "$OPS_WS/$REL" | sed 's/^/    /'
        echo "  This order would score PERMANENTLY unpredicted with no error anywhere (retro 2026-07-29 D1)."
        echo "  Fix the labels, or launch it deliberately unpredicted this way: --anyway"
      } >&2
      exit 1
    fi
    echo "hive-launch: --anyway — launching '$TASK' despite an unparseable predictions section."
    ;;
  partial*)
    N="${PRED_VERDICT#partial }"
    echo "hive-launch: WARNING '$TASK' predicts only $N of 3 scored fields (missing: $(predictions_missing_fields))." >&2
    echo "  Launching anyway — partial coverage is a metric hive-score already reports." >&2
    ;;
  absent|declared-unpredicted|full) : ;;   # nothing to say — a clean launch
esac

echo "hive-launch: task=$TASK worker=$WORKER  project=$PROJECT${ADOPT:+  (adopting existing ready task)}${REASSIGN_FROM:+  (REASSIGN from $REASSIGN_FROM)}"
echo "  order:  $REL@$SHA"
echo "  run:    $RUN"

# --- provision first, emit second ---------------------------------------------
# The failure-prone work (clones) runs BEFORE any board write, so a clone failure
# leaves NO orphaned board state: clear the partial clone and re-run cleanly.
# hive clone: from the local hub. code clone: from the project's local canonical
# checkout CANON_CODE (hardlinked objects, no network, any size), then re-point
# origin at the project's CODE_REPO (the committed conf fact) so PR pushes land
# there; `git pull` inside still fetches main correctly.
[ -d "$CANON_CODE" ] || die "canonical code checkout for '$PROJECT' not found on this host: $CANON_CODE (set CANON_CODE or CANON_ROOT)"
mkdir -p "$TASK_ROOT"
git clone --quiet "$WS_HUB" "$WS_ROOT"       || die "failed to clone workspace from $WS_HUB"
git clone --quiet "$CANON_CODE" "$CODE_ROOT" || die "failed to clone code from $CANON_CODE"
# A sandboxed route gets the HTTPS spelling of the same repository. An SSH remote cannot
# work inside the VM at all: there is no key there, and SSH bypasses the sandbox's forward
# proxy entirely, so nothing can authenticate it. The proxy DOES authenticate HTTPS — sbx
# injects a sentinel GH_TOKEN and substitutes the host's stored `github` secret on the way
# out, which is what keeps a real forge credential out of the VM's filesystem. Handing a
# sandboxed worker an SSH remote made `hive publish code` structurally impossible on every
# sbx route: the worker does the work, gets reviewed, and blocks at the push (2026-08-28).
# Which routes cannot use an SSH remote: the ones whose harness runs inside a sandbox.
# Two different sandboxes, one consequence, and neither is about credentials.
#   sbx   - a microVM holding no key of its own, and SSH bypasses the forward proxy that
#           would otherwise authenticate it.
#   codex - a user-namespace sandbox in which root-owned files appear owned by an unmapped
#           uid, so OpenSSH refuses its OWN system config with "Bad owner or permissions"
#           and never reaches the forge at all (measured 2026-08-28:
#           `codex sandbox -- ssh -G github.com` fails on this host while the same command
#           outside it is clean, and the file is a correct 0644 root:root).
# Both authenticate HTTPS: the proxy inside sbx, gh's credential helper inside codex.
PUSH_REPO="$CODE_REPO"
FORGE_NEEDS_HTTPS=""
case "$EXECUTABLE:$R_HARNESS" in
  sbx:*|*:codex) FORGE_NEEDS_HTTPS=1 ;;
esac
if [ -n "$FORGE_NEEDS_HTTPS" ]; then
  case "$CODE_REPO" in
    git@*:*)      SCP_REST="${CODE_REPO#git@}"; PUSH_REPO="https://${SCP_REST/:/\/}" ;;
    ssh://git@*)  PUSH_REPO="https://${CODE_REPO#ssh://git@}" ;;
  esac
  [ "$PUSH_REPO" = "$CODE_REPO" ] \
    || echo "  forge:  $CODE_REPO -> $PUSH_REPO (HTTPS: this harness runs sandboxed and SSH cannot work there)"
fi
git -C "$CODE_ROOT" remote set-url origin "$PUSH_REPO"
# The publication branch is created here, so the worker starts on it and the plan's
# fixed `code_branch` is a branch that exists rather than one the worker must remember
# to make. A publication never asks the worker which branch it meant.
git -C "$CODE_ROOT" checkout --quiet -b "$CODE_BRANCH"
echo "  clones: $WS_ROOT  +  $CODE_ROOT (origin -> $PUSH_REPO, branch $CODE_BRANCH)"

# --- the worker's run-local interface -------------------------------------------------
# Issued by hive-common.sh so the tooling drill exercises the very wrappers a launch
# writes, rather than a second copy of them that could drift. Everything they need is a
# parameter; nothing is read back out of the worker's root.
issue_worker_interface "$RUN_DIR" "$WS_ROOT" "$CODE_ROOT" "$CODE_BRANCH" "$RUN" "$WORKER" \
  "$R_REVIEWER" "$ROUTE_ENV_NAMES"
# The worker's cwd, recorded as trusted in whichever store its harness reads, before the
# window exists to ask about it. Only for a harness running on THIS host: a sandboxed route's
# store is inside its VM, and is the kit's business or the sandbox block's, not this line's.
if [ "$EXECUTABLE" != "sbx" ]; then
  register_workspace_trust "$R_HARNESS" "$WS_ROOT"
fi
echo "  emit:   $WRAPPER"
echo "  bridge: $BRIDGE  (sync workspace | publish workspace | publish code)"
# Which reviewer a launch issued is now a per-route fact, so it belongs in the launch
# record rather than only in the worker's prompt: an operator reading back a session needs
# to be able to see whether an in-VM reviewer existed for it.
if [ -f "$RUN_DIR/review" ]; then
  echo "  review: $RUN_DIR/review  (opus on the subscription, this route's routing stripped)"
else
  echo "  review: ${R_REVIEWER:-unstated} (no in-VM command; the worker reaches its reviewer itself)"
fi

# --- the sandbox, when the route names one ---------------------------------------------
# The one harness-specific thing this launcher knows, and only because it CANNOT be argv:
# a microVM has to exist, with the right host paths mounted, the right environment baked in
# and a working path to the spine, before anything can attach to it. `sbx create` takes the
# first two as flags at creation time and `sbx run --name` re-attaches to whatever was
# created — so the route's argv can express the attach and not the create.
#
# What is mounted, and why exactly this set:
#
#   $TASK_ROOT   rw   the worker's own root — both clones and its run-local interface.
#                     sbx mounts a host path at the SAME absolute path inside the VM, so
#                     `../run/emit` and `../run/hive` resolve in there byte-identically to
#                     the host, and one operator-approved runner rule still covers every
#                     task. This is the whole reason the task root is mounted rather than
#                     `--clone`d: a clone would put ONE git repo in the VM, and a worker
#                     needs the workspace clone, the code clone and the interface.
#   $WS_HUB      rw   the local workspace hub, so `../run/hive publish workspace` pushes
#                     from inside the VM instead of failing at the boundary.
#
# And nothing else — in particular NOT the canonical checkout. It was mounted read-only for a
# while as the source of the `uv tool install` below, which also handed the VM every untracked
# file sitting in the operator's working tree: `.env` and its DSNs among them. The CLI now
# installs from a CLONE inside the task root, and a clone carries tracked files only. That was
# never a decision, it was a side effect of needing an install source.
#
# The worker can therefore write its own clones and the hub, and nothing else on the host:
# not another repo, not the operator's home, not the checkout its CLI was built from. That is
# its legitimate write set, and it is a strictly smaller one than a bare route has.
if [ "$EXECUTABLE" = "sbx" ]; then
  # Everything a sandbox needs is resolved for BOTH paths — a fresh create and a re-attach —
  # because a re-attach that assumed the last create's work is still standing was shipping
  # workers with no write path: the forwarder below is a process, a sandbox stop takes it,
  # and the recovery case is exactly a sandbox that stopped. The create path died loudly for
  # that condition while the recovery path printed success (review finding, 2026-08-24).

  # The launching environment wins over the deployment file, which is what lets a launch
  # be pointed at a SCRATCH spine without editing the deployment's secrets — the same seam
  # OMEGAHIVE_COMPOSE and HIVE_CLI_CMD are. With nothing set, the deployment's own
  # gateway.env is the source, so an ordinary launch needs no environment at all.
  if [ -n "${OMEGAHIVE_GATEWAY_DATABASE_URL:-}" ]; then
    GW_DSN="$OMEGAHIVE_GATEWAY_DATABASE_URL"
  else
    GW_ENV="${OMEGAHIVE_SECRETS_DIR:-$HOME/.config/omegahive/secrets}/gateway.env"
    [ -f "$GW_ENV" ] || die "a sandboxed route needs the gateway DSN to hand the worker's CLI,
  and there is no $GW_ENV on this host. The worker would have no write path to the spine."
    GW_DSN=$(grep -m1 '^OMEGAHIVE_GATEWAY_DATABASE_URL=' "$GW_ENV" | cut -d= -f2-)
    [ -n "$GW_DSN" ] || die "$GW_ENV names no OMEGAHIVE_GATEWAY_DATABASE_URL."
  fi

  # --- how the DSN reaches the spine from inside a microVM ---------------------------
  # Not by naming the host. A sandbox egresses through an HTTP/TLS proxy that terminates
  # raw TCP and drops it, and refuses `host.docker.internal` outright — measured on
  # Beastie 2026-08-24, where a direct connect appears to SUCCEED and the listener on the
  # far side never sees it. Anything that trusts a TCP handshake here will report a
  # working spine and have none.
  #
  # What the proxy does honour is HTTP CONNECT to an allowlisted host, and that carries an
  # arbitrary byte stream. So the worker's CLI connects to 127.0.0.1 inside the VM (which
  # the sandbox's own NO_PROXY excludes), and a forwarder started below tunnels that to the
  # spine's ROUTABLE address through the proxy. The DSN the worker holds names neither the
  # tunnel nor the proxy; it is an ordinary loopback DSN.
  SPINE_ADDR="${HIVE_SANDBOX_SPINE:-}"
  if [ -z "$SPINE_ADDR" ] && command -v tailscale >/dev/null 2>&1; then
    SPINE_TS=$(tailscale ip -4 2>/dev/null | head -1)
    [ -z "$SPINE_TS" ] || SPINE_ADDR="$SPINE_TS:5433"
  fi
  [ -n "$SPINE_ADDR" ] || die "a sandboxed route needs an address for the spine that is ROUTABLE
  from inside the microVM; a host-local one is refused by the sandbox's egress proxy.
  Publish Postgres on this host's tailnet address (docker-compose.yml's
  OMEGAHIVE_PG_TAILNET_BIND, host port 5433) and name it here:
    export HIVE_SANDBOX_SPINE=<host-or-ip>:5433
  Nothing was created, cloned or emitted."
  SPINE_HOST="${SPINE_ADDR%:*}"
  SPINE_PORT="${SPINE_ADDR##*:}"
  # The DSN's own host:port is replaced wholesale rather than patched per spelling: the
  # deployment writes `@postgres:5432`, an operator override may write `@localhost:5432`,
  # and inside the VM both are the same loopback tunnel.
  GW_DSN_VM=$(printf '%s' "$GW_DSN" | sed -E 's#@[^@/]+:[0-9]+/#@127.0.0.1:5432/#')
  case "$GW_DSN_VM" in
    *@127.0.0.1:5432/*) : ;;
    *) die "could not rewrite the gateway DSN for the sandbox: it does not carry a
  host:port before its database name. Refusing to hand a worker a DSN this build cannot
  reason about." ;;
  esac

  # Which sbx agent image serves this harness, and which kit (if any) defines it. Named here
  # rather than dug out of the argv by position: an agent read off `args[N]` would break the
  # day a route gained a flag, and it would break silently, by creating a sandbox for the
  # wrong harness. It is also not a catalog field, and that is deliberate — the agent name
  # gates credential posture below, so a route that could choose it could ask for the
  # operator's Claude login to be copied into any VM it liked. This map is an allowlist.
  #
  # A KIT is the same decision one level up: a declarative spec that supplies an agent sbx
  # does not ship, including its image, its network allowlist and its credential wiring. Same
  # reasoning, so the same place — and the kit is a directory in THIS repository, resolved
  # from REPO_ROOT (the launcher's own location with symlinks followed) rather than under
  # CANON_ROOT, so the kit a launch uses is always the one that shipped with the launcher it
  # is running, however that launcher was named. Vendored rather than referenced at
  # somebody's HEAD, because a deployment input that can change under us is not an input we
  # have authorized.
  SBX_KIT=""
  case "$R_HARNESS" in
    claude-code|claude) SBX_AGENT=claude ;;
    codex)              SBX_AGENT=codex ;;
    omp|shell)          SBX_AGENT=shell ;;
    opencode)           SBX_AGENT=opencode ;;
    antigravity)        SBX_AGENT=agy; SBX_KIT="$REPO_ROOT/kits/agy" ;;
    *) die "route '$ROUTE_NAME' runs under sbx with harness '$R_HARNESS', and this build
  does not know which sbx agent image serves it. Add it to hive-launch's agent map, or
  run this harness on a non-sandboxed route." ;;
  esac

  # A Codex SUBSCRIPTION cannot be carried into a sandbox at all: sbx's credential proxy
  # forces API-key billing for OpenAI and its interception, not its allowlist, is the wall
  # (probe, 2026-08-24). Turning injection off leaves the harness with nothing, so such a
  # route would build a VM, open a tunnel, seed the board and open a window onto a session
  # that cannot authenticate. Refuse it here, before any of that, and name the two routes
  # that do work.
  if [ "$SBX_AGENT" = "codex" ] && [ "$R_MARKET" = "subscription" ]; then
    die "route '$ROUTE_NAME' runs Codex inside sbx on a subscription, which cannot work:
  the sandbox's credential proxy forces API-key billing for OpenAI and blocks ChatGPT
  auth passthrough (probe, 2026-08-24). Run Codex in its own landlock sandbox instead
  (a non-sbx route), or make this an api-billed route. Nothing was created or emitted."
  fi

  # The one credential prerequisite, checked BEFORE anything is built. It used to be checked
  # after `sbx create`, which left a named half-configured VM behind on the one failure it
  # exists to catch — and the next attempt then saw that VM as "existing" and skipped the
  # credential setup entirely, while the ordinary launch could not be retried either because
  # its clones were already there (cross-harness review, 2026-08-24).
  # The operator's Claude subscription credential goes into a sandbox for either of two
  # reasons, and they are not the same reason. The WORKER needs it when the harness in there
  # is Claude Code. The REVIEWER needs it when the route's review runs inside the VM, whatever
  # the worker is — that is what `reviewer: opus-in-sandbox` says, and an OpenRouter worker's
  # Opus review has always depended on it.
  #
  # Until 2026-09-03 both were tested as `SBX_AGENT = claude`, and the comment here described
  # the reviewer while the condition read the worker. Nothing exposed it, because every
  # sandboxed route in the catalog ran the claude agent, so the two were the same set. A
  # sandbox running some other agent breaks the coincidence: its in-VM reviewer would need the
  # login and silently not get one, and the worker would discover that at review time, having
  # done all the work. Read the two facts separately, because they are two facts.
  CRED_FOR_WORKER=""
  [ "$SBX_AGENT" != "claude" ] || CRED_FOR_WORKER=1
  CRED_FOR_REVIEWER=""
  [ "$R_REVIEWER" != "opus-in-sandbox" ] || CRED_FOR_REVIEWER=1

  SBX_CLAUDE_CRED=""
  if [ -n "$CRED_FOR_WORKER$CRED_FOR_REVIEWER" ]; then
    if [ -f "$HOME/.claude/.credentials.json" ]; then
      SBX_CLAUDE_CRED=1
    elif [ -n "$CRED_FOR_WORKER" ] && [ "$R_MARKET" = "subscription" ]; then
      # Only a subscription WORKER cannot start without it. A reviewer that has no login is a
      # review that refuses later, loudly, which is a worse outcome but not an unstartable one.
      die "route '$ROUTE_NAME' bills a subscription, and there is no
  $HOME/.claude/.credentials.json to hand the sandbox. Log in on the host first — launching
  would run this worker on whatever credential the sandbox proxy supplies, and bill an
  account the spine fact does not name. Nothing was created or emitted."
    else
      echo "  sandbox: WARNING no host Claude credential, so a review invoked inside the VM" >&2
      echo "           on the subscription will have no login to use." >&2
    fi
  fi

  SBX_AGY_CRED=""
  [ "$SBX_AGENT" != "agy" ] || SBX_AGY_CRED=1

  # opencode is configured by a FILE, not by environment variables, so a route that names
  # it needs one written for this launch: this model, this deployment's context limit, and
  # the compaction plugin beside it. Written before the VM is built and rewritten on a
  # re-attach for the same reason `.sandbox-env` is — the catalog can change between a
  # create and a re-attach, and a sandbox pointed at last week's model is not the sandbox
  # this launch is about to announce. Issued by hive-common.sh so the test suite exercises
  # the very file a launch writes rather than a second copy of it.
  SBX_OPENCODE_CFG=""
  if [ "$SBX_AGENT" = "opencode" ]; then
    # Two facts the generated config needs, both read off the ROUTE rather than assumed:
    # where the provider is, and under which NAME the VM holds its key. The name is what
    # `{env:...}` resolves in the config, so getting it wrong produces a config that looks
    # right and authenticates as nobody.
    #
    # Exactly one credential name, or a refusal. A route carrying several gives this code
    # no way to tell which one opencode should read, and picking the first would be a
    # coin toss settled by jq's output order. The refusal is cheap; it fires before the VM
    # exists, and it names both the route and what to write instead.
    OPENCODE_KEY_NAME=$(printf '%s' "$ROUTE" | jq -r '
      (.runner.inherit_env[]?), ((.runner.inherit_env_as // {}) | keys[])' | sort -u)
    [ -n "$ENDPOINT_URL" ] || die "route '$ROUTE_NAME' runs the opencode harness but declares no
  provider endpoint in runner.env. opencode reaches a provider through a generated config,
  and this launch has no URL to put in it. Nothing was created or emitted."
    case "$(printf '%s' "$OPENCODE_KEY_NAME" | wc -w)" in
      1) : ;;
      0) die "route '$ROUTE_NAME' runs the opencode harness but inherits no credential name.
  The generated config reads the provider key from the VM's environment by name, so there
  is nothing for it to read. Nothing was created or emitted." ;;
      *) die "route '$ROUTE_NAME' runs the opencode harness and inherits several environment
  names ($OPENCODE_KEY_NAME). This build cannot tell which one holds the provider key, and
  guessing would produce a config that authenticates as nobody. Leave exactly one inherited
  name on the route in $HIVE_ROUTE_CATALOG. Nothing was created or emitted." ;;
    esac
    SBX_OPENCODE_CFG="$TASK_ROOT/opencode.json"
    issue_opencode_config "$TASK_ROOT" "$ENDPOINT_URL" "$OPENCODE_KEY_NAME" "$MODEL" \
      "$HIVE_OPENCODE_CONTEXT_LIMIT" "$HIVE_OPENCODE_COMPACTION_MODEL"
    echo "  opencode: $SBX_OPENCODE_CFG (context limit $HIVE_OPENCODE_CONTEXT_LIMIT, compaction on $HIVE_OPENCODE_COMPACTION_MODEL)"
  fi

  # The VM's environment file. Written on BOTH paths, because the facts in it come from the
  # route and the route can change between a create and a re-attach — an endpoint amended in
  # the catalog that never reached an existing VM would leave the worker pointed at the old
  # provider while the egress allowlist below, derived from the same facts, pointed at the new
  # one. The file is 0600 and is never an argument: a DSN carries a password, and an argument
  # is visible in `ps` to every process on the host for as long as the create runs.
  SBX_ENV_FILE="$TASK_ROOT/.sandbox-env"
  write_sandbox_env() {
    # The redirection wraps the WHOLE group, not just the heredoc. With `cat > file` alone,
    # everything appended after it went to this script's stdout instead — which printed a
    # provider key to the operator's terminal and left the sandbox without it (2026-08-24).
    ( umask 077
      {
        cat <<SBXENV
OMEGAHIVE_GATEWAY_DATABASE_URL=$GW_DSN_VM
OMEGAHIVE_DATABASE_URL=$GW_DSN_VM
HIVE_CLI_CMD=omegahive
GIT_AUTHOR_NAME=$WORKER
GIT_AUTHOR_EMAIL=$WORKER@hive.local
GIT_COMMITTER_NAME=$WORKER
GIT_COMMITTER_EMAIL=$WORKER@hive.local
SBXENV
      # Which config opencode reads. Named explicitly because opencode's own discovery
      # walks up from the project directory and stops at the git root, and the project here
      # IS a git clone — so a file in the task root above it would never be found. Setting
      # it MERGES with the sandbox template's global config rather than replacing it.
      [ -z "$SBX_OPENCODE_CFG" ] || printf 'OPENCODE_CONFIG=%s\n' "$SBX_OPENCODE_CFG"
      # The route's own environment facts, in the one place a value can travel without
      # appearing on a command line that `ps` can read.
      #
      # `runner.env` first: the provider endpoint, straight out of the catalog. This is the
      # line whose absence cost the 2026-08-28 launch — it used to depend on the operator
      # having exported ANTHROPIC_BASE_URL, and when they had not, the launcher skipped it in
      # silence. There is nothing left to skip: the value is a route fact.
      [ -z "$ENV_PAIRS" ] || printf '%s\n' "$ENV_PAIRS"
      # Then the inherited names. Every one of them is set — require_declared_env proved that
      # before anything was built — so there is no skip here, and a name that went missing
      # between then and now is a genuine anomaly rather than a silent omission.
      while IFS= read -r n; do
        [ -n "$n" ] || continue
        [ -n "${!n+set}" ] || die "'$n' became unset during the launch of '$TASK'; refusing to
  build a sandbox environment that is missing a name the route declares."
        printf '%s=%s\n' "$n" "${!n}"
      done < <(printf '%s' "$ROUTE" | jq -r '.runner.inherit_env[]?')
      # And the renames: the harness reads NAME, the host holds it under SOURCE. An or-* route
      # reads ANTHROPIC_API_KEY and the host holds OPENROUTER_API_KEY, so inheriting the
      # target name directly would have shipped whatever ANTHROPIC_API_KEY happened to be —
      # on this deployment, the real Anthropic key, under the right name, with no error.
      while IFS=$'\t' read -r n src; do
        [ -n "${src:-}" ] || continue
        [ -n "${!src+set}" ] || die "'$src' became unset during the launch of '$TASK'; refusing to
  build a sandbox environment that is missing a name the route declares."
        printf '%s=%s\n' "$n" "${!src}"
      done < <(printf '%s' "$ROUTE" | jq -r '(.runner.inherit_env_as // {}) | to_entries[] | "\(.key)\t\(.value)"')
      } > "$SBX_ENV_FILE"
    )
  }
  write_sandbox_env

  if sbx ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qxF "$SANDBOX"; then
    # Re-launching onto an existing sandbox is recovery, not a fresh seat, and it is the
    # operator's call rather than this script's: a sandbox that already exists holds a
    # previous worker's state. Its tunnel and CLI are re-established below, because a VM
    # with the right name is not the same thing as a working worker.
    echo "  sandbox: $SANDBOX (exists — re-attaching; 'sbx rm $SANDBOX' first for a clean VM)"
  else
    # --- which credential actually pays for this route ---------------------------------
    # sbx ships its agent templates wired for API billing: the claude template writes
    # `apiKeyHelper` into the sandbox's settings.json and sets SBX_CRED_ANTHROPIC_MODE=apikey,
    # and its host-side proxy then rewrites the Authorization header with a stored API key.
    # That is exactly right for a route whose billing_market is `api` — the key never enters
    # the VM — and exactly WRONG for a subscription route, because it works: the session
    # runs, answers, and bills the API account while the catalog row (and the spine fact
    # this launcher emits) says `subscription`. Measured on Beastie 2026-08-24: with the
    # template untouched, Claude Code warns "ANTHROPIC_API_KEY or another auth source is set
    # and takes precedence over your claude.ai login" and answers anyway.
    #
    # So the credential posture is keyed on the catalog's OWN field rather than guessed. It
    # is the same class of defect PR #55 guarded against in the other direction: a harness
    # that quietly satisfies itself from the wrong account produces a record that is false
    # about what paid for the work.
    SBX_CREATE_ENV=()
    # Injection off for every sandbox that receives the operator's Claude login — which is
    # what SBX_CLAUDE_CRED means, and is deliberately NOT the same test as "the worker is
    # Claude Code". The proxy substituting a stored Anthropic API key is what made a
    # mis-billed run silent rather than loud, and no route here should pay for Claude
    # traffic that way: a subscription worker uses the copied login, an OpenRouter worker
    # never talks to Anthropic, and an in-VM reviewer uses the same copied login.
    #
    # Keyed on the agent until 2026-09-08, which left a real hole the moment a non-claude
    # agent got the credential: the Antigravity kit runs the claude-code-docker image, whose
    # template wires apiKeyHelper AND SBX_CRED_ANTHROPIC_MODE=apikey. That sandbox took the
    # login, left injection on, and the line below announced "proxy injection off" about a
    # posture nothing had set.
    if [ -n "$SBX_CLAUDE_CRED" ]; then
      SBX_CREATE_ENV+=(--env SBX_CRED_ANTHROPIC_MODE=off)
    fi
    SBX_KIT_ARG=()
    if [ -n "$SBX_KIT" ]; then
      [ -d "$SBX_KIT" ] || die "route '$ROUTE_NAME' runs the '$R_HARNESS' harness, which is
  defined by the kit at $SBX_KIT, and that directory does not exist. The kit ships with this
  repository; a checkout missing it cannot build this sandbox. Nothing was created or emitted."
      SBX_KIT_ARG=(--kit "$SBX_KIT")
    fi
    echo "  sandbox: creating $SANDBOX (agent $SBX_AGENT${SBX_KIT:+ via kit $SBX_KIT}, billing $R_MARKET)"
    sbx create --quiet --name "$SANDBOX" --env-file "$SBX_ENV_FILE" \
      ${SBX_KIT_ARG+"${SBX_KIT_ARG[@]}"} \
      ${SBX_CREATE_ENV+"${SBX_CREATE_ENV[@]}"} \
      "$SBX_AGENT" "$TASK_ROOT" "$WS_HUB" \
      || die "sbx create failed for '$SANDBOX'; nothing was emitted and the clones are at $TASK_ROOT."

  fi

  # --- the subscription credential posture, on BOTH paths --------------------------------
  # A subscription is OAuth, and the proxy does not carry it: the credential file is copied in,
  # and the template's `apiKeyHelper` is removed because it takes PRECEDENCE over the copied
  # login. Removing it is the half that actually changes which account pays — copying the
  # credentials alone leaves the session on the API key, silently.
  #
  # Both steps run on a re-attach too, and are idempotent. Skipping them there was the same
  # defect in a second place: a sandbox that already existed could run with no OAuth credential,
  # or on the proxy's API key, while the `execution.route_approved` this launcher emits said
  # `subscription` (cross-harness review, 2026-08-24).
  # Antigravity first, because it is the worker's own credential and a worker that cannot
  # reach its model has nothing to review. Idempotent, and on both paths for the reason the
  # Claude copy is: a sandbox that already existed may predate the token it needs.
  if [ -n "$SBX_AGY_CRED" ]; then
    sbx cp "$AGY_TOKEN" "$SANDBOX:/home/agent/.gemini/antigravity-cli/antigravity-oauth-token" \
      >/dev/null 2>&1 \
      || die "could not copy the Antigravity login into '$SANDBOX'."
    echo "  sandbox: antigravity login installed"
  fi

  if [ -n "$SBX_CLAUDE_CRED" ]; then
    sbx cp "$HOME/.claude/.credentials.json" "$SANDBOX:/home/agent/.claude/.credentials.json" \
      >/dev/null 2>&1 \
      || die "could not copy the Claude subscription credential into '$SANDBOX'."
    # shellcheck disable=SC2016  # the inner script is for the sandbox's shell, not this one
    sbx exec "$SANDBOX" bash -lc \
      'f=~/.claude/settings.json; [ -f "$f" ] || exit 0; jq "del(.apiKeyHelper)" "$f" > "$f.tmp" && mv "$f.tmp" "$f"' \
      || die "could not clear the sandbox's apiKeyHelper in '$SANDBOX'. Leaving it would run
  this subscription route on the proxy's API key."
    # The one piece that CANNOT be re-applied after the fact: credential injection is baked at
    # create time. So it is verified rather than assumed, and a sandbox whose posture does not
    # match the route's billing is refused instead of quietly billing the other account.
    # Only for the claude agent template: it is that template which sets the variable and whose
    # proxy would otherwise substitute an API key. Verified for exactly the sandboxes the
    # create path sets it on — those holding the login — so the check and the thing it checks
    # cannot drift apart the way they did when one read the agent and the other the credential.
    SBX_CRED_MODE=$(sbx exec "$SANDBOX" printenv SBX_CRED_ANTHROPIC_MODE 2>/dev/null | tr -d '\r' || true)
    [ "$SBX_CRED_MODE" = "off" ] || die "sandbox '$SANDBOX' has SBX_CRED_ANTHROPIC_MODE='${SBX_CRED_MODE:-unset}',
  but it holds the operator's Claude login. Credential injection is fixed at create time, so
  this VM would run its Claude traffic on the proxy's API key while the spine fact says
  subscription. Remove it and launch again:  sbx rm $SANDBOX"
    echo "  sandbox: Claude login installed (proxy injection off, apiKeyHelper cleared)"
  fi

  # --- the spine tunnel, established on BOTH paths ---------------------------------------
  # Two pieces, both scoped to THIS sandbox: an allow rule for exactly the spine's address,
  # and a forwarder inside the VM that carries loopback:5432 to it over the proxy's CONNECT.
  # Both are idempotent, which is what lets the re-attach path run them rather than assume
  # them — the forwarder is a process, and a sandbox that stopped no longer has one.
  #
  # The allow rule is per-sandbox rather than global: every other sandbox on this host keeps
  # its default deny, so authorizing one worker to reach the spine authorizes exactly one.
  sbx policy allow network --sandbox "$SANDBOX" "$SPINE_ADDR" >/dev/null 2>&1 \
    || die "could not allow '$SPINE_ADDR' for sandbox '$SANDBOX'; its worker would have no
  write path to the spine."

  # And the provider endpoint the route points its harness at, for the same reason and by the
  # same rule: sbx egress is default-deny, and an agent template's allowlist covers the
  # provider IT expects, not the one a route redirected the harness to. Measured 2026-08-24,
  # where an OpenRouter worker in a claude sandbox got
  # `403 Blocked by network policy: domain openrouter.ai:443`.
  #
  # Derived from `runner.env` — the route — and not, as it was until 2026-08-28, by scanning
  # the launching environment for values that happened to look like URLs. That scan is how the
  # rule went missing: the name it depended on was unset, the value it would have matched
  # never existed, and a loop that finds nothing looks exactly like a route with no endpoint.
  # The same catalog now produces the same allowlist on any host, which is the only version of
  # this rule that can be reasoned about before a launch rather than after one.
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    host="${v#*://}"; host="${host%%/*}"
    [ -n "$host" ] || die "route '$ROUTE_NAME' declares the endpoint '$v', which carries no
  host. Refusing to build a sandbox whose egress rule cannot be derived from its route."
    sbx policy allow network --sandbox "$SANDBOX" "$host" >/dev/null 2>&1 \
      || die "could not allow the provider endpoint '$host' for sandbox '$SANDBOX'; the
  harness would be refused by the sandbox's egress policy on its first call."
    echo "  sandbox: provider endpoint allowed ($host, from the route)"
  done < <(printf '%s\n' "$ENV_PAIRS" | sed -n 's/^[^=]*=\(https\{0,1\}:\/\/.*\)$/\1/p')

  # `pgrep -x socat`, matching the EXECUTABLE name and not the command line: `pgrep -f` on the
  # forwarder's own argv matches the very shell that is asking, so the guard reported a running
  # tunnel to itself and never started one.
  #
  # `nohup … &` inside a login shell, wrapped in a restart loop: socat exits when a tunnelled
  # connection is torn down abnormally, and one dead forwarder would silently end the
  # worker's ability to emit for the rest of the task. A sandbox STOP still takes it, which
  # is why the probe below runs on every launch rather than only on a fresh create.
  sbx exec -d "$SANDBOX" bash -lc \
    "pgrep -x socat >/dev/null || nohup sh -c 'while true; do socat TCP-LISTEN:5432,fork,reuseaddr,bind=127.0.0.1 PROXY:gateway.docker.internal:$SPINE_HOST:$SPINE_PORT,proxyport=3128; sleep 1; done' >/tmp/spine-tunnel.log 2>&1 &" \
    >/dev/null 2>&1 || true
  # The return code above is deliberately ignored: `sbx exec -d` reports failure while
  # having launched (omp-arm runner, 2026-08-24). What is trusted is the tunnel ANSWERING,
  # which is checked here rather than assumed — a Postgres SSLRequest, whose reply proves
  # the proxy tunnelled it AND that a real server is on the far side. A TCP handshake would
  # prove neither, which is exactly how this seam was mis-measured the first time.
  echo "  sandbox: opening the spine tunnel to $SPINE_ADDR"
  if ! sbx exec "$SANDBOX" python3 -c "
import socket, sys, time
for attempt in range(20):
    try:
        s = socket.create_connection(('127.0.0.1', 5432), 2)
        s.sendall((8).to_bytes(4, 'big') + (80877103).to_bytes(4, 'big'))
        if s.recv(1) in (b'S', b'N'):
            sys.exit(0)
    except OSError:
        pass
    time.sleep(1)
sys.exit(1)
" >/dev/null 2>&1; then
    die "the spine tunnel in '$SANDBOX' never answered. The worker would have no write path.
  Check it by hand:
    sbx exec $SANDBOX cat /tmp/spine-tunnel.log
    sbx policy check network $SPINE_ADDR --sandbox $SANDBOX
  The commonest cause is that Postgres is not published on $SPINE_ADDR — see
  docker-compose.yml's OMEGAHIVE_PG_TAILNET_BIND. Nothing was emitted."
  fi

  # A route that supplies its own provider key gets that key PRE-APPROVED inside the VM.
  # Claude Code asks "detected a custom API key in your environment — use it?" and defaults to
  # No, which stops a launch dead on a prompt the operator must answer by hand for every task.
  # The answer lives in `~/.claude.json` as the key's last 20 characters under
  # `customApiKeyResponses.approved`, and the sandbox computes that from the key ALREADY in its
  # own environment — so no fragment of the credential crosses the boundary on a command line.
  if [ "$SBX_AGENT" = "claude" ]; then
    # shellcheck disable=SC2016  # the inner script runs in the sandbox, against its own env
    sbx exec "$SANDBOX" bash -lc 'python3 - <<PYEOF
import json, os, pathlib
key = os.environ.get("ANTHROPIC_API_KEY", "")
if key:
    p = pathlib.Path.home() / ".claude.json"
    d = json.loads(p.read_text()) if p.exists() else {}
    r = d.setdefault("customApiKeyResponses", {"approved": [], "rejected": []})
    suffix = key[-20:]
    if suffix not in r.setdefault("approved", []):
        r["approved"].append(suffix)
    if suffix in r.setdefault("rejected", []):
        r["rejected"].remove(suffix)
    p.write_text(json.dumps(d))
PYEOF' >/dev/null 2>&1 \
      || echo "  sandbox: WARNING could not pre-approve the provider key; the harness will ask" >&2
  fi

  # The governed CLI, installed INSIDE the VM. The host's compose path is not available in
  # there (the image has no podman), and a venv built on the host would carry the host's
  # interpreter path, so it is built in the VM from source — about fifteen seconds, paid here
  # rather than by the worker's first emit.
  #
  # The source is a CLONE of the canonical checkout, made inside the task root. A clone
  # carries tracked files only, which is the point: the operator's own working tree holds
  # untracked deployment files, and mounting it to get an install source handed all of them
  # to the worker. It also installs a SNAPSHOT, so a worker doing omegahive work cannot break
  # the CLI it emits through by editing source mid-task.
  #
  # Checked rather than assumed on every launch, for the same reason the tunnel is: a
  # re-attached sandbox may predate either.
  if ! sbx exec "$SANDBOX" bash -lc 'command -v omegahive >/dev/null' >/dev/null 2>&1; then
    if [ ! -d "$CLI_SRC" ]; then
      git clone --quiet "$OMEGA_DIR" "$CLI_SRC" \
        || die "could not clone the CLI source from $OMEGA_DIR to $CLI_SRC; the worker would
  have no emit path."
    fi
    echo "  sandbox: installing the governed CLI (uv tool install, from $CLI_SRC)"
    sbx exec "$SANDBOX" bash -lc "uv tool install --quiet '$CLI_SRC'" \
      || die "could not install the omegahive CLI inside '$SANDBOX'. The worker would have no
  emit path. Inspect it with:  sbx exec $SANDBOX bash -l"
  fi

  # --- can this sandbox actually publish? -----------------------------------------------
  # Asked here, before the board is written to, because the alternative is what happened on
  # 2026-08-28: the worker read its order, did the work, obtained its review, and only then
  # discovered that nothing in the VM could authenticate to the forge. A whole session's
  # spend to learn a deployment fact that one call answers.
  #
  # sbx injects a sentinel GH_TOKEN and its proxy substitutes the host's stored `github`
  # secret on the way out; with no such secret stored, the sentinel reaches the forge
  # unchanged and 401s. That is a host configuration gap, and the fix is one command, so the
  # refusal names it.
  #
  # TWO questions, because one of them used to answer for both and answered it wrong. This
  # check ran `git ls-remote` alone and printed "reachable and authenticated" — and against a
  # PUBLIC repository ls-remote succeeds with no credential at all. Measured 2026-09-08: an
  # anonymous ls-remote from inside a sandbox with a dead sentinel token exits 0. So the
  # launch announced an authentication it had not tested, and the worker learned the truth
  # after writing the docs, obtaining its review and reaching the push.
  #
  # `gh api user` is the question that cannot be answered without a credential, and it is the
  # check this deployment's own sandboxed-route documentation already specifies. Reachability
  # is still asked, separately, so the two failures stay distinguishable in the message.
  if [ -z "${HIVE_SKIP_FORGE_CHECK:-}" ]; then
    FORGE_OUT=$(sbx exec "$SANDBOX" bash -lc \
      "timeout 45 git ls-remote --exit-code '$PUSH_REPO' HEAD >/dev/null 2>&1; r=\$?; \
       if command -v gh >/dev/null 2>&1; then timeout 45 gh api user --jq .login >/dev/null 2>&1; a=\$?; else a=9; fi; \
       echo \"\$r \$a\"" 2>/dev/null) \
      || FORGE_OUT=""
    case "${FORGE_OUT//[$'\r\n']/}" in
      "0 0")  echo "  sandbox: forge reachable and authenticated ($PUSH_REPO)" ;;
      "0 9")  echo "  sandbox: WARNING no gh inside '$SANDBOX', so the credential could not be
           tested; the forge answers, but publication is UNVERIFIED" >&2 ;;
      '')     echo "  sandbox: WARNING could not run the forge check inside '$SANDBOX'; publication is UNVERIFIED" >&2 ;;
      *)      die "sandbox '$SANDBOX' cannot authenticate to the code forge:
    $PUSH_REPO
  The worker would do the whole order and block at 'hive publish code'. sbx gives the VM a
  sentinel GH_TOKEN and its proxy swaps in the host's stored 'github' secret; if none is
  stored, the sentinel is what reaches the forge. Store one — the dynamic form tracks your
  gh login instead of going stale:
    sbx secret set github --command 'gh auth token'
  A secret is bound when a sandbox is CREATED, so remove this one and relaunch:
    sbx rm $SANDBOX
  Set HIVE_SKIP_FORGE_CHECK=1 to launch anyway." ;;
    esac
  fi
fi

assigned_payload=$(jq -cn --arg w "$WORKER" '{worker:$w}')
registered_payload=$(jq -cn --arg w "$WORKER" '{worker_id:$w}')
reassigned_payload=$(jq -cn --arg f "$REASSIGN_FROM" --arg t "$WORKER" --arg r "$REASSIGN_REASON" \
  '{from:$f, to:$t} + (if $r == "" then {} else {reason:$r} end)')

# --- the route fact, BEFORE task.assigned -------------------------------------
# Ordering is the point, not a detail. `execution.route_approved` is the operator's
# signature on a spend decision, and it must be on the spine before the task is handed
# to anyone — so that a task can never be found to have been worked without a recorded,
# attributable decision about what would work it. It is emitted as `human`, by the
# operator actor, because the launcher executes a signed intent and never signs one.
#
# It is now built HERE rather than read out of a resolver plan, and it is the ONLY
# execution fact this path emits. `execution.started` and `execution.finished` were
# instrument observations made by the turn runner; with the turn runner off the production
# path there is no instrument, and a launcher emitting them would be self-report wearing an
# instrument's role. So they are not emitted, the executions projection shows no row for an
# interactive launch, and that is the truthful record: nothing observed these runs. Cost
# telemetry comes from the harness's own transcripts and the vendor dashboards
# (2026-08-23-direction.md §3).
#
# Every value below is reproducible by hand from the catalog and the pinned order, on
# purpose — the execution id and both digests use the same construction the Python resolver
# used, so an id computed either way names the same execution.
# The attempt number, and not the constant 1 it used to be. EXEC_ID is derived from the order
# pin, and a recovery usually runs against an UNCHANGED pin — so a hardcoded attempt would mint
# the same execution id as the launch that stranded the task, collapsing two separate spend
# decisions into one identity. That is precisely the lie the construction below exists to
# prevent, and acceptance of this repair turns on being able to say which execution answered.
ATTEMPT=1
if [ -n "$REASSIGN_FROM" ]; then
  PRIOR=$(hive report "$RUN" --json 2>/dev/null \
    | jq --arg t "$TASK" '[.[] | select(.event_type == "execution.route_approved" and .task_id == $t)] | length' 2>/dev/null) \
    || die "could not read run '$RUN' to number this recovery's attempt. Refusing rather than
  defaulting to 1, which would reuse the stranded launch's execution id."
  case "$PRIOR" in ''|*[!0-9]*) die "unexpected attempt count '$PRIOR' for task '$TASK' on run '$RUN'." ;; esac
  ATTEMPT=$(( PRIOR + 1 ))
fi
EXEC_ID="${TASK:0:100}-a${ATTEMPT}-$(printf '%s' "$REL@$SHA|$TASK|work|$ATTEMPT" | sha256_hex | cut -c1-10)"
CATALOG_DIGEST="sha256:$(sha256_hex < "$HIVE_ROUTE_CATALOG")"
# Over the resolved NON-SECRET runner configuration — executable, static argument vector,
# inherited environment NAMES — and over the catalog's template rather than this launch's
# expansion of it, because the question it answers is "is this the same runner CONFIGURATION
# as last time". Which model ran is a separate field, and it is recorded as such.
# The key set and the sort order here reproduce `RunnerSpec.fingerprint()` byte for byte
# (harness/records.py). Two constructions of one hash is a standing hazard: a field added to
# the model and not to this jq would stamp every route_approved with a fingerprint no Python
# reader can reproduce, and the drift would be invisible until someone compared them.
# `tests/test_hive_common.py` pins the two against each other.
RUNNER_FINGERPRINT="sha256:$(printf '%s' "$ROUTE" \
  | jq -cS '{executable: .runner.executable, args: (.runner.args // []),
             inherit_env: ((.runner.inherit_env // []) | sort),
             inherit_env_as: (.runner.inherit_env_as // {}),
             env: (.runner.env // {})}' \
  | tr -d '\n' | sha256_hex)"
route_payload=$(jq -cn \
  --arg eid "$EXEC_ID" --arg order "$REL@$SHA" \
  --arg cd "$CATALOG_DIGEST" --arg rf "$RUNNER_FINGERPRINT" --arg src "$ROUTE_SOURCE" \
  --arg route "$ROUTE_NAME" --arg vendor "$R_VENDOR" --arg provider "$R_PROVIDER" \
  --arg model "$MODEL" --arg harness "$R_HARNESS" --arg market "$R_MARKET" \
  --arg pool "$R_POOL" --arg adapter "$R_ADAPTER" --argjson att "$ATTEMPT" \
  '{execution_id: $eid, purpose: "work", attempt: $att, order_ref: $order,
    catalog_digest: $cd, runner_fingerprint: $rf, route_source: $src,
    identity: {route: $route, model_vendor: $vendor, provider: $provider, model: $model,
               harness: $harness, billing_market: $market, credential_pool: $pool,
               adapter: $adapter},
    model_identity_evidence: "declared", usage_evidence: "unavailable"}')
emit human "$OPERATOR_ACTOR" execution.route_approved --task "$TASK" \
  --payload "$route_payload" >/dev/null
echo "  route:  $MODEL @ $R_HARNESS ($R_MARKET, pool $R_POOL, $ROUTE_SOURCE)"
echo "  exec:   $EXEC_ID"

# Two seeding modes. Create: task.created -> ready, then register + assign.
# Adopt: the task is ALREADY `ready` (unowned) from its seeded task.created —
# re-emitting one would regress it, so we emit ONLY register + assign. Order
# matters in both: registered -> roster (assign's target must be registered),
# assigned -> owned.
if [ -n "$REASSIGN_FROM" ]; then
  # Registered BEFORE reassigned: `_g_reassigned` checks the target against the roster, and
  # the roster is populated only by worker.registered. Neither task.created nor task.assigned
  # belongs here — the task exists and is owned; what changes is who owns it.
  emit human "$OPERATOR_ACTOR" worker.registered --payload "$registered_payload" >/dev/null
  emit coordinator "$OPERATOR_ACTOR" task.reassigned --task "$TASK" --payload "$reassigned_payload" >/dev/null
  echo "  reassigned: $REASSIGN_FROM -> $WORKER (attempt $ATTEMPT; no task.created, no task.assigned)"
elif [ -n "$ADOPT" ]; then
  emit human "$OPERATOR_ACTOR" worker.registered              --payload "$registered_payload" >/dev/null
  emit coordinator "$OPERATOR_ACTOR" task.assigned --task "$TASK" --payload "$assigned_payload" >/dev/null
  echo "  adopted: existing ready task -> worker.registered + task.assigned (no task.created)"
  echo "  caveat: acceptance stays the seeded task.created pin, which may be STALE against $REL@$SHA at HEAD;"
  echo "          the worker reads the order at HEAD (WORKER.md), so this is protocol-consistent — just be aware."
else
  created_payload=$(jq -cn --arg t "$TITLE" --arg ty "$TASK_TYPE" --arg a "$ACCEPTANCE" \
    '{title:$t, task_type:$ty, acceptance:$a}')
  emit human "$OPERATOR_ACTOR" task.created     --task "$TASK" --payload "$created_payload"    >/dev/null
  emit human "$OPERATOR_ACTOR" worker.registered              --payload "$registered_payload" >/dev/null
  emit coordinator "$OPERATOR_ACTOR" task.assigned --task "$TASK" --payload "$assigned_payload" >/dev/null
  echo "  seeded: task.created + worker.registered + task.assigned"
fi


# The spine is seeded above and the pane is opened below, and that order is
# deliberate: the worker's very first act is `task.accepted`, which the board
# rejects unless the task already exists and is assigned to it. Creating the
# window first would race a live session against its own ownership. So the window
# stays last — and a failure there is made SAFE rather than reordered away: it
# strands a half-launch (task owned on the board, clones and wrapper on disk, no
# session, kickoff never delivered), which on 2026-07-27 took WORKER.md plus the
# launch output to reconstruct by hand. The launcher prints that reconstruction
# itself, and externalizes the kickoff so it does not live only in a terminal.
# The kickoff, externalized before the window is opened rather than only when opening one
# fails. It is what the worker was actually told, and on 2026-07-27 a half-launch had to be
# reconstructed by hand because that text lived only in a terminal. Writing it every time also
# gives anyone — an operator reading back, a test asserting the contract — one artifact to read
# instead of a screen to scrape.
KICKOFF_FILE="$TASK_ROOT/kickoff.txt"
printf '%s' "$KICKOFF" > "$KICKOFF_FILE" 2>/dev/null || KICKOFF_FILE=""
[ -z "$KICKOFF_FILE" ] || echo "  kickoff: $KICKOFF_FILE"

half_launch_recovery() {  # half_launch_recovery <what-failed>
  local kf="$KICKOFF_FILE"
  {
    echo
    echo "hive-launch: HALF-LAUNCHED — $1 failed AFTER the board was seeded."
    echo
    echo "  Already done:  board seeded on run '$RUN' (task '$TASK' is owned by '$WORKER')"
    echo "                 clones   $WS_ROOT  +  $CODE_ROOT"
    echo "                 wrapper  $WRAPPER"
    [ ! -f "$RUN_DIR/review" ] || echo "                 review   $RUN_DIR/review"
    [ "$EXECUTABLE" != "sbx" ] || echo "                 sandbox  $SANDBOX"
    echo "  Still missing: the tmux window, and delivery of the kickoff below."
    echo
    echo "  Do NOT re-run hive-launch: the task is owned now, so it will refuse."
    echo "  Finish it by hand (WORKER.md section Launch) — either is complete:"
    echo
    if [ -n "$kf" ]; then
      echo "  (a) retry just the window:"
      echo "        tmux new-window -a -t '$SESSION_T:{end}' -n '$TASK' -c '$WS_ROOT' \\"
      echo "          -e HIVE_KICKOFF=\"\$(cat '$kf')\" '$launch_cmd'"
      echo "      If the session itself is gone ('can't find session'), create it instead:"
      echo "        tmux new-session -d -s '$HIVE_TMUX_SESSION' -n '$TASK' -c '$WS_ROOT' \\"
      echo "          -e HIVE_KICKOFF=\"\$(cat '$kf')\" '$launch_cmd'"
    fi
    echo "  (b) fallback if tmux itself is the problem — run the session in any terminal"
    echo "      and paste the kickoff below as its first message:"
    echo "        cd '$WS_ROOT' && $(printf '%q ' "${ARGV[@]}")"
    if [ -n "$kf" ]; then
      echo "      Prefer (a): the window name is the task registry, and (b) leaves no window."
    fi
    echo
    echo "  If you would rather abandon this seat, recover it onto a fresh worker — never a"
    echo "  relaunch, which the board will refuse now that the task is owned:"
    echo "    hive-launch $REL --reassign --reason '<why>'"
    echo
    if [ -n "$kf" ]; then echo "  Kickoff (also written to $kf):"; else echo "  Kickoff:"; fi
    echo "  --------------------------------------------------------------------"
    printf '%s\n' "$KICKOFF" | sed 's/^/  /'
    echo "  --------------------------------------------------------------------"
  } >&2
  exit 1
}

# Open the window. The kickoff travels as an env var (HIVE_KICKOFF) and the command
# expands it into ONE argument, so no multi-line prompt is ever quoted onto a command
# line; every other element goes through `printf %q`, so no path, model id or route
# argument is re-parsed by the shell that runs it either. The window NAME is the
# registry — there is no registry file.
#
# Allocation is name-only: we supply the session and the window NAME, never an
# index. `-t <name>` alone cannot express that — it is a target-WINDOW, so tmux
# first hunts for a window matching <name> in whatever session happens to be
# "current" (exact name, then name-prefix, then fnmatch) and only then falls back
# to <name> as a session. Worker windows are named after task ids, so a task id
# that starts with the session name — `hive-metrics` in the `hive` session,
# 2026-07-27 — makes `-t hive` resolve to THAT window and its concrete index, and
# the launch dies with `create window failed: index N in use`. The trap is not the
# index we chose (we never chose one); it is having let tmux choose a target.
# It reads as intermittent because it needs EXACTLY ONE match: with two `hive-*`
# windows open the prefix match is ambiguous, tmux abandons it and falls back to
# the session, and the very same command succeeds. Do not trust a passing launch
# as evidence that a bare `-t <session>` is safe.
#   * `$SESSION_T:` — exact session, and the colon makes the target a session, so
#     no window name can shadow it.
#   * `-a -t ...:{end}` — insert AFTER the highest-numbered window, i.e. append.
#     The next slot past the last window is free by construction, so an occupied
#     index is unreachable; and appending past {end} (rather than after the
#     current window) never renumbers an existing window. Verified on tmux 3.5a
#     under the operator config (base-index 1, renumber-windows on) and under
#     stock defaults (base-index 0, renumber off) — the result holds either way.
#
# The window runs the HARNESS, directly, and there is no instrumented wrapper around it
# any more. What that costs is stated plainly rather than hidden: nothing observes this
# process, so no `execution.started` or `execution.finished` is emitted and the executions
# projection stays empty for it. What it buys is the thing wave 4 could not deliver — a
# session the operator can type into, that reviews its own diff, repairs its own CI and
# posts its own result without a supervisor in the middle.
launch_cmd="$(printf '%q ' "${ARGV[@]}")\"\$HIVE_KICKOFF\""

# The route's `inherit_env` NAMES, resolved to values here and handed to the window.
#
# A tmux window inherits the tmux SERVER's environment, not the launcher's, so a route that
# names `CODEX_HOME` or `CLAUDE_CONFIG_DIR` got neither: the field was carried in the catalog,
# printed by the preflight, and then dropped. Forwarding it is what makes the field mean what
# it says. A name that is UNSET in this environment is skipped rather than forwarded empty —
# "not set" and "set to nothing" are different to every harness that reads one.
#
# Names only ever come from the catalog, and the route read above has already refused any that
# names a Hive authority credential — see `require_inheritable_env`. That rule used to be
# enforced by `harness/records.py` at catalog load; reading the catalog here in the shell moved
# it off the path, and a comment claiming the old guarantee is not the guarantee (cross-harness
# review, 2026-08-24).
TMUX_ENV=(-e "HIVE_KICKOFF=$KICKOFF")
while IFS= read -r n; do
  [ -n "$n" ] || continue
  [ -n "${!n+set}" ] || continue
  TMUX_ENV+=(-e "$n=${!n}")
done < <(printf '%s' "$ROUTE" | jq -r '.runner.inherit_env[]?')
# The renames and the endpoint reach a NON-sandboxed route the same way. A host route gets
# its environment through the window; without these two loops an or-* route run outside sbx
# would inherit nothing and answer from the wrong provider — the 2026-08-28 failure again,
# one layer out.
while IFS=$'\t' read -r n src; do
  [ -n "${src:-}" ] || continue
  TMUX_ENV+=(-e "$n=${!src}")
done < <(printf '%s' "$ROUTE" | jq -r '(.runner.inherit_env_as // {}) | to_entries[] | "\(.key)\t\(.value)"')
while IFS= read -r pair; do
  [ -n "$pair" ] || continue
  TMUX_ENV+=(-e "$pair")
done < <(printf '%s\n' "$ENV_PAIRS")

if tmux has-session -t "$SESSION_T" 2>/dev/null; then
  PANE=$(tmux new-window -a -t "$SESSION_T:{end}" -n "$TASK" -c "$WS_ROOT" \
    "${TMUX_ENV[@]}" -P -F '#{session_name}:#{window_index}' "$launch_cmd") \
    || half_launch_recovery "tmux new-window"
else
  PANE=$(tmux new-session -d -s "$HIVE_TMUX_SESSION" -n "$TASK" -c "$WS_ROOT" \
    "${TMUX_ENV[@]}" -P -F '#{session_name}:#{window_index}' "$launch_cmd") \
    || half_launch_recovery "tmux new-session"
fi
# A session that exits would otherwise take its window — and the task registry entry with
# it — leaving nothing on screen to read afterwards. `remain-on-exit` keeps the pane and
# its last screen; `hive-answer` refuses to type into a dead one rather than nudging a
# process that is gone.
tmux_keep_window "$HIVE_TMUX_SESSION" "$TASK"
# Report where it actually landed (-P), not where we assumed: the index is tmux's
# to choose, so the launcher reads it back rather than predicting it.
echo "  window: $PANE  '$TASK'  (attach: tmux attach -t $HIVE_TMUX_SESSION)"
echo "hive-launch: done."
