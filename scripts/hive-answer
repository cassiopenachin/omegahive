#!/usr/bin/env bash
# hive-answer <task> <text...>
# hive-answer <task> --sha <full-sha>
# hive-answer <task> --resume-only <reason...>
#
# The answer bookend of the Phase 1 loop (OPERATIONS.md pain 1): the ~5-step
# clerical answer path collapsed to one SSH-friendly command —
#   ssh beastie 'hive-answer port-sha "use event time"'
#
# It is also the ONLY command that continues a worker, and since 2026-08-23 it does so the
# way it originally did: `tmux send-keys` into the window that IS the task registry
# (`2026-08-23-direction.md` §3). The worker is an interactive session that never ended, so
# continuing it is a line of text, not a lifecycle — nothing is written, no turn is
# prepared, no native session id is resolved, and the harness does not restart.
#
# `--resume-only` appends nothing to the order and asks for no `task.unblocked`; it names
# the operator's reason and nudges the same live window. That is a prod, never reassignment.
# Its old meaning — recovering a process that had EXITED — no longer exists here: a session
# that exited is a seat to recover (RUNBOOK), and this refuses to type into a dead pane
# rather than reporting a nudge that never arrived.
#
# The `<text...>` form appends the answer to the order's `## Answers` section
# (append-only; the order body is never touched), commits + pushes, then nudges
# the worker's pane to pull and re-read at HEAD. It is a shell argument, so it
# is the fast default for a short answer — and the wrong surface for a long or
# structured one (a table, a multi-paragraph rationale, anything with a quote
# character): twice in wave 3 an answer was compressed to fit it, once losing
# load-bearing structure.
#
# The `--sha <full-sha>` form is for exactly that case: the answering seat
# authors the long-form answer below the order's `## Answers` heading in its own
# commit and pushes it by ordinary git means (this tool never does that part).
# `--sha` then verifies the ALREADY-PUSHED commit — full sha, reachable from the
# hub's main, touches only the target order, and its diff is a pure addition
# entirely below the `## Answers` heading — and, only once every check passes,
# performs the same safe tmux nudge as the text form. It never stages, commits,
# rebases, or pushes anything itself; the durable operator gate (a human commit
# lands the content) is unchanged, only the authoring surface is widened.

# Deliberate redundancy with hive-common.sh:26, which sets exactly the same three
# options during the `source` below. Five production scripts inherited -e, -u and
# pipefail from that ONE line and stated none of them; a refactor that guards it, moves
# it, or wraps the source in a conditional would have quietly stripped error-exit,
# nounset and pipefail from all five at once, and nothing would have failed loudly
# enough to notice. Setting them here is a no-op at runtime and makes each script's own
# contract readable without opening another file.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

usage() {
  cat >&2 <<'USAGE'
usage: hive-answer <task> <text...>              append an answer, then nudge the worker
       hive-answer <task> --sha <full-sha>       verify an already-pushed answer, then nudge
       hive-answer <task> --resume-only <reason> nudge a live worker with no answer at all —
                                                 appends nothing, asks for no task.unblocked,
                                                 and says why in the line the worker reads.

The nudge is one line of text typed into the task's tmux window. It requires that window
to hold a LIVE session: a worker whose session exited is recovered per RUNBOOK, not woken.
USAGE
  exit 2
}

[ $# -ge 2 ] || usage
TASK="$1"; shift

SHA=""
TEXT=""
RESUME_ONLY=""
ANSWER_SHA=""
if [ "$1" = "--sha" ]; then
  shift
  [ $# -eq 1 ] || usage
  SHA="$1"
elif [ "$1" = "--resume-only" ]; then
  shift
  RESUME_ONLY="$*"
  [ -n "$RESUME_ONLY" ] || die "--resume-only needs a reason. It goes on the turn record and
  is the only thing that later explains why this worker was woken with no answer."
else
  TEXT="$*"
  [ -n "$TEXT" ] || usage
fi

# Guarded up front, before anything is written: this script's tmux target is
# `=<session>:=<task>`, so a session name carrying `:` splits at the wrong place and the
# resume respawns a pane in another session — silently, because tmux succeeds either way.
# Same guard hive-launch applies (hive-common.sh).
require_safe_tmux_session

REL=$(find_order "$TASK")
FILE="$OPS_WS/$REL"
# The project's committed identity (RUN) — every board read and every path below acts on
# THIS project's run, never a global default.
PROJECT=$(project_from_order "$REL")
load_project_conf "$PROJECT"

if [ -n "$RESUME_ONLY" ]; then
  # No answer, no commit, no push: the order is untouched. All the append-only,
  # reachable-sha and publication checks below exist to protect an answer that is about
  # to land, and there is no answer here.
  echo "hive-answer: --resume-only for '$TASK' — no answer appended, no order touched"
  echo "  reason: $RESUME_ONLY"
elif [ -n "$SHA" ]; then
  # --sha: verify only, never write. A full sha is required — an abbreviated one
  # is ambiguous across a growing repo and this refusal is cheap to make absolute.
  [[ "$SHA" =~ ^[0-9a-f]{40}$ ]] \
    || die "--sha requires a full 40-character commit sha, got '$SHA' (abbreviated shas are refused as ambiguous)"

  git -C "$OPS_WS" fetch --quiet origin || die "cannot fetch hub ($WS_HUB)"
  git -C "$OPS_WS" cat-file -e "${SHA}^{commit}" 2>/dev/null \
    || die "commit $SHA not found in $OPS_WS after fetching origin — wrong sha, or not pushed yet"
  # hub_confirms_ancestor (hive-common.sh) fetches again — cheap and harmless (a
  # no-op fetch is fast) — in exchange for sharing the actual "is this landed"
  # check with order_pin rather than carrying a second copy that could drift.
  hub_confirms_ancestor "$SHA" "cannot fetch hub ($WS_HUB)" \
    "commit $SHA is not reachable from the hub's main; refusing to nudge on an answer that is not really landed"

  # shellcheck disable=SC2046  # deliberate word splitting: each parent sha is one word
  set -- $(git -C "$OPS_WS" show -s --format=%P "$SHA")
  [ "$#" -le 1 ] || die "commit $SHA is a merge commit ($# parents); --sha refuses merge commits"
  [ "$#" -eq 1 ] || die "commit $SHA has no parent (it is a repo root); --sha needs a commit that only appends to an existing order"
  PARENT="$1"

  CHANGED=$(git -C "$OPS_WS" show --name-only --format= "$SHA" | grep -v '^$' || true)
  CHANGED_N=$(printf '%s\n' "$CHANGED" | grep -c .)
  [ "$CHANGED_N" -eq 1 ] && [ "$CHANGED" = "$REL" ] \
    || die "commit $SHA changes more than the target order ($REL); --sha refuses a mixed commit. Changed: $(printf '%s' "$CHANGED" | tr '\n' ' ')"

  DELETIONS=$(git -C "$OPS_WS" diff --numstat "$PARENT" "$SHA" -- "$REL" | awk '{print $2}')
  # --numstat prints a literal "-" (not a count) for a diff git flags as binary —
  # an order file should never be binary, but refuse cleanly rather than let a
  # non-numeric value reach `-eq` and leak a raw bash arithmetic error above the
  # intended refusal.
  case "${DELETIONS:-0}" in
    ''|*[!0-9]*) die "commit $SHA's diff for $REL is not a text diff (binary?); --sha only accepts a pure text addition" ;;
  esac
  [ "$DELETIONS" -eq 0 ] \
    || die "commit $SHA deletes $DELETIONS line(s) from $REL; --sha only accepts a pure addition"

  OLD=$(git -C "$OPS_WS" show "$PARENT:$REL" 2>/dev/null || true)
  NEW=$(git -C "$OPS_WS" show "$SHA:$REL")
  # grep exits 1 on "no match", which is a legitimate outcome here (an OLD file
  # with no heading yet is exactly the common case) — `|| true` keeps that from
  # tripping `set -e` before the deliberate checks below get to see it.
  NEW_HEAD_LINE=$( { printf '%s\n' "$NEW" | grep -n -m1 -x '## Answers' | cut -d: -f1; } || true )
  [ -n "$NEW_HEAD_LINE" ] \
    || die "commit $SHA's version of $REL has no '## Answers' heading; --sha needs the answer appended below that heading"
  OLD_HEAD_LINE=$( { printf '%s\n' "$OLD" | grep -n -m1 -x '## Answers' | cut -d: -f1; } || true )
  if [ -n "$OLD_HEAD_LINE" ]; then
    OLD_PREFIX=$(printf '%s\n' "$OLD" | head -n "$((OLD_HEAD_LINE - 1))")
  else
    OLD_PREFIX="$OLD"
  fi
  NEW_PREFIX=$(printf '%s\n' "$NEW" | head -n "$((NEW_HEAD_LINE - 1))")
  [ "$OLD_PREFIX" = "$NEW_PREFIX" ] \
    || die "commit $SHA edits $REL above the '## Answers' heading; --sha only accepts appends below it"

  echo "hive-answer: verified $SHA appends to $REL below '## Answers' — not committing (already on the hub)"
  ANSWER_SHA="$SHA"
else
  TODAY=$(date +%F)

  # Append-only: add the `## Answers` header if it is not already present, then the
  # dated line. We never edit the body above it.
  if ! grep -qxF '## Answers' "$FILE"; then
    printf '\n## Answers\n' >> "$FILE"
  fi
  printf -- '- %s — %s\n' "$TODAY" "$TEXT" >> "$FILE"

  # Commit only the order file (pathspec), so any unrelated staged changes in the
  # operator's workspace clone are never swept into the answer commit. A line was
  # just appended, so an empty commit is impossible — a failure here is a real git
  # error (identity unset, a hook, an index lock), reported as such.
  git -C "$OPS_WS" commit --quiet -m "answer: $TASK" -- "$REL" \
    || die "git commit failed for $REL (git identity unset, a commit hook, or an index lock?)"
  if ! git -C "$OPS_WS" push --quiet 2>/dev/null; then
    git -C "$OPS_WS" pull --rebase --quiet || die "push failed and rebase failed; resolve $OPS_WS by hand"
    git -C "$OPS_WS" push --quiet || die "push failed for $OPS_WS; answer committed locally but not on the hub"
  fi
  ANSWER_SHA=$(git -C "$OPS_WS" rev-parse HEAD)
  echo "hive-answer: appended to $REL and pushed ($ANSWER_SHA)"
fi

# =====================================================================================
# The nudge half: tell this task's worker, in its own window, that something changed.
#
# A worker is an INTERACTIVE session again (2026-08-23-direction.md §3), so continuing one
# is `tmux send-keys` into the window that IS the task registry — the wave-3 mechanism,
# restored. It is not a resume in the harness's sense: nothing is written, no turn is
# prepared, no native session id is looked up, and the harness never restarts. The worker
# is alive in that window and simply receives a line of text.
#
# What that costs, said plainly: a window whose session has exited cannot be nudged, and
# this refuses rather than typing into a dead pane. The answer is durable on the hub before
# any of this runs, so a failed nudge never loses a decision — it costs a hand-nudge.
#
# Everything below refuses rather than guesses. Not knowing which worker or which window is
# a reason to stop and print the choices, never a reason to pick one: a nudge that lands in
# the wrong window is worse than no nudge, because it looks like it worked.
# =====================================================================================

# --- who owns this task ---------------------------------------------------------------
BOARD_NOW=$(board_json_strict "$RUN")
STATUS=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .status')
OWNER=$(printf '%s' "$BOARD_NOW" | jq -r --arg t "$TASK" '.[] | select(.task == $t) | .owner // empty')

[ -n "$STATUS" ] || die "task '$TASK' does not exist on run '$RUN' — there is nobody to nudge."
case "$STATUS" in
  in_review|done)
    die "task '$TASK' is '$STATUS' on run '$RUN'. A task awaiting close or already closed is
  not resumable: review and close are the operator's acts, and waking a worker into a
  finished task would produce work nobody asked for.
  If the result needs revision, that is a fresh launch decision (RUNBOOK)." ;;
esac
[ -n "$OWNER" ] || die "task '$TASK' is '$STATUS' but has no owner on run '$RUN' — there is no
  worker to nudge. Launch one with hive-launch, or recover per RUNBOOK."

# --- the line the worker receives -------------------------------------------------------
# ONE line, always. `send-keys` types into a live TUI and a newline inside the text would
# submit half a sentence and leave the rest in the composer — so the two modes differ in
# what they say, never in how many lines they are.
#
# An ANSWER nudge names the commit that carries it and repeats the protocol's conditional
# unblock rule; a RECOVERY nudge says only that the operator woke it and why, and asks for
# no `task.unblocked` — there is nothing to consume.
if [ -n "$RESUME_ONLY" ]; then
  NUDGE="operator nudge (no answer landed): $RESUME_ONLY — ../run/hive sync workspace, re-read your order and your own report/question files at HEAD, and continue; do NOT emit task.unblocked, and if you are still blocked awaiting a decision, say so and stop"
else
  NUDGE="an answer landed in commit ${ANSWER_SHA:-$(git -C "$OPS_WS" rev-parse HEAD)} — ../run/hive sync workspace, re-read your order at HEAD ('## Answers'), and emit task.unblocked ONLY if that answer resolves what you asked; if it does not, emit task.reported(kind=finding) saying so and stay blocked"
fi

# What is already durable, said correctly for the mode we are in. Every refusal below
# repeats it, because the first question on a failed nudge is "did I just lose the answer".
if [ -n "$RESUME_ONLY" ]; then
  DURABLE="No answer was appended — this was a bare nudge, so nothing is pending."
else
  DURABLE="The answer is committed and pushed; it is not lost."
fi

# --- find the window, and refuse anything ambiguous or dead -----------------------------
# Every target is `=`-prefixed. Without it tmux falls back to a PREFIX match when no session
# is named exactly `$HIVE_TMUX_SESSION` — so with that session gone or renamed, a bare
# `hive` matches `hive-scratch`, and the nudge types the answer into someone else's pane,
# silently, because send-keys exits 0 either way.
SESSION_T="=$HIVE_TMUX_SESSION"
WINDOW_T="=$HIVE_TMUX_SESSION:=$TASK"

command -v tmux >/dev/null 2>&1 \
  || die "tmux not found on PATH — the window is the task registry, so there is nothing to
  nudge. The answer is committed and pushed; tell the worker by hand."

tmux has-session -t "$SESSION_T" 2>/dev/null \
  || die "no tmux session named '$HIVE_TMUX_SESSION' on this host, so worker '$OWNER' has no
  window to nudge. Its session is gone.
  $DURABLE Recover the SEAT per RUNBOOK
  'Dead worker recovery' (fresh worker id, then task.reassigned) — never a relaunch onto
  an owned task."

tmux list-windows -t "$SESSION_T" -F '#{window_name}' 2>/dev/null | grep -qxF "$TASK" \
  || die "session '$HIVE_TMUX_SESSION' has no window named '$TASK', so worker '$OWNER' is not
  seated in it. Windows present: $(tmux list-windows -t "$SESSION_T" -F '#{window_name}' | tr '\n' ' ')
  $DURABLE Recover the seat per RUNBOOK 'Dead worker recovery'."

# `remain-on-exit` keeps a window after its session exits, which is what leaves the last
# screen readable — and it means a window's PRESENCE no longer proves a live process. A
# dead pane accepts send-keys and swallows it, so this asks tmux directly.
# A LIVE pane is not a live harness. A window sitting at a shell — the harness exited under a
# configuration without `remain-on-exit`, someone respawned the pane, the harness crashed back
# to its parent — is not dead, so the nudge would be typed at a prompt and the Enter would
# EXECUTE it. Answer text is operator prose; handed to a shell it is a command line, and one
# carrying `$(...)`, a backtick or a `;` runs. So the shells are refused by name: this cannot
# enumerate every harness (a route may add one tomorrow), but it can refuse the interpreters
# that would execute what it types.
PANE_CMD=$(tmux display-message -p -t "$WINDOW_T" '#{pane_current_command}' 2>/dev/null || true)
case "$PANE_CMD" in
  bash|zsh|sh|dash|fish|ksh|tcsh|csh|screen|tmux)
    die "the '$TASK' window is alive but is running '$PANE_CMD', not a harness — its session
  exited and left the pane at a shell. Typing an answer there would hand operator prose to a
  shell as a command line, so this refuses.
  Look:  tmux attach -t '$HIVE_TMUX_SESSION'   (window '$TASK')
  $DURABLE
  A worker whose session ended is a seat to recover, not a process to wake: RUNBOOK
  'Dead worker recovery'." ;;
esac

if [ "$(tmux display-message -p -t "$WINDOW_T" '#{pane_dead}' 2>/dev/null)" = "1" ]; then
  die "the '$TASK' window exists but its session has EXITED (the pane is dead — its last
  screen is still there to read: tmux attach -t '$HIVE_TMUX_SESSION').
  Typing into it would go nowhere, so this refuses rather than reporting a nudge that
  never arrived. $DURABLE
  A worker whose session ended without posting a result is a seat to recover, not a
  process to wake: RUNBOOK 'Dead worker recovery'."
fi

# --- nudge -------------------------------------------------------------------------------
# The text and the Enter go as separate `send-keys` calls: a harness TUI redraws its composer
# as it receives input, and sending the submit key in the same batch has raced that redraw and
# submitted an empty prompt.
tmux send-keys -t "$WINDOW_T" -l "$NUDGE" \
  || die "send-keys failed for window '$TASK'. $DURABLE Nudge the
  worker by hand:  tmux attach -t '$HIVE_TMUX_SESSION'"

# And then Enter, more than once if it has to be. A harness that is MID-TURN does not submit
# on Enter — Codex holds the line in its composer and offers to queue it, so the text arrives,
# is visible, and never reaches the model (measured 2026-08-24: the first Enter did nothing,
# the second, after the turn ended, submitted it). A nudge reported as delivered and sitting
# unread in a composer is precisely the failure this half of the tool exists to avoid.
#
# So delivery is CHECKED rather than assumed, and the check is stated for what it is: reading a
# terminal's pixels back, which no harness promises anything about. Three things make it as
# sharp as a screen-scrape can be, and none of them make it certain:
#
#   * the needle is the END of the nudge, not its start. A long nudge wraps to several visual
#     lines and the START scrolls out of the composer region before anything is even sent —
#     which would read as "delivered" for a line still sitting unsubmitted;
#   * the pane is whitespace-collapsed before matching, because a composer wraps mid-phrase and
#     draws border glyphs through it, and an exact-substring grep fails on both;
#   * the region is the last lines only. Both harnesses echo a submitted message into the
#     transcript ABOVE the composer, so a wider window would find the echo and report a
#     successful submit as stuck.
#
# It can still be wrong in both directions. What follows from that is the exit code: a nudge
# this cannot confirm is reported as unconfirmed and exits non-zero, never as delivered.
NEEDLE=$(printf '%s' "${NUDGE: -32}" | tr -s '[:space:]' ' ')
DELIVERED=""
for _ in 1 2 3 4 5 6; do
  tmux send-keys -t "$WINDOW_T" Enter 2>/dev/null || true
  sleep 2
  if ! tmux capture-pane -p -t "$WINDOW_T" 2>/dev/null | tail -8 \
       | tr -s '[:space:]' ' ' | grep -qF "$NEEDLE"; then
    DELIVERED=1
    break
  fi
done
if [ -z "$DELIVERED" ]; then
  {
    echo "hive-answer: the nudge was TYPED into window '$TASK' and this could not confirm that"
    echo "  the session took it — its opening words are still on screen where the composer is."
    echo "  The usual cause is a harness mid-turn: it holds the line until the turn ends."
    echo "  Attach and look; press Enter there if it is still unsent."
    echo "    tmux attach -t '$HIVE_TMUX_SESSION'   (window '$TASK')"
    echo "  This check reads the terminal back and can be wrong in both directions, so treat it"
    echo "  as 'unconfirmed', not as 'not delivered' — the line may well have been received."
    echo "  $DURABLE"
  } >&2
  exit 1
fi

echo "hive-answer: nudged $HIVE_TMUX_SESSION:$TASK (worker '$OWNER')"
echo "  sent: $NUDGE"
echo "hive-answer: done — watch it with  tmux attach -t $HIVE_TMUX_SESSION"
