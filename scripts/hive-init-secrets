#!/usr/bin/env bash
# hive-init-secrets — create this host's secrets directory and seed the per-service
# env-files from their committed examples.
#
# Why this exists: the compose file references ${OMEGAHIVE_SECRETS_DIR}/<service>.env
# and the docs cite the same path, but nothing created either — a fresh deployer had a
# pointer with no bootstrap, and an unset pointer made compose skip the env-file in
# silence (required:false), leaving a notifier with no token and no complaint.
#
# What it does NOT do: put a secret anywhere. It creates the directory (0700) and
# seeds each file (0600) from its `<service>.env.example`, with the placeholder values
# the example carries. The operator edits the values in. Nothing here is committed and
# nothing is printed — the file MODES and NAMES are the output, never the contents.
#
# The secrets-manifest posture is unchanged: secrets-manifest.yaml still declares which
# env-var names each service may see, and deploy-checks still scans against it.
#
# Idempotent: an existing directory is re-permissioned, an existing env-file is LEFT
# ALONE (never overwritten — that would clobber a live credential) and reported as kept.
#
# Usage:
#   scripts/hive-init-secrets              # seed every <service>.env.example in the repo
#   scripts/hive-init-secrets notifier     # just this service
#   OMEGAHIVE_SECRETS_DIR=/other scripts/hive-init-secrets
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The canonical location (deployment spec §4). The same default the compose file
# interpolates, so the two cannot drift; an exported value wins over it.
: "${OMEGAHIVE_SECRETS_DIR:=$HOME/.config/omegahive/secrets}"

die() { echo "hive-init-secrets: $*" >&2; exit 1; }

case "${1:-}" in
  -h|--help)
    sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

# Which services to seed: the named ones, else every committed example in the repo root.
declare -a SERVICES=()
if [ "$#" -gt 0 ]; then
  SERVICES=("$@")
else
  for ex in "$ROOT"/*.env.example; do
    [ -e "$ex" ] || continue
    ex="$(basename "$ex")"
    SERVICES+=("${ex%.env.example}")
  done
fi
[ "${#SERVICES[@]}" -gt 0 ] || die "no *.env.example found in $ROOT and no service named"

# 0700 before anything lands in it, and re-applied on an existing directory: a
# secrets dir that is group- or world-readable is the failure this guards, and it is
# just as likely on a directory the operator already made by hand as on a new one.
mkdir -p "$OMEGAHIVE_SECRETS_DIR"
chmod 0700 "$OMEGAHIVE_SECRETS_DIR"
echo "secrets dir: $OMEGAHIVE_SECRETS_DIR (0700)"

for svc in "${SERVICES[@]}"; do
  example="$ROOT/$svc.env.example"
  target="$OMEGAHIVE_SECRETS_DIR/$svc.env"
  [ -f "$example" ] || die "no committed example for '$svc' (expected $example)"
  if [ -e "$target" ]; then
    # Never overwrite: this file may hold a live credential. Still fix its mode.
    chmod 0600 "$target"
    echo "  kept    $svc.env (0600) — already present, not overwritten"
  else
    # install -m creates with the mode set, so the file is never briefly 0644.
    install -m 0600 "$example" "$target"
    echo "  seeded  $svc.env (0600) from $svc.env.example — EDIT IT: it holds placeholders, not credentials"
  fi
done

cat <<EOF

Next:
  1. Edit the files above and replace every placeholder with a real value.
  2. Make the pointer permanent for this host — add to the deploy user's shell profile:
       export OMEGAHIVE_SECRETS_DIR="$OMEGAHIVE_SECRETS_DIR"
     (The compose file defaults to this same path, so this is belt-and-braces unless
     you moved the directory.)
  3. Record the secret NAMES and rotation date in the deployment record. Never the values.
EOF
