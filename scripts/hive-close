#!/usr/bin/env bash
# hive-close <task> --review <clean|minor rework|rework> [--reason <text>]
# hive-close <task> --no-score [--reason <text>]
#
# The close bookend of the Phase 1 loop (OPERATIONS.md): one judgment — the
# result holds — after the PR is merged in the GitHub app. Verifies the board is
# in_review, pulls the result ref from the spine's own task.result_posted, then
# emits review.passed + status_override(done), and finally regenerates the
# project's metrics (hive-metrics) and scores the task's predictions (hive-score),
# carrying the review verdict straight through — so the instrument refresh AND the
# calibration row are both by-products of closing, not a separate errand the
# operator has to remember afterwards (retro 3 D2/D4: a close that leaves the
# review column for a human to fill in later is exactly how it got filled in
# wrong, or not at all). `--review` is therefore required for a scored close;
# `--no-score` is the explicit opt-out, and skips both the metrics regeneration
# and the calibration entry, same as before.
#
# review.passed here certifies exactly what OPERATIONS.md pain 6 says it does:
# the operator read the result report and saw no red flags — not artifact
# correctness. Merging is a separate human act (the GitHub app); hive-close never
# merges. The `--review` verdict is a separate judgment layered on top: it scores
# the task's whole post-result review cycle for calibration (hive-score refuses a
# `clean` verdict outright if the spine shows any `review.failed`).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

usage() {
  echo "usage: hive-close <task> --review <clean|minor rework|rework> [--reason <text>]" >&2
  echo "       hive-close <task> --no-score [--reason <text>]" >&2
  exit 2
}

TASK=""
REASON="operator read the result report; no red flags (hive-close)"
SCORE=1
REVIEW_VERDICT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --reason) shift; [ $# -gt 0 ] || usage; REASON="$1" ;;
    --review) shift; [ $# -gt 0 ] || usage; REVIEW_VERDICT="$1" ;;
    --no-score) SCORE=0 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) [ -z "$TASK" ] || usage; TASK="$1" ;;
  esac
  shift
done
[ -n "$TASK" ] || usage

# Validate before any spine write (below). `--review` is required for a scored
# close; `--no-score` is the only way around it. When both are given, the
# verdict is still validated — --no-score with a garbled --review is more likely
# a mistake than an intentional combination, and refusing early costs nothing.
if [ "$SCORE" -eq 1 ]; then
  [ -n "$REVIEW_VERDICT" ] \
    || die "hive-close requires --review <clean|minor rework|rework> unless --no-score is given"
fi
if [ -n "$REVIEW_VERDICT" ]; then
  REVIEW_VERDICT=$(validate_review_verdict "$REVIEW_VERDICT")
fi

# 0. Resolve the task to its order across every project (refusing cross-project
#    ambiguity), then load that project's committed identity so RUN is the task's
#    own run — never a global default that could point close at the wrong spine.
REL=$(find_order "$TASK")
PROJECT=$(project_from_order "$REL")
load_project_conf "$PROJECT"
echo "hive-close: task=$TASK  project=$PROJECT  run=$RUN"

# 1. The board must be in_review — refuse otherwise, printing the actual status.
#    board_status returns non-zero on an empty board (board-view exits 1); the
#    `|| STATUS=""` keeps that from aborting under `set -e` so the die below is
#    what the operator actually sees.
STATUS=""; STATUS=$(board_status "$TASK") || STATUS=""
[ -n "$STATUS" ] || die "task '$TASK' is not on the board for run '$RUN' (wrong task or project?)"
[ "$STATUS" = "in_review" ] || die "task '$TASK' is '$STATUS', not 'in_review'; refusing to close"

# 2. Read the newest task.result_posted for this task and take its first artifact
#    ref (read-only access to the spine — no new write surface). Guarded so a
#    spine read error surfaces the friendly die below, not a bare set -e abort.
REF=""; REF=$( hive report "$RUN" --json 2>/dev/null | jq -r --arg t "$TASK" '
  [ .[] | select(.event_type == "task.result_posted" and .task_id == $t) ]
  | last | .payload.artifact_refs[0].ref // empty' ) || REF=""
[ -n "$REF" ] || die "the newest task.result_posted for '$TASK' has no artifact ref; review.passed needs a ref to certify — the worker's result is malformed, close by hand or ask for a proper result"

echo "hive-close: task=$TASK  result=$REF"

# 3. review.passed (instrument — blessed human-tier borrowing), then
#    status_override(done). The done-gate requires latest review == passed, so
#    this order is load-bearing.
passed_payload=$(jq -cn --arg r "$REF" '{ref_result:$r}')
done_payload=$(jq -cn --arg s 'done' --arg r "$REASON" '{status:$s, reason:$r}')

emit instrument "$OPERATOR_ACTOR" review.passed --task "$TASK" --payload "$passed_payload" >/dev/null
emit human "$OPERATOR_ACTOR" task.status_override --task "$TASK" --payload "$done_payload" >/dev/null

# 4. Certify what happened, in plain terms.
echo "hive-close: certified"
echo "  review.passed  ref_result = $REF"
echo "  status_override done       reason = $REASON"
echo "  NOTE review.passed = the operator read the result report (not artifact correctness)."

# 5. Regenerate the project's metrics (tasks.md/tasks.csv) and score the task's
#    predictions — strictly AFTER the close emits, and strictly non-fatal, both.
#    The close is the governed act and it is already durable on the spine; the
#    instrument refresh is a workspace by-product. So the ordering is absolute (a
#    regeneration or scoring failure can never make a completed close look
#    failed, and can never prevent one), and each failure is LOUD rather than
#    swallowed: the operator is told exactly which one command to re-run.
#    Retires R6's surviving manual half (retro 2026-07-29 D6) — the wave-close
#    ritual used to need a human to remember `hive-metrics <project>` separately;
#    now every close carries it, the same way scoring already rides every close.
#
#    Both tools are invoked as child processes rather than sourced: each has its
#    own argument parsing, its own `set -euo pipefail` expectations, and its own
#    `die` paths, all of which would otherwise abort the close after the fact.
#    `--project` is passed because this close already resolved it. `</dev/null`
#    because the spine read is `podman compose run`, which eats stdin.
#
#    The review verdict rides straight through to hive-score, which is the one
#    place it is validated against the spine's own review.failed count (a false
#    `clean` is refused there, loudly, same as any other scoring failure below —
#    the close still stands and names the one recovery command).
if [ "$SCORE" -eq 0 ]; then
  echo "hive-close: --no-score — metrics not regenerated, calibration not recorded;"
  echo "  run 'hive-metrics $PROJECT' and 'hive-score $TASK' when you want them."
else
  if "$SCRIPT_DIR/hive-metrics" "$PROJECT" </dev/null; then
    echo "hive-close: metrics regenerated ($PROJECT tasks.md/tasks.csv)"
  else
    {
      echo
      echo "hive-close: WARNING the close SUCCEEDED and is durable on the spine — regenerating"
      echo "  $PROJECT's tasks.md/tasks.csv afterwards did not. Nothing about task '$TASK' is in"
      echo "  doubt. Recover with one command:"
      echo "      hive-metrics $PROJECT"
    } >&2
  fi
  if "$SCRIPT_DIR/hive-score" "$TASK" --project "$PROJECT" --review "$REVIEW_VERDICT" </dev/null; then
    echo "hive-close: scored (review verdict: $REVIEW_VERDICT)"
  else
    {
      echo
      echo "hive-close: WARNING the close SUCCEEDED and is durable on the spine — scoring afterwards did not."
      echo "  Nothing about task '$TASK' is in doubt: review.passed and status_override(done) are emitted."
      echo "  Only the calibration entry is missing or wrong. Recover with one command:"
      echo "      hive-score $TASK --project $PROJECT --review \"$REVIEW_VERDICT\""
      echo "  (already-scored is a normal reason for this to fail as written — add --again to replace it in place;"
      echo "  a refused 'clean' against a nonzero review.failed count needs a truthful verdict instead.)"
    } >&2
  fi
fi
