#!/usr/bin/env bash
# hive-supervise <run-dir>            — run one approved execution and record what it did
# hive-supervise --reconcile <root>   — emit terminal facts for executions that died unrecorded
# hive-supervise --drain <run-dir>    — drain one worker's request spool once, then stop
#
# The launcher-owned supervisor. It is the pane's command: `hive-launch` writes an
# execution run-dir OUTSIDE the worker's task root and opens a tmux window running THIS
# script, which probes the harness, starts it, drains its request spool while it runs,
# and emits the two instrument facts around it.
#
# Why a supervisor at all, rather than asking the session to report on itself: a worker
# reporting its own model and token spend is a self-measurement, and the corpus already
# says self-assessment is unreliable (retro 2026-07-29 D3 — workers reported effort two
# to six times their measured span). The supervisor never impersonates the worker: it
# emits `execution.*` as `instrument` and has no authority to emit any `task.*` event.
# On a supervised route it also RELAYS the worker's own emits — through a separate
# wrapper carrying the worker's identity, stamped from this run-dir's plan and never
# from the request — which is a different thing from speaking for it.
#
# THE RUN-DIR IS THE ROOT OF TRUST, and it is deliberately not inside the worker's task
# root. A worker may rewrite anything it can write, including the wrappers that produce
# the requests below; so every identity, path, branch and destination this script acts on
# comes from `plan.json` here, and a request that tries to carry one is refused by name.
#
# THE TERMINAL FACT IS THE POINT. `execution.finished` is written to disk BEFORE it is
# emitted and re-emitted verbatim on any later attempt, so a spine outage, a killed
# emit, or a `--reconcile` sweep all converge on one identical event rather than a
# family of near-duplicates. The spine deduplicates identical payloads, so re-running is
# safe by construction.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hive-common.sh
source "$SCRIPT_DIR/hive-common.sh"

log() { echo "hive-supervise: $*" >&2; }

# jq is a hard dependency and is checked HERE rather than assumed. `hive-launch` not
# checking for it is one of the defects this order's drill audit found: a missing jq
# there collapses a board read to the empty string and re-creates a live task.
command -v jq >/dev/null 2>&1 || die "jq is required by hive-supervise"

# The stack CLI. `hive()` (hive-common.sh) is the containerized path every operator tool
# uses; HIVE_CLI_CMD overrides it with a direct invocation, which is what lets the
# fixture-driven end-to-end test drive this exact script with no container and no
# network. The override is a test seam, not a second code path — both land on the same
# `omegahive` command.
hive_cli() {
  if [ -n "${HIVE_CLI_CMD:-}" ]; then
    # shellcheck disable=SC2086  # HIVE_CLI_CMD is legitimately several words
    $HIVE_CLI_CMD "$@"
  else
    hive "$@"
  fi
}

# --- run-dir layout (OUTSIDE the worker's task root) --------------------------------
#   plan.json        the resolved plan plus the launch-fixed bridge block
#   emit.sh          the supervisor's instrument emit wrapper, issued by hive-launch
#   emit-worker.sh   the relay of the worker's OWN emits (supervised routes only)
#   started.json     the started payload, once emitted
#   finished.json    the terminal payload — written before emitting, replayed on retry
#   usage.json       the raw usage evidence rows (audit trail; no message content)
#   harness.log      the harness's own stderr
#   spool.log        one line per drained request: id, kind, verdict
#   publish/         trusted-side bare repositories for publication (never checked out)

usage() {
  echo "usage: hive-supervise <run-dir> | --reconcile <root> | --drain <run-dir>" >&2
  exit 2
}

# `now` is ISO-8601 UTC to the second. `date -u +%FT%TZ` is POSIX and portable to BSD;
# `date -d`/`date -v` are the non-portable forms and appear nowhere here.
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Read a JSON string array into a bash array, NUL-separated so no element can be split
# or globbed whatever it contains. `while read -d ''` rather than `mapfile -d ''`:
# mapfile's -d needs bash 4.4, and the wrapper this repo issues must run on the oldest
# bash a supported host ships (macOS still ships 3.2).
read_json_array() {  # read_json_array <target-array-name> <jq-filter> <json-file>
  local __name="$1" __filter="$2" __file="$3" __item
  eval "$__name=()"
  while IFS= read -r -d '' __item; do
    eval "$__name+=(\"\$__item\")"
  done < <(jq -j "$__filter"' | . + "\u0000"' "$__file")
}

# ---------------------------------------------------------------------------------
# emit_finished — write the terminal payload once, then emit it (idempotently).
#
# The write comes first and the file is never rewritten. A second call — a retry after a
# rejected emit, a --reconcile pass over a supervisor that was killed between the write
# and the emit — re-sends the SAME bytes, which the spine's content-derived idempotency
# key collapses onto the original event. Rewriting the payload with a fresh timestamp
# would defeat that and leave two contradictory terminal facts for one execution.
# ---------------------------------------------------------------------------------
emit_finished() {  # emit_finished <run-dir> <payload-json-or-empty>
  local rd="$1" payload="${2:-}"
  if [ ! -f "$rd/finished.json" ]; then
    [ -n "$payload" ] || die "emit_finished called with no payload and no finished.json"
    printf '%s\n' "$payload" > "$rd/finished.json"
  fi
  local task; task=$(jq -r '.task' "$rd/plan.json")
  # The emit's own failure is surfaced, never swallowed: an unrecorded terminal fact is
  # the one outcome this whole script exists to prevent, so the operator is told the
  # payload is on disk and how to replay it.
  if ! "$rd/emit.sh" --type execution.finished --task "$task" \
        --payload "$(cat "$rd/finished.json")" >/dev/null; then
    log "FAILED to emit execution.finished — the payload is preserved at $rd/finished.json"
    log "  replay it with:  hive-supervise --reconcile $(dirname "$rd")"
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------------
# reconcile — sweep run-dirs whose execution started but never recorded a terminal fact.
#
# This is the honest answer to "tmux died and took the supervisor with it". Such an
# execution's outcome is genuinely unknown to us, so it is recorded as `interrupted`
# with `outcome_certainty: uncertain` and `unavailable` usage naming the reason. Writing
# a confident `failure` there would be a guess wearing a fact's clothes.
# ---------------------------------------------------------------------------------
reconcile() {  # reconcile <root>
  local root="$1" rd rc=0
  [ -d "$root" ] || die "reconcile root does not exist: $root"
  for rd in "$root"/*/; do
    rd="${rd%/}"
    [ -f "$rd/plan.json" ] || continue
    if [ -f "$rd/finished.json" ]; then
      # Written but possibly never accepted — re-emitting is free and idempotent.
      emit_finished "$rd" || rc=1
      continue
    fi
    [ -f "$rd/started.json" ] || continue    # never started: nothing terminal to say
    log "reconciling $rd (started, no terminal fact)"
    local payload
    payload=$(jq -c \
      --arg fin "$(now)" \
      --arg reason "supervisor did not observe this execution end (tmux or host died); usage surface was never read" \
      '{execution_id: .execution_id, purpose: .purpose, attempt: .attempt,
        identity: .identity, outcome: "interrupted", outcome_certainty: "uncertain",
        exit_code: null, finished_at: $fin, model_evidence: "none",
        usage: {status: "unavailable", reason: $reason},
        price_basis: .price_basis}' "$rd/plan.json")
    emit_finished "$rd" "$payload" || rc=1
  done
  return $rc
}

# ---------------------------------------------------------------------------------
# The supervised-worker transport.
#
# One request per call, drained here. Two rules carry the whole design:
#
#   1. The request says WHAT, never WHO or WHERE. Run, role and actor are stamped from
#      plan.json by the relay wrapper; every path, branch, destination and credential
#      for a bridge operation is read from plan.json's `bridge` block. A request that
#      names any of them is refused by name (`REQUEST_FIELD_FORBIDDEN`), because "your
#      field was ignored" and "your field was rejected" have very different remedies.
#
#   2. The trusted side never executes worker content. Worker commits reach it as a
#      BUNDLE — a file — read into a fresh bare repository with hooks and credential
#      helpers disabled, validated, and pushed. Nothing is ever checked out, and no
#      worker-owned git config is on the path of a trusted command. A worker-owned
#      `.git` is worker-CONTROLLED INPUT (Codex boundary report, 2026-08-20), and this
#      is the one place that fact could have bitten.
#
# Receipts are written into the worker's own receipts dir. That directory is
# worker-writable, which is fine: the worker is the only consumer of its own receipts,
# and nothing here reads one back.
# ---------------------------------------------------------------------------------

# The three operations a supervised worker may ask for. The canonical list lives in
# `omegahive.harness.spool.BRIDGE_OPS`; tests assert the two agree.
BRIDGE_OPS="sync-workspace publish-code publish-workspace"

# Every trusted-side git invocation goes through this. The flags are the containment:
# a worker-owned repository can carry hooks, a `core.hooksPath`, a credential helper, a
# pack-objects hook and an alias, and `-c` overrides win over the repository's own config
# in the process and in every git it spawns. GIT_CONFIG_GLOBAL/SYSTEM close the two
# files `-c` does not cover.
tgit() {  # tgit <git args...>
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0 \
  git -c core.hooksPath=/dev/null \
      -c credential.helper= \
      -c protocol.ext.allow=never \
      -c uploadpack.packObjectsHook= \
      -c transfer.fsckObjects=true \
      "$@"
}

receipt() {  # receipt <run-dir> <request-id> <status> <message> [data-json]
  local rd="$1" id="$2" status="$3" message="$4" data="${5:-null}"
  local rdir; rdir=$(jq -r '.run_dir' "$rd/plan.json")/receipts
  mkdir -p "$rdir"
  jq -n --arg s "$status" --arg m "$message" --argjson d "$data" \
    '{status:$s, message:$m, data:$d}' > "$rdir/$id.json.tmp"
  mv "$rdir/$id.json.tmp" "$rdir/$id.json"
  printf '%s\t%s\t%s\n' "$id" "$status" "$message" >> "$rd/spool.log"
}

# --- bridge: sync workspace ----------------------------------------------------------
# Read the fixed hub, write ONE bundle under the fixed task root. The trusted side does
# not touch the worker's clone: the fetch and the rebase happen inside the worker
# boundary, where worker-owned git config and hooks have no trusted authority. This is
# the sandboxed equivalent of WORKER.md's required `git pull`, including the round trip
# that delivers an answer commit to a blocked worker's order.
bridge_sync_workspace() {  # bridge_sync_workspace <run-dir> <request-id>
  local rd="$1" id="$2" hub run_dir out
  hub=$(jq -r '.bridge.ws_hub' "$rd/plan.json")
  run_dir=$(jq -r '.run_dir' "$rd/plan.json")
  out="$run_dir/sync/workspace.bundle"
  mkdir -p "$run_dir/sync"
  rm -f "$out"
  if ! tgit -C "$hub" bundle create "$out" main >/dev/null 2>&1; then
    receipt "$rd" "$id" rejected "rejected: SYNC_FAILED could not bundle main from the workspace hub"
    return
  fi
  receipt "$rd" "$id" accepted "workspace bundle ready" \
    "$(jq -n --arg b "$out" '{bundle:$b}')"
}

# A fresh trusted repository for one destination, holding the published history only.
# Persistent across publications so a thin bundle's prerequisites resolve; never checked
# out, so nothing in it is ever executed.
trusted_repo() {  # trusted_repo <run-dir> <name> <remote> -> prints the path
  local rd="$1" name="$2" remote="$3"
  local repo="$rd/publish/$name"
  if [ ! -d "$repo" ]; then
    mkdir -p "$rd/publish"
    tgit init --quiet --bare "$repo" >/dev/null
    tgit -C "$repo" remote add origin "$remote"
  fi
  tgit -C "$repo" fetch --quiet origin '+refs/heads/main:refs/heads/main' >/dev/null 2>&1 || true
  printf '%s' "$repo"
}

# Import a worker bundle into a trusted repository under a name of OUR choosing.
import_bundle() {  # import_bundle <repo> <bundle> <ref> -> 0 on success
  [ -f "$2" ] || return 1
  tgit -C "$1" fetch --quiet "$2" "+$3:refs/heads/incoming" >/dev/null 2>&1
}

# --- bridge: publish workspace -------------------------------------------------------
# The worker's report and question commits, and nothing else. Three checks, in order,
# because each one's failure means something different to the worker: the commit must
# fast-forward the hub's main (else: sync, rebase, retry), it must touch only this
# task's allowed paths, and only then is it pushed — preserving the worker's own commit
# sha, so a `path@sha` pin taken before publication resolves on the hub afterwards.
bridge_publish_workspace() {  # bridge_publish_workspace <run-dir> <request-id>
  local rd="$1" id="$2" hub run_dir project task repo tip bad
  hub=$(jq -r '.bridge.ws_hub' "$rd/plan.json")
  run_dir=$(jq -r '.run_dir' "$rd/plan.json")
  project=$(jq -r '.bridge.project' "$rd/plan.json")
  task=$(jq -r '.task' "$rd/plan.json")
  repo=$(trusted_repo "$rd" workspace "$hub")

  if ! import_bundle "$repo" "$run_dir/publish/workspace.bundle" "HEAD"; then
    receipt "$rd" "$id" rejected "rejected: PUBLISH_NO_BUNDLE no readable workspace bundle at $run_dir/publish/workspace.bundle"
    return
  fi
  tip=$(tgit -C "$repo" rev-parse refs/heads/incoming)

  if ! tgit -C "$repo" merge-base --is-ancestor refs/heads/main refs/heads/incoming; then
    receipt "$rd" "$id" rejected "rejected: NON_FAST_FORWARD the hub's main is not an ancestor of your commit. Run 'sync workspace', rebase, and retry."
    return
  fi

  # The allowed path diff, taken against the hub's main. `reports/` is narrowed to THIS
  # task's result files so one worker cannot publish over another's report; `questions/`
  # is this project's whole directory, because a question is named by date and topic and
  # not by task.
  bad=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      "projects/$project/reports/"*"-$task-result"*.md) ;;
      "projects/$project/questions/"*.md) ;;
      *) bad="$bad $f" ;;
    esac
  done < <(tgit -C "$repo" diff --name-only refs/heads/main refs/heads/incoming)
  if [ -n "$bad" ]; then
    receipt "$rd" "$id" rejected "rejected: PATH_NOT_ALLOWED workspace publication is limited to projects/$project/reports/*-$task-result*.md and projects/$project/questions/*.md; your commit also touches:$bad"
    return
  fi

  if ! tgit -C "$repo" push --quiet origin "refs/heads/incoming:refs/heads/main" >/dev/null 2>&1; then
    receipt "$rd" "$id" rejected "rejected: PUBLISH_REFUSED the hub refused the push; run 'sync workspace', rebase, and retry"
    return
  fi
  receipt "$rd" "$id" accepted "published $tip" "$(jq -n --arg s "$tip" '{sha:$s}')"
}

# --- bridge: publish code ------------------------------------------------------------
# The launch-recorded branch to the launch-recorded repository, then its PR. The worker
# chooses none of the four: not the branch, not the destination, not the refspec, not
# the credential. The PR's title and body come from the plan too, because a request that
# could set them could set anything a reader will believe.
bridge_publish_code() {  # bridge_publish_code <run-dir> <request-id>
  local rd="$1" id="$2" remote run_dir branch task order title repo tip url
  remote=$(jq -r '.bridge.code_repo' "$rd/plan.json")
  run_dir=$(jq -r '.run_dir' "$rd/plan.json")
  branch=$(jq -r '.bridge.code_branch' "$rd/plan.json")
  task=$(jq -r '.task' "$rd/plan.json")
  order=$(jq -r '.bridge.order_ref' "$rd/plan.json")
  title=$(jq -r '.bridge.title' "$rd/plan.json")
  repo=$(trusted_repo "$rd" code "$remote")

  if ! import_bundle "$repo" "$run_dir/publish/code.bundle" "refs/heads/$branch"; then
    receipt "$rd" "$id" rejected "rejected: PUBLISH_NO_BUNDLE no readable code bundle at $run_dir/publish/code.bundle"
    return
  fi
  tip=$(tgit -C "$repo" rev-parse refs/heads/incoming)

  if ! tgit -C "$repo" push --quiet origin "refs/heads/incoming:refs/heads/$branch" >/dev/null 2>&1; then
    receipt "$rd" "$id" rejected "rejected: PUBLISH_REFUSED the remote refused $branch (not a fast-forward?); rebase on origin/main and retry"
    return
  fi

  # A destination that is not a forge gets the push and an honest note instead of a PR.
  # The drill runs against a local bare repository, and a `gh pr create --repo /path/to.git`
  # is not a degraded PR -- it is a category error, and reporting it as a failure would
  # make the drill's green depend on a network the drill does not have.
  if ! printf '%s' "$remote" | grep -q 'github\.com'; then
    receipt "$rd" "$id" accepted "published $branch at $tip -- no forge configured for $remote, so no pull request was opened" \
      "$(jq -n --arg s "$tip" '{sha:$s, pr:null}')"
    return
  fi
  if ! command -v gh >/dev/null 2>&1; then
    receipt "$rd" "$id" accepted "published $branch at $tip -- gh is not installed, so no pull request was opened" \
      "$(jq -n --arg s "$tip" '{sha:$s, pr:null}')"
    return
  fi
  url=$(GIT_TERMINAL_PROMPT=0 gh pr view "$branch" --repo "$remote" --json url -q .url 2>/dev/null || true)
  if [ -z "$url" ]; then
    url=$(GIT_TERMINAL_PROMPT=0 gh pr create --repo "$remote" --head "$branch" --base main \
            --title "$title" \
            --body "Task \`$task\`, per \`$order\`.

Opened by the hive supervisor on the worker's behalf. The worker's result report in the
workspace is the authoritative description of this branch." 2>&1) || {
      receipt "$rd" "$id" rejected "rejected: PR_FAILED branch $branch is pushed at $tip but the PR could not be opened: $url"
      return
    }
  fi
  receipt "$rd" "$id" accepted "published $branch at $tip -- $url" \
    "$(jq -n --arg s "$tip" --arg u "$url" '{sha:$s, pr:$u}')"
}

# --- the drain -----------------------------------------------------------------------
# Lexicographic order over a zero-padded, never-reused id: deterministic per worker.
# A processed request file is REMOVED after its receipt lands, so a restart replays only
# what genuinely has no receipt — and because the request file is removed last, a
# supervisor killed between the emit and the removal re-sends identical bytes, which the
# spine's content-derived idempotency key collapses onto the original event.
drain_spool() {  # drain_spool <run-dir>
  local rd="$1" run_dir spool f id kind op out
  run_dir=$(jq -r '.run_dir // empty' "$rd/plan.json")
  [ -n "$run_dir" ] || return 0
  spool="$run_dir/spool"
  [ -d "$spool" ] || return 0
  for f in "$spool"/*.json; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .json)
    if ! kind=$(jq -r '.kind // empty' "$f" 2>/dev/null); then
      receipt "$rd" "$id" rejected "rejected: REQUEST_MALFORMED not valid JSON"
      rm -f "$f"; continue
    fi
    case "$kind" in
      emit)
        # Validation and the emit are ONE call, in the CLI, so there is exactly one
        # spelling of "what a request may say" and it is the one under test.
        if out=$("$rd/emit-worker.sh" < "$f" 2>&1); then
          receipt "$rd" "$id" accepted "$out"
        else
          receipt "$rd" "$id" rejected "$out"
        fi
        ;;
      bridge)
        op=$(jq -r '.op // empty' "$f")
        # Guard the shape here too: a bridge request has exactly `kind` and `op`, and
        # anything else is an attempt to choose a path, a branch or a destination.
        if [ "$(jq -r '[keys[]] | map(select(. != "kind" and . != "op")) | length' "$f")" != "0" ]; then
          receipt "$rd" "$id" rejected "rejected: REQUEST_FIELD_FORBIDDEN a bridge request carries only kind and op; the source, branch, destination and credential come from the launch plan"
        else
          case " $BRIDGE_OPS " in
            *" $op "*)
              case "$op" in
                sync-workspace)    bridge_sync_workspace "$rd" "$id" ;;
                publish-workspace) bridge_publish_workspace "$rd" "$id" ;;
                publish-code)      bridge_publish_code "$rd" "$id" ;;
              esac ;;
            *)
              receipt "$rd" "$id" rejected "rejected: BRIDGE_OP_UNKNOWN no bridge operation named '$op'; this worker may ask for: $BRIDGE_OPS" ;;
          esac
        fi
        ;;
      *)
        receipt "$rd" "$id" rejected "rejected: REQUEST_KIND_UNKNOWN no request kind '$kind'"
        ;;
    esac
    rm -f "$f"
  done
}

case "${1:-}" in
  -h|--help) usage ;;
  --reconcile) [ $# -eq 2 ] || usage; reconcile "$2"; exit $? ;;
  --drain) [ $# -eq 2 ] || usage
    RD="${2%/}"; [ -f "$RD/plan.json" ] || die "no plan.json in $RD"
    drain_spool "$RD"; exit 0 ;;
  "") usage ;;
  -*) usage ;;
esac

RUN_DIR_ARG="${1%/}"
[ -d "$RUN_DIR_ARG" ] || die "run dir does not exist: $RUN_DIR_ARG"
PLAN="$RUN_DIR_ARG/plan.json"
[ -f "$PLAN" ] || die "no plan.json in $RUN_DIR_ARG"
[ -x "$RUN_DIR_ARG/emit.sh" ] || die "no executable emit.sh in $RUN_DIR_ARG — the supervisor has no write path"

# Already terminal? Replay the recorded fact and stop. This makes a re-run of the pane
# command safe instead of a second execution of the same approved launch.
if [ -f "$RUN_DIR_ARG/finished.json" ]; then
  log "this execution already recorded a terminal fact; re-emitting it and exiting"
  emit_finished "$RUN_DIR_ARG"
  exit 0
fi

EXEC_ID=$(jq -r '.execution_id' "$PLAN")
TASK=$(jq -r '.task' "$PLAN")
CWD=$(jq -r '.cwd // empty' "$PLAN")
WORKER_IO=$(jq -r '.worker_io' "$PLAN")
PINNED_MODEL=$(jq -r '.identity.model' "$PLAN")
USAGE_EXTRACTOR=$(jq -r '.usage_extractor' "$PLAN")
PROVES_USAGE=$(jq -r '.proves_usage' "$PLAN")
UNPROVEN_REASON=$(jq -r '.unproven_reason // empty' "$PLAN")

read_json_array ARGV '.argv[]' "$PLAN"
read_json_array VERSION_ARGV '.version_argv[]' "$PLAN"
read_json_array ENV_PAIRS '(.env | to_entries[] | "\(.key)=\(.value)")' "$PLAN"

[ "${#ARGV[@]}" -gt 0 ] || die "plan carries an empty argv"
[ "${#VERSION_ARGV[@]}" -gt 0 ] || die "plan carries an empty version_argv"
# `env -i` builds the child's environment from nothing, so PATH must be among the pairs
# or `env` cannot resolve the harness at all. The adapter allowlists PATH; this is the
# assertion that a future allowlist edit cannot quietly break.
case " ${ENV_PAIRS[*]} " in
  *" PATH="*) : ;;
  *) die "the resolved environment carries no PATH; env -i could not resolve the harness" ;;
esac

if [ "$WORKER_IO" = "supervised" ]; then
  [ -x "$RUN_DIR_ARG/emit-worker.sh" ] \
    || die "this route's worker I/O is supervised and there is no executable emit-worker.sh in $RUN_DIR_ARG — the worker would have no write path at all"
fi

# ---------------------------------------------------------------------------------
# Terminal-fact assembly. Kept in one place so every exit path — probe failure, clean
# exit, non-zero exit, signal — produces the same shape and none can forget a field.
# ---------------------------------------------------------------------------------
USAGE_JSON='{"status":"unavailable","reason":"usage was never extracted"}'
MODEL_RESOLVED=""
MODEL_EVIDENCE="none"
MODEL_MISMATCH="false"

finish() {  # finish <outcome> <certainty> <exit-code-or-empty>
  local outcome="$1" certainty="$2" code="${3:-}"
  local payload
  payload=$(jq -c -n \
    --slurpfile plan "$PLAN" \
    --arg outcome "$outcome" --arg certainty "$certainty" \
    --arg fin "$(now)" \
    --arg resolved "$MODEL_RESOLVED" --arg evidence "$MODEL_EVIDENCE" \
    --argjson usage "$USAGE_JSON" \
    --argjson code "${code:-null}" \
    '$plan[0] as $p |
     {execution_id: $p.execution_id, purpose: $p.purpose, attempt: $p.attempt,
      identity: $p.identity, outcome: $outcome, outcome_certainty: $certainty,
      exit_code: $code, finished_at: $fin,
      model_resolved: (if $evidence == "harness-reported" then $resolved else null end),
      model_evidence: $evidence, usage: $usage, price_basis: $p.price_basis}')
  emit_finished "$RUN_DIR_ARG" "$payload"
}

# --- 1. probe the harness version -- no model call, no tokens -----------------------
# Failing here means the execution never happened. That is recorded as a terminal
# failure with no `started` fact, which is exactly what the projection should show:
# approved, never started, failed.
#
# What is NO LONGER checked here, and deliberately: whether the installed harness is the
# build some descriptor was proven against. There is no descriptor and no proof; an
# automatic harness update is provenance, recorded on the started fact, not a refusal
# (runner-trust doctrine, kind 3).
HARNESS_VERSION=""
if ! VERSION_OUT=$("${VERSION_ARGV[@]}" 2>&1); then
  log "harness version probe failed: ${VERSION_ARGV[*]}"
  printf '%s\n' "$VERSION_OUT" >&2
  USAGE_JSON=$(jq -c -n --arg r "harness did not start; version probe failed" \
    '{status:"unavailable", reason:$r}')
  finish failure certain 127
  exit 1
fi
# `claude --version` prints `2.1.231 (Claude Code)` and the version is what belongs on
# the fact, not the banner — and not a warning that happened to reach stderr first.
HARNESS_VERSION=$(printf '%s\n' "$VERSION_OUT" | harness_version_from)
[ -n "$HARNESS_VERSION" ] || HARNESS_VERSION="unknown"

# --- 2. reconcile anything the previous supervisor left unanswered ------------------
# Before the child exists, so a worker resumed after a supervisor restart finds its
# outstanding requests already answered rather than waiting out a timeout on a receipt
# that was never going to come. Replaying an emit is safe: the request bytes are
# identical, and the spine's content-derived idempotency key collapses the repeat.
drain_spool "$RUN_DIR_ARG"

# --- 3. start the child, then say so ------------------------------------------------
# The child is backgrounded so the supervisor keeps a pid to observe — but a plain `&`
# in a non-interactive shell redirects the child's stdin from /dev/null (POSIX async
# behaviour), which would leave an interactive harness with no terminal to read. Two
# facts, both verified on this host under a real pty on 2026-08-13, make this work:
#   * `< /dev/tty` restores a real terminal on stdin;
#   * with job control off (every script), `&` does NOT create a new process group, so
#     the child stays in the foreground group and never takes SIGTTIN/SIGTTOU.
# Without a controlling terminal (the fixture-driven tests) /dev/tty cannot be opened,
# so the plain form is used — a fixture needs no terminal.
cd "${CWD:-$PWD}" || die "cannot enter the worker's cwd: $CWD"
if [ -t 0 ] && [ -e /dev/tty ]; then
  env -i "${ENV_PAIRS[@]}" "${ARGV[@]}" < /dev/tty 2>>"$RUN_DIR_ARG/harness.log" &
else
  env -i "${ENV_PAIRS[@]}" "${ARGV[@]}" 2>>"$RUN_DIR_ARG/harness.log" &
fi
CHILD=$!

# "Started" means the child process exists. `kill -0` is the check, and it is made
# AFTER the fork rather than before it — the whole reason this fact is separate from
# `route_approved` is that it is observed rather than intended.
if ! kill -0 "$CHILD" 2>/dev/null; then
  # It forked and was already gone: still a start, and `wait` below tells us how it went.
  log "child $CHILD exited immediately after fork"
fi
STARTED_PAYLOAD=$(jq -c -n --slurpfile plan "$PLAN" \
  --arg v "$HARNESS_VERSION" --arg st "$(now)" \
  '$plan[0] as $p |
   {execution_id: $p.execution_id, purpose: $p.purpose, attempt: $p.attempt,
    identity: $p.identity,
    harness_version: $v,
    model_requested: $p.model_requested, started_at: $st}')
printf '%s\n' "$STARTED_PAYLOAD" > "$RUN_DIR_ARG/started.json"
if ! "$RUN_DIR_ARG/emit.sh" --type execution.started --task "$TASK" \
      --payload "$STARTED_PAYLOAD" >/dev/null; then
  # A missing `started` is a gap in the record but not a reason to abandon a running
  # worker. Say so loudly and carry on to the terminal fact, which matters more.
  log "WARNING could not emit execution.started (payload kept at $RUN_DIR_ARG/started.json)"
fi
log "execution $EXEC_ID started: pid $CHILD, harness $HARNESS_VERSION, model $PINNED_MODEL, worker I/O $WORKER_IO"

# --- 4. supervise, and drain the spool while the child runs -------------------------
# The drain is what makes the worker's emit SYNCHRONOUS from inside the boundary: the
# wrapper writes a request and blocks, and this loop answers it within a tick. The loop
# runs on every route, not only supervised ones — a direct worker writes no requests, so
# the drain is a cheap no-op, and having one code path means a route that changes its
# worker I/O needs no change here.
INTERRUPTED=""
on_signal() { INTERRUPTED=1; log "signal received — forwarding to child $CHILD"; kill -TERM "$CHILD" 2>/dev/null || true; }
trap on_signal INT TERM HUP

CHILD_RC=0
while kill -0 "$CHILD" 2>/dev/null; do
  drain_spool "$RUN_DIR_ARG"
  sleep 0.2
done
# `wait` returns >128 when interrupted by a trapped signal; the second wait reaps the
# child's real status after the forwarded TERM.
wait "$CHILD" || CHILD_RC=$?
if [ -n "$INTERRUPTED" ]; then
  wait "$CHILD" 2>/dev/null || true
fi
trap - INT TERM HUP
# One last pass: a request written in the child's final moments still gets its receipt,
# even though nobody is waiting for it any more. It is the record that matters.
drain_spool "$RUN_DIR_ARG"

# --- 5. read the consumption surface ------------------------------------------------
# Never fatal. An unreadable surface is `unavailable` with a named reason, which is a
# legitimate record; losing the terminal fact over a parser problem would not be.
extract_usage() {
  local src="" reason=""
  case "$USAGE_EXTRACTOR" in
    claude-code-transcript)
      local sid cfg
      sid=$(jq -r '.usage_hint.session_id // empty' "$PLAN")
      cfg=$(jq -r '.usage_hint.config_dir // empty' "$PLAN")
      [ -n "$cfg" ] || cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
      if [ -z "$sid" ]; then
        reason="no session id was pinned, so the transcript cannot be located"
      else
        # Search rather than recompute the project-slug directory: the slug rule is the
        # harness's, not ours, and a wrong guess would silently read nothing.
        src=$(find "$cfg/projects" -maxdepth 2 -type f -name "$sid.jsonl" 2>/dev/null | head -1)
        [ -n "$src" ] || reason="no transcript named $sid.jsonl under $cfg/projects"
      fi
      ;;
    fake-usage-file)
      src=$(jq -r '.usage_hint.usage_file // empty' "$PLAN")
      [ -n "$src" ] && [ -f "$src" ] || { reason="fake usage file not present"; src=""; }
      ;;
    none)
      reason="${UNPROVEN_REASON:-harness has no usage surface established on this deployment}"
      ;;
    *)
      reason="no usage extractor named '$USAGE_EXTRACTOR' on this deployment"
      ;;
  esac

  if [ -z "$src" ]; then
    USAGE_JSON=$(jq -c -n --arg r "$reason" '{status:"unavailable", reason:$r}')
    return 0
  fi

  local out
  if ! out=$( hive_cli harness-usage --extractor "$USAGE_EXTRACTOR" \
                --pinned-model "$PINNED_MODEL" < "$src" ); then
    USAGE_JSON=$(jq -c -n --arg r "the usage extractor failed to run" \
      '{status:"unavailable", reason:$r}')
    return 0
  fi
  USAGE_JSON=$(printf '%s' "$out" | jq -c '.usage')
  MODEL_RESOLVED=$(printf '%s' "$out" | jq -r '.model_resolved // empty')
  MODEL_EVIDENCE=$(printf '%s' "$out" | jq -r '.model_evidence')
  MODEL_MISMATCH=$(printf '%s' "$out" | jq -r '.model_mismatch')
  # The audit trail: the per-message rows behind the totals, and nothing else. No
  # message content ever reaches this file.
  printf '%s' "$out" | jq '{rows, notes, main_chain_models}' > "$RUN_DIR_ARG/usage.json"
  USAGE_JSON=$(printf '%s' "$USAGE_JSON" | jq -c --arg ref "$RUN_DIR_ARG/usage.json" '. + {evidence_ref: $ref}')
}

if [ "$PROVES_USAGE" = "true" ] || [ "$USAGE_EXTRACTOR" != "none" ]; then
  extract_usage
else
  USAGE_JSON=$(jq -c -n --arg r "${UNPROVEN_REASON:-harness has no usage surface established on this deployment}" \
    '{status:"unavailable", reason:$r}')
fi

# --- 6. the terminal fact -----------------------------------------------------------
# The model check is a stop-line, not a warning: "a mismatch refuses or records terminal
# failure; it never falls back". A run whose harness reports a model other than the one
# the operator signed for did not execute the approved route, whatever its exit code.
OUTCOME="success"
CERTAINTY="certain"
if [ -n "$INTERRUPTED" ]; then
  OUTCOME="interrupted"
elif [ "$CHILD_RC" -ne 0 ]; then
  OUTCOME="failure"
fi
if [ "$MODEL_MISMATCH" = "true" ]; then
  log "MODEL MISMATCH: pinned '$PINNED_MODEL', harness reported '$MODEL_RESOLVED' — recording terminal failure"
  OUTCOME="failure"
fi

finish "$OUTCOME" "$CERTAINTY" "$CHILD_RC"
log "execution $EXEC_ID finished: $OUTCOME (exit $CHILD_RC)"
exit "$CHILD_RC"
