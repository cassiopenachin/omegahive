{
  "gateway": {
    "mode": "local",
    "port": 18795,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "file",
        "provider": "room",
        "id": "/gateway/token"
      }
    },
    "tailscale": {
      "mode": "off"
    }
  },
  "secrets": {
    "providers": {
      "room": {
        "source": "file",
        "path": "~/.config/omegahive/council-room/secrets.json",
        "mode": "json"
      }
    }
  },
  "env": {
    "shellEnv": {
      "enabled": false
    }
  },
  "plugins": {
    "allow": [
      "slack",
      "codex",
      "anthropic"
    ],
    "entries": {
      "slack": {
        "enabled": true
      },
      "codex": {
        "enabled": true,
        "config": {
          "sessionCatalog": {
            "enabled": false
          },
          "appServer": {
            "clearEnv": [
              "OPENAI_API_KEY",
              "CODEX_API_KEY",
              "ANTHROPIC_API_KEY"
            ]
          }
        }
      },
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      },
      "anthropic": {
        "enabled": true
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "heartbeat": {
        "every": "0m"
      },
      "skipBootstrap": true,
      "models": {
        "openai/gpt-6-astra": {},
        "anthropic/claude-fable-5-2": {}
      }
    },
    "entries": {
      "astra": {
        "name": "Astra",
        "workspace": "~/.local/share/omegahive/council-room/state/agents/astra/workspace",
        "cwd": "~/workspaces/hive-council",
        "model": {
          "primary": "openai/gpt-6-astra",
          "fallbacks": []
        },
        "thinkingDefault": "high",
        "models": {
          "openai/gpt-6-astra": {
            "agentRuntime": {
              "id": "codex"
            }
          }
        },
        "tools": {
          "deny": [
            "cron",
            "gateway",
            "nodes"
          ]
        }
      },
      "fable": {
        "name": "Fable",
        "workspace": "~/.local/share/omegahive/council-room/state/agents/fable/workspace",
        "cwd": "~/workspaces/hive-council",
        "model": {
          "primary": "anthropic/claude-fable-5-2",
          "fallbacks": []
        },
        "thinkingDefault": "high",
        "utilityModel": "",
        "tools": {
          "deny": [
            "cron",
            "gateway",
            "nodes"
          ]
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "astra",
      "match": {
        "channel": "slack",
        "teamId": "T0C27J451JQ",
        "accountId": "astra"
      }
    },
    {
      "agentId": "fable",
      "match": {
        "channel": "slack",
        "teamId": "T0C27J451JQ",
        "accountId": "fable"
      }
    }
  ],
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "dmPolicy": "disabled",
      "groupPolicy": "allowlist",
      "allowFrom": [
        "U0C2206GLEA"
      ],
      "joinIntro": false,
      "replyToMode": "all",
      "historyLimit": 50,
      "thread": {
        "initialHistoryLimit": 50
      },
      "allowBots": "mentions",
      "implicitMentions": {
        "replyToBot": false,
        "quotedBot": false,
        "threadParticipation": false
      },
      "botLoopProtection": {
        "maxEventsPerWindow": 8,
        "windowSeconds": 600,
        "cooldownSeconds": 600
      },
