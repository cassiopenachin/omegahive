#!/bin/sh
# Store the council room's Slack tokens in its private secrets file, typed at a hidden
# prompt. The operator runs this in their own terminal; the tokens never pass through
# Slack, a chat transcript, a command line or the environment: they reach jq on its
# standard input. The gateway token already in the file is kept. Installed to
# ~/.local/share/omegahive/council-room/bin/.
#
# Usage: set-slack-tokens [astra|fable]   (default astra)
# Each seat is its own Slack app. Astra's tokens stay at .slack.botToken/.slack.appToken,
# the paths the single-seat room used; another seat's go under .slack.<seat>, so
# storing one seat's tokens never touches another's.
set -eu
seat="${1:-astra}"
case "${seat}" in
    astra) path='.slack' ;;
    fable) path='.slack.fable' ;;
    *) echo "unknown seat: ${seat} (expected astra or fable); nothing was written" >&2; exit 1 ;;
esac
secrets="${HOME}/.config/omegahive/council-room/secrets.json"
[ -f "${secrets}" ] || { echo "missing ${secrets}; install the room first" >&2; exit 1; }

# Echo is hidden only on a terminal; piped input (the tests) has none to hide.
quiet() { if [ -t 0 ]; then stty "$1"; fi; }

ask() {
    printf '%s: ' "$1" >&2
    quiet -echo
    IFS= read -r value
    quiet echo
    printf '\n' >&2
    case "${value}" in
        "$2"*) printf '%s' "${value}" ;;
        *) echo "that does not start with $2; nothing was written" >&2; exit 1 ;;
    esac
}
trap 'quiet echo 2>/dev/null || true' EXIT

bot=$(ask "Bot User OAuth Token (xoxb-...)" "xoxb-")
app=$(ask "App-Level Token with connections:write (xapp-...)" "xapp-")

# A new private file replaces the old one: the file provider refuses hardlinked or
# group/world-readable secrets, and jq writing in place would briefly truncate it.
tmp=$(mktemp "${secrets}.XXXXXX")
trap 'rm -f "${tmp}"; quiet echo 2>/dev/null || true' EXIT
chmod 600 "${tmp}"
printf '%s\n%s\n' "${bot}" "${app}" \
    | jq -R -n --slurpfile s "${secrets}" \
        "[inputs] as [\$bot, \$app] | \$s[0] | ${path}.botToken = \$bot | ${path}.appToken = \$app" \
    > "${tmp}"
mv -f "${tmp}" "${secrets}"
echo "stored for ${seat}; lengths: bot $(printf '%s' "${bot}" | wc -c), app $(printf '%s' "${app}" | wc -c)"
