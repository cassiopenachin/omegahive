[Unit]
Description=OmegaHive council room (OpenClaw gateway; Astra seat on Slack)
Documentation=file://%h/src/SNET/omegahive/deploy/council-room/README.md
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
# Paths are this deployment's (deploy/council-room/README.md): a room-local Node 24 and
# OpenClaw under the runtime root, mutable state beside them, config and secrets private.
WorkingDirectory=%h/.local/share/omegahive/council-room
# The user manager's environment is inherited; these names must never reach the gateway or
# the seat it spawns. An empty Environment= would reset only this unit's own list, so the
# removal is explicit. The running processes are checked by name in /proc/<pid>/environ.
UnsetEnvironment=OPENAI_API_KEY ANTHROPIC_API_KEY CODEX_API_KEY
Environment=PATH=%h/.local/share/omegahive/council-room/runtime/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_STATE_DIR=%h/.local/share/omegahive/council-room/state
Environment=OPENCLAW_CONFIG_PATH=%h/.config/omegahive/council-room/openclaw.json
# Acceptance holds one exact version; an update is a reviewed change, not a background act.
Environment=OPENCLAW_NO_AUTO_UPDATE=1
# A hand-written unit gets no adaptive heap sizing from `openclaw gateway install`.
Environment=NODE_OPTIONS=--max-old-space-size=4096
ExecStart=%h/.local/share/omegahive/council-room/runtime/node/bin/node %h/.local/share/omegahive/council-room/runtime/openclaw/node_modules/openclaw/openclaw.mjs gateway --port 18795
Restart=always
RestartSec=5
RestartPreventExitStatus=78
# The gateway drains for up to 315 s on stop; 330 s covers it plus cleanup.
TimeoutStopSec=330
TimeoutStartSec=30
SuccessExitStatus=0 143
OOMPolicy=continue
KillMode=mixed

[Install]
WantedBy=default.target
