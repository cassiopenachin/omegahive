{
  "display_information": {
    "name": "Astra (hive council)",
    "description": "The Astra seat of the hive council room (OpenClaw on Beastie)"
  },
  "features": {
    "bot_user": { "display_name": "Astra", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "reactions:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
